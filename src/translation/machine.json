[
  {
    "id": "nasm-x86-64",
    "label": "NASM x86-64 (Linux)",
    "comment": ";",
    "call": "function call",
    "output": "write syscall",
    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "fixed": {
          "message": "Hello, World!"
        },
        "requires": ["Linux x86-64 syscall ABI"],
        "source": [
          "global _start",
          "",
          "section .rodata",
          "    message db \"Hello, World!\", 10",
          "    message_length equ $ - message",
          "",
          "section .text",
          "_start:",
          "    mov eax, 1",
          "    mov edi, 1",
          "    lea rsi, [rel message]",
          "    mov edx, message_length",
          "    syscall",
          "",
          "    mov eax, 60",
          "    xor edi, edi",
          "    syscall"
        ]
      }
    ]
  },
  {
    "id": "gas-aarch64",
    "label": "GNU AArch64 assembly (Linux)",
    "comment": "//",
    "call": "function call",
    "output": "write syscall",
    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "fixed": {
          "message": "Hello, World!"
        },
        "requires": ["Linux AArch64 syscall ABI"],
        "source": [
          ".global _start",
          "",
          ".section .rodata",
          "message:",
          "    .ascii \"Hello, World!\\n\"",
          ".equ message_length, . - message",
          "",
          ".text",
          "_start:",
          "    mov x0, #1",
          "    adr x1, message",
          "    mov x2, #message_length",
          "    mov x8, #64",
          "    svc #0",
          "",
          "    mov x0, #0",
          "    mov x8, #93",
          "    svc #0"
        ]
      }
    ]
  },
  {
    "id": "llvm-ir",
    "label": "LLVM IR",
    "comment": ";",
    "call": "function call",
    "output": "puts",
    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "fixed": {
          "message": "Hello, World!"
        },
        "requires": ["libc puts"],
        "source": [
          "@message = private constant [14 x i8] c\"Hello, World!\\00\"",
          "",
          "declare i32 @puts(ptr)",
          "",
          "define i32 @main() {",
          "  call i32 @puts(ptr @message)",
          "  ret i32 0",
          "}"
        ]
      }
    ]
  },
  {
    "id": "cil",
    "label": ".NET CIL (ILAsm)",
    "comment": "//",
    "call": "method call",
    "output": "System.Console::WriteLine",
    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "fixed": {
          "message": "Hello, World!"
        },
        "requires": ["mscorlib", "HelloWorld"],
        "source": [
          ".assembly extern mscorlib {}",
          ".assembly HelloWorld {}",
          ".module HelloWorld.exe",
          "",
          ".class private auto ansi HelloWorld extends [mscorlib]System.Object",
          "{",
          "    .method public hidebysig static void Main() cil managed",
          "    {",
          "        .entrypoint",
          "        .maxstack 1",
          "        ldstr \"Hello, World!\"",
          "        call void [mscorlib]System.Console::WriteLine(string)",
          "        ret",
          "    }",
          "}"
        ]
      }
    ]
  },
  {
    "id": "jvm-jasmin",
    "label": "JVM bytecode (Jasmin)",
    "comment": ";",
    "call": "method call",
    "output": "java/io/PrintStream/println",
    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "fixed": {
          "message": "Hello, World!"
        },
        "requires": ["Main", "java/lang/System/out"],
        "source": [
          ".class public Main",
          ".super java/lang/Object",
          "",
          ".method public static main([Ljava/lang/String;)V",
          "    .limit stack 2",
          "    .limit locals 1",
          "    getstatic java/lang/System/out Ljava/io/PrintStream;",
          "    ldc \"Hello, World!\"",
          "    invokevirtual java/io/PrintStream/println(Ljava/lang/String;)V",
          "    return",
          ".end method"
        ]
      }
    ]
  }
]
