          "var",
          "    left, right, remainder: LongInt;",
          "begin",
          "    left := {{left}};",
          "    right := {{right}};",
          "    while right <> 0 do",
          "    begin",
          "        remainder := left mod right;",
          "        left := right;",
          "        right := remainder;",
          "    end;",
          "    WriteLn(left);",
          "end."
        ]
      },
      {
        "task": "fizz-buzz",
        "name": "standard",
        "source": [
          "program FizzBuzz;",
          "var",
          "    number, limit: LongInt;",
          "begin",
          "    limit := {{limit}};",
          "    for number := 1 to limit do",
          "        if number mod 15 = 0 then",
          "            WriteLn('FizzBuzz')",
          "        else if number mod 3 = 0 then",
          "            WriteLn('Fizz')",
          "        else if number mod 5 = 0 then",
          "            WriteLn('Buzz')",
          "        else",
          "            WriteLn(number);",
          "end."
        ]
      }
