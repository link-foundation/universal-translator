      {
        "task": "greatest-common-divisor",
        "name": "standard",
        "source": [
          "program greatest_common_divisor",
          "    implicit none",
          "    integer :: left, right, remainder",
          "    left = {{left}}",
          "    right = {{right}}",
          "    do while (right /= 0)",
          "        remainder = mod(left, right)",
          "        left = right",
          "        right = remainder",
          "    end do",
          "    write (*, '(I0)') left",
          "end program greatest_common_divisor"
        ]
      },
      {
        "task": "fizz-buzz",
        "name": "standard",
        "source": [
          "program fizz_buzz",
          "    implicit none",
          "    integer :: number, limit",
          "    limit = {{limit}}",
          "    do number = 1, limit",
          "        if (mod(number, 15) == 0) then",
          "            write (*, '(A)') \"FizzBuzz\"",
          "        else if (mod(number, 3) == 0) then",
          "            write (*, '(A)') \"Fizz\"",
          "        else if (mod(number, 5) == 0) then",
          "            write (*, '(A)') \"Buzz\"",
          "        else",
          "            write (*, '(I0)') number",
          "        end if",
          "    end do",
          "end program fizz_buzz"
        ]
