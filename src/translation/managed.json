    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "source": ["let () = print_endline \"{{message}}\""]
      },
      {
        "task": "greatest-common-divisor",
        "name": "standard",
        "source": [
          "let rec greatest_common_divisor left right =",
          "    if right = 0 then left else greatest_common_divisor right (left mod right)",
          "",
          "let () =",
          "    let left = {{left}} in",
          "    let right = {{right}} in",
          "    print_endline (string_of_int (greatest_common_divisor left right))"
        ]
      },
      {
        "task": "fizz-buzz",
        "name": "standard",
        "source": [
          "let () =",
          "    let limit = {{limit}} in",
          "    for number = 1 to limit do",
          "        let label = (if number mod 3 = 0 then \"Fizz\" else \"\") ^",
          "                    (if number mod 5 = 0 then \"Buzz\" else \"\") in",
          "        print_endline (if label = \"\" then string_of_int number else label)",
          "    done"
        ]
      }
    ],
    "commentEnd": "*)"
  },
