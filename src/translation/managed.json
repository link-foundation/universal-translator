  {
    "id": "vbnet",
    "label": "Visual Basic .NET",
    "comment": "'",
    "call": "method call",
    "output": "System.Console.WriteLine",
    "forms": [
      {
        "task": "hello",
        "name": "standard",
        "requires": ["HelloWorld", "System.Console"],
        "source": [
          "Module HelloWorld",
          "    Sub Main()",
          "        System.Console.WriteLine(\"{{message}}\")",
          "    End Sub",
          "End Module"
        ]
      },
      {
        "task": "greatest-common-divisor",
        "name": "standard",
        "source": [
          "Module GreatestCommonDivisor",
          "    Sub Main()",
          "        Dim left As Integer = {{left}}",
          "        Dim right As Integer = {{right}}",
          "        While right <> 0",
          "            Dim remainder As Integer = left Mod right",
          "            left = right",
          "            right = remainder",
          "        End While",
          "        System.Console.WriteLine(left)",
          "    End Sub",
          "End Module"
        ]
      },
      {
        "task": "fizz-buzz",
        "name": "standard",
        "source": [
          "Module FizzBuzz",
          "    Sub Main()",
          "        Dim limit As Integer = {{limit}}",
          "        For number As Integer = 1 To limit",
          "            Dim label As String = If(number Mod 3 = 0, \"Fizz\", \"\") & If(number Mod 5 = 0, \"Buzz\", \"\")",
          "            System.Console.WriteLine(If(label = \"\", number.ToString(), label))",
          "        Next",
          "    End Sub",
          "End Module"
        ]
      }
    ]
  },
