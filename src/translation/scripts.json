          "for {set number 1} {$number <= $limit} {incr number} {",
          "    set label \"\"",
          "    if {$number % 3 == 0} {append label \"Fizz\"}",
          "    if {$number % 5 == 0} {append label \"Buzz\"}",
          "    puts [expr {$label eq \"\" ? $number : $label}]",
          "}"
        ]
      }
