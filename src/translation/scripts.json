        "task": "fizz-buzz",
        "name": "standard",
        "source": [
          "limit <- {{limit}}",
          "for (number in seq_len(limit)) {",
          "    label <- paste0(if (number %% 3 == 0) \"Fizz\" else \"\", if (number %% 5 == 0) \"Buzz\" else \"\")",
          "    if (label == \"\") {",
          "        label <- as.character(number)",
          "    }",
          "    cat(label, \"\\n\", sep = \"\")",
          "}"
        ]
      }
    ]
