        "task": "greatest-common-divisor",
        "name": "standard",
        "source": [
          "#!/bin/sh",
          "left={{left}}",
          "right={{right}}",
          "while [ \"$right\" -ne 0 ]; do",
          "    remainder=$((left % right))",
          "    left=$right",
          "    right=$remainder",
          "done",
          "printf '%s\\n' \"$left\""
        ]
      },
      {
        "task": "fizz-buzz",
        "name": "standard",
        "source": [
          "#!/bin/sh",
          "limit={{limit}}",
          "number=1",
          "while [ \"$number\" -le \"$limit\" ]; do",
          "    if [ \"$((number % 15))\" -eq 0 ]; then",
          "        printf '%s\\n' FizzBuzz",
          "    elif [ \"$((number % 3))\" -eq 0 ]; then",
          "        printf '%s\\n' Fizz",
          "    elif [ \"$((number % 5))\" -eq 0 ]; then",
          "        printf '%s\\n' Buzz",
          "    else",
          "        printf '%s\\n' \"$number\"",
          "    fi",
          "    number=$((number + 1))",
          "done"
        ]
      }
    ],
    "header": 1
