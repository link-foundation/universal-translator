// Leap year in ARM64 assembly

    .global main
    .section .rodata
integer_format: .asciz "%lld"
text_format: .asciz "%s"
newline_format: .asciz "\n"
text_0: .asciz " is a leap year"
text_1: .asciz " is not a leap year"

    .text
.type is_leap_year, %function
is_leap_year:
    .set is_leap_year.year, 0
    stp x29, x30, [sp, #-16]!
    sub sp, sp, #16
    mov x29, sp
    str x0, [x29, #is_leap_year.year]
    ldr x0, [x29, #is_leap_year.year]
    str x0, [sp, #-16]!
    mov x0, #4
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sdiv x2, x0, x1
    msub x0, x2, x1, x0
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ne .Lis_leap_year_L4
    ldr x0, [x29, #is_leap_year.year]
    str x0, [sp, #-16]!
    mov x0, #100
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sdiv x2, x0, x1
    msub x0, x2, x1, x0
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ne .Lis_leap_year_L3
.Lis_leap_year_L4:
    ldr x0, [x29, #is_leap_year.year]
    str x0, [sp, #-16]!
    mov x0, #400
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sdiv x2, x0, x1
    msub x0, x2, x1, x0
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ne .Lis_leap_year_L1
.Lis_leap_year_L3:
    mov x0, #1
    str x0, [sp, #-16]!
    b .Lis_leap_year_L2
.Lis_leap_year_L1:
    mov x0, #0
    str x0, [sp, #-16]!
.Lis_leap_year_L2:
    ldr x0, [sp], #16
    mov sp, x29
    add sp, sp, #16
    ldp x29, x30, [sp], #16
    ret
.size is_leap_year, .-is_leap_year

.type main, %function
main:
    .set main.year, 0
    stp x29, x30, [sp, #-16]!
    sub sp, sp, #16
    mov x29, sp
    mov x0, #1896
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.year]
.Lmain_L1:
    ldr x0, [x29, #main.year]
    str x0, [sp, #-16]!
    mov x0, #1913
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ge .Lmain_L2
    ldr x0, [x29, #main.year]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl is_leap_year
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.eq .Lmain_L3
    ldr x0, [x29, #main.year]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    adrp x0, text_0
    add x0, x0, :lo12:text_0
    bl print_text
    bl print_newline
    b .Lmain_L4
.Lmain_L3:
    ldr x0, [x29, #main.year]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    adrp x0, text_1
    add x0, x0, :lo12:text_1
    bl print_text
    bl print_newline
.Lmain_L4:
    ldr x0, [x29, #main.year]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.year]
    b .Lmain_L1
.Lmain_L2:
    mov x0, #0
    mov sp, x29
    add sp, sp, #16
    ldp x29, x30, [sp], #16
    ret
.size main, .-main

print_integer:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, integer_format
    add x0, x0, :lo12:integer_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_text:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, text_format
    add x0, x0, :lo12:text_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_newline:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    adrp x0, newline_format
    add x0, x0, :lo12:newline_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

    .section .note.GNU-stack,"",%progbits
