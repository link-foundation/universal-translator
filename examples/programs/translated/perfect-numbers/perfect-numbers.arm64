// Perfect numbers in ARM64 assembly: numbers equal to the sum of their divisors

    .global main
    .section .rodata
integer_format: .asciz "%lld"
text_format: .asciz "%s"
newline_format: .asciz "\n"

    .text
.type is_perfect, %function
is_perfect:
    .set is_perfect.number, 0
    .set is_perfect.sum, 8
    .set is_perfect.divisor, 16
    stp x29, x30, [sp, #-16]!
    sub sp, sp, #32
    mov x29, sp
    str x0, [x29, #is_perfect.number]
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #is_perfect.sum]
    mov x0, #2
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #is_perfect.divisor]
.Lis_perfect_L1:
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    mul x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.number]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.gt .Lis_perfect_L2
    ldr x0, [x29, #is_perfect.number]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sdiv x2, x0, x1
    msub x0, x2, x1, x0
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ne .Lis_perfect_L3
    ldr x0, [x29, #is_perfect.sum]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #is_perfect.sum]
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    mul x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.number]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.eq .Lis_perfect_L5
    ldr x0, [x29, #is_perfect.sum]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.number]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sdiv x0, x0, x1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #is_perfect.sum]
    b .Lis_perfect_L6
.Lis_perfect_L5:
.Lis_perfect_L6:
    b .Lis_perfect_L4
.Lis_perfect_L3:
.Lis_perfect_L4:
    ldr x0, [x29, #is_perfect.divisor]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #is_perfect.divisor]
    b .Lis_perfect_L1
.Lis_perfect_L2:
    ldr x0, [x29, #is_perfect.number]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.le .Lis_perfect_L7
    ldr x0, [x29, #is_perfect.sum]
    str x0, [sp, #-16]!
    ldr x0, [x29, #is_perfect.number]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ne .Lis_perfect_L7
    mov x0, #1
    str x0, [sp, #-16]!
    b .Lis_perfect_L8
.Lis_perfect_L7:
    mov x0, #0
    str x0, [sp, #-16]!
.Lis_perfect_L8:
    ldr x0, [sp], #16
    mov sp, x29
    add sp, sp, #32
    ldp x29, x30, [sp], #16
    ret
.size is_perfect, .-is_perfect

.type main, %function
main:
    .set main.number, 0
    stp x29, x30, [sp, #-16]!
    sub sp, sp, #16
    mov x29, sp
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.number]
.Lmain_L1:
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    mov x0, #10001
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ge .Lmain_L2
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl is_perfect
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.eq .Lmain_L3
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    bl print_newline
    b .Lmain_L4
.Lmain_L3:
.Lmain_L4:
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.number]
    b .Lmain_L1
.Lmain_L2:
    mov x0, #0
    mov sp, x29
    add sp, sp, #16
    ldp x29, x30, [sp], #16
    ret
.size main, .-main

print_integer:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, integer_format
    add x0, x0, :lo12:integer_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_text:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, text_format
    add x0, x0, :lo12:text_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_newline:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    adrp x0, newline_format
    add x0, x0, :lo12:newline_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

    .section .note.GNU-stack,"",%progbits
