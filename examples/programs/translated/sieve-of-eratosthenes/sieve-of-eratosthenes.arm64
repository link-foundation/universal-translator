// Sieve of Eratosthenes in ARM64 assembly: the primes up to 100

    .global main
    .section .rodata
integer_format: .asciz "%lld"
text_format: .asciz "%s"
newline_format: .asciz "\n"

    .text
.type main, %function
main:
    .set main.limit, 0
    .set main.is_prime, 8
    .set main.number, 16
    .set main.multiple, 24
    stp x29, x30, [sp, #-16]!
    sub sp, sp, #32
    mov x29, sp
    mov x0, #100
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.limit]
    ldr x0, [x29, #main.limit]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    bl new_array
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.is_prime]
    ldr x0, [x29, #main.is_prime]
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x2, [sp], #16
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    str x2, [x0, x1, lsl #3]
    ldr x0, [x29, #main.is_prime]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x2, [sp], #16
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    str x2, [x0, x1, lsl #3]
    mov x0, #2
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.number]
.Lmain_L1:
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x0, [x29, #main.limit]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ge .Lmain_L2
    ldr x0, [x29, #main.is_prime]
    str x0, [sp, #-16]!
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    ldr x0, [x0, x1, lsl #3]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.ne .Lmain_L3
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    bl print_newline
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    mul x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.multiple]
.Lmain_L5:
    ldr x0, [x29, #main.multiple]
    str x0, [sp, #-16]!
    ldr x0, [x29, #main.limit]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.gt .Lmain_L6
    ldr x0, [x29, #main.is_prime]
    str x0, [sp, #-16]!
    ldr x0, [x29, #main.multiple]
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x2, [sp], #16
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    str x2, [x0, x1, lsl #3]
    ldr x0, [x29, #main.multiple]
    str x0, [sp, #-16]!
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.multiple]
    b .Lmain_L5
.Lmain_L6:
    b .Lmain_L4
.Lmain_L3:
.Lmain_L4:
    ldr x0, [x29, #main.number]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    add x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.number]
    b .Lmain_L1
.Lmain_L2:
    mov x0, #0
    mov sp, x29
    add sp, sp, #32
    ldp x29, x30, [sp], #16
    ret
.size main, .-main

new_array:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x0, x1, [sp, #16]
    lsl x0, x0, #3
    add x0, x0, #8
    bl malloc
    ldp x1, x2, [sp, #16]
    str x1, [x0]
    add x0, x0, #8
    mov x3, #0
.Lnew_array_fill:
    cmp x3, x1
    b.ge .Lnew_array_done
    str x2, [x0, x3, lsl #3]
    add x3, x3, #1
    b .Lnew_array_fill
.Lnew_array_done:
    ldp x29, x30, [sp], #32
    ret

print_integer:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, integer_format
    add x0, x0, :lo12:integer_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_text:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, text_format
    add x0, x0, :lo12:text_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_newline:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    adrp x0, newline_format
    add x0, x0, :lo12:newline_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

    .section .note.GNU-stack,"",%progbits
