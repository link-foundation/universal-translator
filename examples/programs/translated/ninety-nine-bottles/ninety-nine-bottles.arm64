// 99 bottles of beer in ARM64 assembly

    .global main
    .section .rodata
integer_format: .asciz "%lld"
text_format: .asciz "%s"
newline_format: .asciz "\n"
text_0: .asciz " bottles of beer on the wall, "
text_1: .asciz " bottles of beer."
text_2: .asciz "Take one down and pass it around, "
text_3: .asciz " bottles of beer on the wall."

    .text
.type main, %function
main:
    .set main.bottles, 0
    stp x29, x30, [sp, #-16]!
    sub sp, sp, #16
    mov x29, sp
    mov x0, #99
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.bottles]
.Lmain_L1:
    ldr x0, [x29, #main.bottles]
    str x0, [sp, #-16]!
    mov x0, #0
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    cmp x0, x1
    b.le .Lmain_L2
    ldr x0, [x29, #main.bottles]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    adrp x0, text_0
    add x0, x0, :lo12:text_0
    bl print_text
    ldr x0, [x29, #main.bottles]
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    adrp x0, text_1
    add x0, x0, :lo12:text_1
    bl print_text
    bl print_newline
    adrp x0, text_2
    add x0, x0, :lo12:text_2
    bl print_text
    ldr x0, [x29, #main.bottles]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sub x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    bl print_integer
    adrp x0, text_3
    add x0, x0, :lo12:text_3
    bl print_text
    bl print_newline
    ldr x0, [x29, #main.bottles]
    str x0, [sp, #-16]!
    mov x0, #1
    str x0, [sp, #-16]!
    ldr x1, [sp], #16
    ldr x0, [sp], #16
    sub x0, x0, x1
    str x0, [sp, #-16]!
    ldr x0, [sp], #16
    str x0, [x29, #main.bottles]
    b .Lmain_L1
.Lmain_L2:
    mov x0, #0
    mov sp, x29
    add sp, sp, #16
    ldp x29, x30, [sp], #16
    ret
.size main, .-main

print_integer:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, integer_format
    add x0, x0, :lo12:integer_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_text:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, x0
    adrp x0, text_format
    add x0, x0, :lo12:text_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

print_newline:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    adrp x0, newline_format
    add x0, x0, :lo12:newline_format
    bl printf
    ldp x29, x30, [sp], #16
    ret

    .section .note.GNU-stack,"",%progbits
