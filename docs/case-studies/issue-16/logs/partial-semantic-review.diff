+        match crate::fragments::translate_fragment(translator, &part.source, from, to, options) {
+            Ok(written) => return Ok(written),
+            Err(error) => {
+                part.status = PartStatus::Failed;
+                part.message = Some(shift_lines(&error.to_string(), part.start));
