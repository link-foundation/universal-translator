(snapshot: (object: (name: (string: sdk)) (version: (string: 0.0.0-dev.13)) (description: (string: 'Data-oriented operating space of associative data representation. Wellcome to the deep universe')) (homepage: (string: 'https://deep.foundation/')) (author: (object: (name: (string: 'Deep Foundation')) (email: (string: admin@deep.foundation)))) (repository: (object: (type: (string: git)) (url: (string: 'https://github.com/deep-foundation')))) (license: (string: MIT)) (main: (string: build/src/index.js)) (scripts: (object: (build: (string: 'rimraf ./build/src && tsc')) (test: (string: jest)) ('electron:start-live': (string: 'node ./live-runner.js')) ('electron:start': (string: 'npm run build && electron --inspect=5858 ./')) ('electron:debug': (string: 'APP_DEV=true electron .')) ('electron:pack': (string: 'npm run build && node patch-electron-builder.cjs && electron-builder --publish never -c ./electron-builder.config.js')) ('electron:pack-demo': (string: 'npm run build  && node patch-electron-builder.cjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never -c ./electron-builder.config.demo.js')) ('electron:sign': (string: 'npm run electron:sign-prod && npm run electron:sign-dev')) ('electron:sign-prod': (string: "electron-osx-sign dist/mas/sdk.app --entitlements=./entitlements.mas.plist --entitlements-inherit=./entitlements.mas.inherit.plist --identity='Developer ID Application: Deep Foundation (XXXXXXXXXX)' --platform=mas --type=distribution --provisioning-profile=developer-id-sdk.provisionprofile")) ('electron:sign-dev': (string: "electron-osx-sign dist/mas-dev/sdk.app --identity='Developer ID Application: Deep Foundation (XXXXXXXXXX)' --platform=mas --type=development --entitlements=./entitlements.mas.plist --entitlements-inherit=./entitlements.mas.inherit.plist --provisioning-profile=./sdkdevelopment.provisionprofile")) ('electron:notarize': (string: 'node notarize.cjs')) ('electron:make': (string: 'npm run build && electron-builder build --config ./electron-builder.config.js')) ('electron:make-and-publish': (string: 'npm run build && electron-builder build --config ./electron-builder.config.js --publish always')))) (dependencies: (object: (@capacitor-community/electron: (string: ^4.0.1)) (chokidar: (string: ~3.5.2)) (electron-is-dev: (string: ~2.0.0)) (electron-serve: (string: ~1.1.0)) (electron-unhandled: (string: ~3.0.2)) (electron-updater: (string: ~4.3.9)) (electron-window-state: (string: ~5.0.3)) (express: (string: ^4.17.1)) (fix-path: (string: ^3.0.0)) (fkill: (string: ^7.2.1)) (internal-ip: (string: ^6.2.0)) (microtime: (string: ^3.0.0)) (rimraf: (string: ^5.0.1)) (socket.io: (string: ^4.2.0)) (typescript: (string: ^5.0.4)))) (devDependencies: (object: (@types/jest: (string: ^29.5.3)) (@types/node: (string: ^20.12.7)) (electron: (string: ^15.5.7)) (electron-builder: (string: ^23.0.2)) (electron-notarize: (string: ^1.2.2)) (electron-rebuild: (string: ~2.3.5)) (jest: (string: ^29.6.1)) (jest-environment-jsdom: (string: ^29.6.1)) (node-gyp: (string: ^8.4.1)) (puppeteer: (string: ^20.9.0)) (ts-jest: (string: ^29.1.1)))) (keywords: (array: (string: capacitor) (string: electron)))))
