(snapshot: (object: (name: (string: @deep-foundation/sdk)) (version: (string: 0.0.0-dev.13)) (description: (string: ~1{})) (license: (string: Unlicense)) (main: (string: ./bin/server.js)) (bin: (object: (deep-sdk: (string: ./bin/server.js)))) (scripts: (object: ('package:refresh': (string: 'rm -rf node_modules; rm -f package-lock.json; npm i --workspaces false')) (build-pack: (string: '(cd electron && npm run electron:pack)')) (build-core: (string: '(cross-env npm_config_yes=true npm run build-electron)')) (build-windows: (string: '(cross-env MIGRATIONS_DIR=.migrate npm run build-core) && npm run build-pack')) (build-unix: (string: '(cross-env MIGRATIONS_DIR=/tmp/.migrate npm run build-core) && npm run build-pack')) (build-mac: (string: "APPLEIDPASS=$(security find-generic-password -w -a ivansglazunov@gmail.com) APPLEID=ivansglazunov@gmail.com CSC_NAME='Deep Foundation (XXXXXXXXXX)' npm run build-unix")) (open-android: (string: 'npx cap open android')) (build-chrome-extension: (string: run-script-os)) ('build-chrome-extension:linux': (string: "npm run export && mv ./app/_next ./app/next && cd ./app && grep -rl '/_next' * | xargs sed -i 's|/_next|/next|g' && cd ../ && rsync -va --delete-after app/next/ extension/next/ && cp app/*.html extension && rimraf app")) ('build-chrome-extension:darwin': (string: `npm run export && cp -r app/* extension && mv -i extension/_next extension/next && find ./extension -type f \( -name "*.js" -o -name "*.html" -o -name "*.json" \) -exec sed -i '' 's/_next/next/g' {} + && rimraf extension.pem && /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --pack-extension=./extension`)) (build-android: (string: 'rimraf app && npm run export && npx cap sync android')) (build-electron: (string: 'npm run export && npx rimraf electron/app && npx cap copy electron')) (dev-electron: (string: 'npm run export && npx rimraf electron/app && npx cap copy electron && npx cap open electron')) (add-android: (string: 'npm run export && rimraf ./android && npx cap add android')) (install-next-electron: (string: 'npm ci && cd electron && npm ci && cd ..')) (export: (string: '(cross-env NEXT_PUBLIC_EXPORT=1 NEXT_PUBLIC_I18N_DISABLE=1 next build)')) (build: (string: 'rimraf app && next build')) (start: (string: 'next start')) (dev: (string: 'next dev')) (run-ios: (string: 'npx cap run ios')) (open-ios: (string: 'npx cap open ios')) (build-ios: (string: 'rimraf app && npm run export && npx cap sync ios')) (sync-versions: (string: 'node ./sync-version.js && git add . ./electron/package.json')))) (pre-commit: (array: (string: sync-versions))) (dependencies: (object: (@capacitor-community/electron: (string: ^5.0.1)) (@capacitor/android: (string: ^5.7.4)) (@capacitor/cli: (string: ^5.7.4)) (@capacitor/core: (string: ^5.7.4)) (@capacitor/ios: (string: ^5.7.4)) (@chakra-ui/react: (string: ^2.5.5)) (@deep-foundation/deepcase: (string: ^0.0.110)) (@deep-foundation/deeplinks: (string: ~0.0.312)) (@deep-foundation/react-with-packages-installed: (string: ^0.5.3)) (@deep-foundation/store: (string: ~0.0.28)) (@emotion/react: (string: ^11.10.6)) (@emotion/styled: (string: ^11.10.6)) (@types/debug: (string: ^4.1.9)) (@types/node: (string: ^20.12.7)) (@types/react: (string: ^18.0.33)) (@types/serviceworker: (string: ^0.0.62)) (axios: (string: ^1.6.8)) (buffer: (string: ^6.0.3)) (case-anything: (string: ^2.1.13)) (dotenv: (string: ^16.0.3)) (dotenv-load: (string: ^2.0.1)) (events: (string: ^3.3.0)) (firebase: (string: ^9.19.1)) (framer-motion: (string: ^6.5.1)) (i18next: (string: ^23.11.1)) (jest: (string: ^29.5.0)) (next: (string: ^14.2.2)) (next-env: (string: ^1.1.1)) (next-i18next: (string: ^15.2.0)) (next-pwa: (string: ^5.6.0)) (next-transpile-modules: (string: ^10.0.0)) (pre-commit: (string: ^1.2.2)) (react: (string: ^18.2.0)) (react-dom: (string: ^18.2.0)) (react-focus-lock: (string: ^2.12.1)) (react-i18next: (string: ^14.1.0)) (rimraf: (string: ^5.0.5)) (run-script-os: (string: ^1.1.6)) (ts-node: (string: ^10.9.1)) (typescript: (string: 5.0.4)) (typescript-json-schema: (string: ^0.56.0))))))
