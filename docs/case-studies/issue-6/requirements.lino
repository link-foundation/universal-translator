requirements:
  meta-view:
    text: 'Show the meta language version of the left and the right expression'
    from: 'issue 6'
    status: done
    evidence: js/src/meta/notation.js rust/src/meta/notation.rs js/tests/meta-notation.test.js examples/universal-app/src/App.js examples/universal-app/e2e/translate.e2e.mjs
  forgiving-left-language:
    text: 'Changing the left language does not fail: the text on the right is translated into the newly selected language'
    from: 'issue 6'
    status: done
    evidence: examples/universal-app/src/App.js examples/universal-app/e2e/translate.e2e.mjs
  random-examples:
    text: 'Program, Function and Statement buttons show a random example of a supported algorithm in two random languages; Sentence is removed'
    from: 'issue 6'
    status: done
    evidence: examples/universal-app/src/examples.js experiments/random-examples.mjs examples/universal-app/e2e/translate.e2e.mjs
  primes-for-every-language:
    text: 'Semantic primes as a dictionary modifier for every natural language'
    from: 'issue 6'
    status: done
    check: primes-everywhere
    evidence: data/natural/semantic-primes.lino js/src/natural/variants.js js/tests/natural.test.js
  language-versions:
    text: 'Versions of each language: major versions and grammar variations of programming languages, the biggest vocabulary by default with variations and downgrades for natural languages'
    from: 'issue 6'
    status: done
    evidence: js/src/formal/versions.js js/src/natural/variants.js js/tests/versions.test.js data/natural/english-british.lino rust/src/formal/versions.rs rust/src/natural/variants.rs rust/tests/issue_6.rs
  one-entry-per-language:
    text: 'Only one entry per language in the pickers; British or American English follows the browser languages'
    from: 'issue 6'
    status: done
    check: one-entry-per-language
    evidence: js/src/natural/variants.js examples/universal-app/src/LanguagePicker.js examples/universal-app/e2e/translate.e2e.mjs
  ui-settings:
    text: 'Interface languages, themes and skins through link-foundation/ui, behind a small settings link at the bottom of the page'
    from: 'issue 6'
    status: done
    evidence: examples/universal-app/src/SettingsLink.js examples/universal-app/src/settings.js examples/universal-app/src/i18n.js examples/universal-app/src/locales/app.lino docs/screenshots/issue-6/settings.png
  cst-by-default:
    text: 'Concrete syntax trees by default: whitespace, comments and the whitespace inside comments are kept on both sides'
    from: 'issue 6'
    status: done
    evidence: js/src/formal/rules.js rust/src/formal/rules.rs js/tests/comments.test.js rust/tests/grammar.rs
  comment-language:
    text: 'Choose the language of comments apart from the language of the code, also for the same code language'
    from: 'issue 6'
    status: done
    evidence: js/src/translation/comment-language.js js/tests/comments.test.js examples/universal-app/e2e/translate.e2e.mjs rust/src/comment_language.rs rust/src/natural/comments.rs rust/tests/issue_6.rs
  symmetric-features:
    text: 'Every feature works the same across all languages, in both directions, including edge cases'
    from: 'issue 6'
    status: done
    evidence: js/tests/vocabulary-effect.test.js js/tests/comments.test.js js/tests/fragments.test.js rust/tests/grammar.rs
  well-known-standards:
    text: 'Well known standards for all languages, not just English'
    from: 'issue 6'
    status: done
    evidence: js/src/natural/variants.js js/src/formal/versions.js docs/case-studies/issue-6/README.md
  standards-editor:
    text: 'Edit every standard by hand in a separate tab: all its words and the meta language concepts they translate to; save a standard of one own made from the closest one'
    from: 'issue 6'
    status: done
    evidence: examples/universal-app/src/StandardsView.js examples/universal-app/src/saved-standards.js js/src/formal/vocabulary.js js/tests/standards.test.js js/tests/vocabulary-effect.test.js
  small-standards:
    text: 'Each language standard has at most 1024 words'
    from: 'issue 6'
    status: done
    check: small-standards
    evidence: js/src/natural/standards.js js/tests/standards.test.js
  recursive-definitions:
    text: 'Words defined recursively through the words of a standard, looked up on Wikidata with a cache and a pre-cache for tests'
    from: 'issue 6'
    status: done
    evidence: js/src/natural/standards.js scripts/precache-definitions.mjs data/definitions/wikidata-english.lino js/tests/standards.test.js
  issue-1-recheck:
    text: 'Re-check every requirement of issue 1 and do what is not done yet'
    from: 'issue 6'
    status: blocked
    reason: 'Every issue 1 requirement is done except two that stay blocked in docs/case-studies/issue-1/requirements.lino: the Rosetta Code algorithm types that need floating point, strings, higher-order functions, data structures, input and output, objects or concurrency, and classes as fragments (the meta language has no objects yet)'
    evidence: docs/case-studies/issue-1/requirements.lino docs/case-studies/issue-1/rosetta-coverage.lino scripts/check-requirements.mjs
  with-partial-translation:
    text: 'Resolve the conflicts with main: comment languages and versions work with partial translation, the source language auto and rules as data in the library, the command line, the server and the web demo, whose new parts are localized and themed'
    from: 'PR 7 review'
    status: done
    evidence: js/tests/issue-6-with-8.test.js rust/tests/issue_6.rs js/tests/universal-app.test.js examples/universal-app/src/RulesEditor.js examples/universal-app/src/locales/app.lino examples/universal-app/e2e/translate.e2e.mjs docs/screenshots/issue-6/rules-editor.png docs/screenshots/issue-6/russian-dark-rules.png
  issue-6-case-study:
    text: 'Collect the issue data in docs/case-studies/issue-6 with a deep case study, every requirement and the proposed solutions'
    from: 'issue 6'
    status: done
    evidence: docs/case-studies/issue-6/README.md docs/case-studies/issue-6/requirements.md docs/case-studies/issue-6/data/issue-6.lino
