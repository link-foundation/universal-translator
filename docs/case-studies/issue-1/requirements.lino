requirements:
  meta-language:
    text: 'Translate every program through a shared meta language'
    from: 'issue 1'
    status: done
    evidence: js/src/grammar/translator.js rust/src/grammar/mod.rs js/tests/grammar.test.js rust/tests/grammar.rs
  thirty-programming-languages:
    text: 'Support at least 30 of the most popular programming languages'
    from: 'PR 5 review'
    status: done
    check: thirty-programming-languages
    evidence: js/src/grammar/languages.js examples/programs/verify-native.mjs
  hello-world-everywhere:
    text: 'Hello world in every supported programming language'
    from: 'PR 5 review'
    status: done
    check: hello-world-everywhere
    evidence: examples/programs/hello-world.js examples/programs/translated/hello-world
  every-task-everywhere:
    text: 'Every example algorithm translated into every programming language and run natively'
    from: 'issue 1'
    status: done
    check: every-task-everywhere
    evidence: examples/programs/write-translations.mjs examples/programs/verify-native.mjs .github/workflows/release.yml
  machine-code:
    text: 'Assembly, CIL and JVM bytecode to and from every language'
    from: 'issue 1'
    status: done
    check: machine-code
    evidence: js/src/grammar/machine.js js/src/grammar/lifting.js js/tests/lifting.test.js
  thirty-natural-languages:
    text: 'Support at least 30 of the most popular natural languages'
    from: 'PR 5 review'
    status: done
    check: thirty-natural-languages
    evidence: data/natural js/src/natural/catalog.js js/tests/natural.test.js
  controlled-english-and-russian:
    text: 'Start with small controlled versions of English, Russian and other languages'
    from: 'PR 5 review'
    status: done
    check: controlled-english-and-russian
    evidence: data/natural/english.lino data/natural/russian.lino
  semantic-primes:
    text: 'Start with the semantic primes of Natural Semantic Metalanguage'
    from: 'PR 5 review'
    status: done
    check: semantic-primes
    evidence: data/natural/semantic-primes.lino js/src/natural/rules.js
  controlled-standards:
    text: 'ASD-STE100, ACE, Gellish, SBVR, plain language (ISO 24495-1), Minimal English, Minimal Polish, Minimal French, the 65 primes, E-Prime, Basic English, Special English, Globish and cnl-default, each describing every algorithm'
    from: 'PR 5 review'
    status: done
    check: controlled-standards
    evidence: data/natural js/src/natural/rules.js js/tests/natural.test.js
  parse-natural-algorithms:
    text: 'Parse the natural language version of every algorithm in every natural language'
    from: 'PR 5 review'
    status: done
    check: parse-natural-algorithms
    evidence: js/src/natural/reader.js examples/programs/natural js/tests/natural.test.js
  natural-to-formal:
    text: 'Translate from natural language to the meta language and to any formal language'
    from: 'PR 5 review'
    status: done
    check: natural-to-formal
    evidence: js/src/grammar/translator.js js/tests/natural.test.js
  formal-to-natural:
    text: 'Translate from any formal language to any natural language'
    from: 'PR 5 review'
    status: done
    check: formal-to-natural
    evidence: js/src/natural/writer.js examples/programs/write-natural.mjs
  javascript-and-rust:
    text: 'JavaScript and Rust implementations that agree byte for byte'
    from: 'issue 1'
    status: done
    check: javascript-and-rust
    evidence: rust/src/grammar rust/tests/grammar.rs experiments/verify-syntax-exchange.sh
  rosetta-algorithm-types:
    text: 'Support all algorithm types from Rosetta Code'
    from: 'PR 5 review'
    status: blocked
    reason: 'Rosetta Code has more than 1,300 tasks. The meta language covers the algorithm types listed as covered in rosetta-coverage.lino; the types listed there as blocked need values the meta language does not have yet'
    check: rosetta-algorithm-types
    evidence: docs/case-studies/issue-1/rosetta-coverage.lino
  requirements-gate:
    text: 'CI does not pass until every requirement is done (test driven)'
    from: 'PR 5 review'
    status: done
    check: requirements-gate
    evidence: scripts/check-requirements.mjs .github/workflows/release.yml
  case-study:
    text: 'Case study with collected data, requirements and readiness'
    from: 'issue 1'
    status: done
    evidence: docs/case-studies/issue-1/README.md docs/case-studies/issue-1/requirements.md docs/case-studies/issue-1/readiness.md
