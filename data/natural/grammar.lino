grammar:
  english:
    infinitive: 'to {verb}'
    verb-forms: lemma present
    endings: 's' 'es' 'ed' 'ing'
  french:
    verb-lemma: infinitive
    verb-forms: lemma present
    endings: 's' 'x' 'e' 'es' 'er' 'ez' 'ent' 'ons' 'é' 'ée' 'és'
  polish:
    verb-lemma: infinitive
    verb-forms: lemma present
    object-endings: 'a' 'ę'
    object-forms: 'ktoś' 'kogoś' 'ktokolwiek' 'kogokolwiek'
    of-genitive: yes
    endings: 'a' 'e' 'i' 'y' 'u' 'ę' 'ą' 'em' 'om' 'ów' 'ach' 'ami' 'ie' 'ego' 'emu' 'ej'
  russian:
    verb-lemma: infinitive
    verb-forms: lemma present
    object-endings: 'а' 'у' 'я' 'ю' 'мя' 'мя'
    object-forms: 'кто-то' 'кого-то' 'кто-нибудь' 'кого-нибудь' 'кто-либо' 'кого-либо' 'числа' 'числа' 'цифры' 'цифры' 'бутылки' 'бутылки' 'диски' 'диски' 'квадраты' 'квадраты' 'шаги' 'шаги'
    slot-cases: 'return-value.value' accusative 'print-line.value' accusative 'print.value' accusative 'less.right' genitive 'less-or-equal.right' genitive 'greater.right' genitive 'greater-or-equal.right' genitive
    genitive-forms: 'число' 'числа' 'ложь' 'лжи' 'истина' 'истины' 'делитель' 'делителя' 'остаток' 'остатка' 'сумма' 'суммы' 'произведение' 'произведения' 'год' 'года' 'количество' 'количества' 'индекс' 'индекса' 'предел' 'предела' 'числа' 'чисел' 'цифры' 'цифр' 'бутылки' 'бутылок' 'диски' 'дисков' 'квадраты' 'квадратов' 'шаги' 'шагов'
    genitive-endings: 'ое' 'ого' 'ее' 'его' 'ый' 'ого' 'ий' 'его' 'ая' 'ой' 'яя' 'ей' 'а' 'ы' 'я' 'и' 'о' 'а' 'е' 'я'
    of-genitive: yes
    endings: 'а' 'я' 'у' 'ю' 'ы' 'и' 'е' 'о' 'ь' 'ой' 'ей' 'ом' 'ем' 'ов' 'ев' 'ам' 'ям' 'ах' 'ях' 'ами' 'ями' 'ый' 'ий' 'ая' 'яя' 'ое' 'ее' 'ые' 'ие' 'ую' 'юю' 'ого' 'его' 'ому' 'ему' 'ыми' 'ими' 'ть' 'ет' 'ит' 'ют' 'ят' 'ешь' 'ишь'
  spanish:
    verb-lemma: infinitive
    verb-forms: lemma present
    object-forms: 'alguien' 'a alguien'
    endings: 's' 'es' 'o' 'a' 'os' 'as' 'ar' 'er' 'ir' 'an' 'en' 'amos' 'emos'
  dutch:
    verb-lemma: infinitive
    verb-forms: lemma present
    endings: 's' 'e' 'en' 't'
  german:
    verb-lemma: infinitive
    verb-forms: lemma present
    object-forms: 'jemand' 'jemanden' 'niemand' 'niemanden'
    endings: 'e' 'n' 's' 't' 'en' 'er' 'es' 'st' 'te'
  italian:
    verb-lemma: infinitive
    verb-forms: lemma present
    endings: 'a' 'e' 'i' 'o' 'are' 'ere' 'ire' 'ano' 'ono'
  portuguese:
    verb-lemma: infinitive
    verb-forms: lemma present
    endings: 's' 'a' 'o' 'as' 'os' 'es' 'ar' 'er' 'ir' 'am' 'em'
  turkish:
    endings: 'i' 'ı' 'u' 'ü' 'e' 'a' 'de' 'da' 'den' 'dan' 'in' 'ın' 'ler' 'lar' 'mak' 'mek'
  ukrainian:
    verb-lemma: infinitive
    verb-forms: lemma present
    object-endings: 'а' 'у' 'я' 'ю' "м'я" "м'я"
    object-forms: 'хтось' 'когось' 'хто-небудь' 'кого-небудь'
    of-genitive: yes
    endings: 'а' 'я' 'у' 'ю' 'и' 'і' 'е' 'о' 'ь' 'ою' 'ею' 'ом' 'ем' 'ів' 'ей' 'ам' 'ям' 'ах' 'ях' 'ами' 'ями' 'ий' 'ій' 'ого' 'ому' 'ими' 'ти' 'ть'
  chinese:
    spaced: no
  japanese:
    spaced: no
  thai:
    spaced: no
