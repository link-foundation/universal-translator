    else: 'ਵਰਨਾ ਇਹ ਕਰੋ'
    while: 'ਜਦੋਂ ਤੱਕ {condition} ਤਦ ਤੱਕ ਇਹ ਦੁਹਰਾਓ'
    for: 'ਹਰ {variable} ਲਈ {start} ਤੋਂ {last} ਤੱਕ ਇਹ ਦੁਹਰਾਓ'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
