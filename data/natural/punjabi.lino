natural:
  id: 'punjabi'
  label: 'Punjabi'
  native-label: 'ਪੰਜਾਬੀ'
  family: 'Indo-European'
  speakers: '110 million'
  sentence-end: '।'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'ਅਤੇ'
  true: 'ਸੱਚ'
  false: 'ਝੂਠ'
  note: 'ਨੋਟ: {text}'
  templates:
    function: '{name} ਨੂੰ {parameters} ਨਾਲ ਪਰਿਭਾਸ਼ਿਤ ਕਰੋ'
    function-without-parameters: '{name} ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕਰੋ'
    declare: '{name} ਨੂੰ ਮੁੱਲ {value} ਨਾਲ ਬਣਾਓ'
    assign: '{name} ਨੂੰ {value} ਵਿੱਚ ਬਦਲੋ'
    print-line: '{value} ਲਿਖੋ ਅਤੇ ਸਤਰ ਖਤਮ ਕਰੋ'
    print: '{value} ਲਿਖੋ'
    return-value: '{value} ਵਾਪਸ ਕਰੋ'
    return: 'ਇੱਥੇ ਰੁਕੋ'
    nothing: 'ਕੁਝ ਨਾ ਕਰੋ'
    evaluate: '{expression} ਚਲਾਓ'
    if: 'ਜੇ {condition} ਤਾਂ ਇਹ ਕਰੋ'
    else-if: 'ਵਰਨਾ ਜੇ {condition} ਤਾਂ ਇਹ ਕਰੋ'
    else: 'ਵਰਨਾ ਇਹ ਕਰੋ'
    while: 'ਜਦੋਂ ਤੱਕ {condition} ਤਦ ਤੱਕ ਇਹ ਦੁਹਰਾਓ'
    for: 'ਹਰ {variable} ਲਈ {start} ਤੋਂ {last} ਤੱਕ ਇਹ ਦੁਹਰਾਓ'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} ਤੋਂ ਬਾਅਦ {right}'
    or: '{left} ਜਾਂ {right}'
    and: '{left} ਅਤੇ {right}'
    not: 'ਨਹੀਂ {operand}'
    negate: 'ਰਿਣ {operand}'
    equal: '{left} ਦਾ ਮੁੱਲ {right} ਦੇ ਬਰਾਬਰ ਹੈ' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} ਦਾ ਮੁੱਲ {right} ਦੇ ਬਰਾਬਰ ਨਹੀਂ ਹੈ' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} ਦਾ ਮੁੱਲ {right} ਤੋਂ ਘੱਟ ਹੈ' '{left} < {right}'
    less-or-equal: '{left} ਦਾ ਮੁੱਲ {right} ਤੋਂ ਵੱਧ ਨਹੀਂ ਹੈ' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} ਦਾ ਮੁੱਲ {right} ਤੋਂ ਵੱਧ ਹੈ' '{left} > {right}'
    greater-or-equal: '{left} ਦਾ ਮੁੱਲ {right} ਤੋਂ ਘੱਟ ਨਹੀਂ ਹੈ' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} ਜਮ੍ਹਾਂ {right}' '{left} + {right}'
    subtract: '{left} ਘਟਾਓ {right}' '{left} - {right}'
    multiply: '{left} ਗੁਣਾ {right}' '{left} * {right}'
    divide: '{left} ਭਾਗ {right}' '{left} / {right}'
    remainder: '{left} ਮੋਡਿਊਲੋ {right}' '{left} % {right}'
    array: 'ਸੂਚੀ ({elements})'
    new-array: 'ਸੂਚੀ ਲੰਬਾਈ {length} ਹਰ ਤੱਤ {fill}'
    element: '{array} ਵਿੱਚ ਤੱਤ {index}'
    length: '{array} ਦੀ ਲੰਬਾਈ'
    set-element: '{name} ਵਿੱਚ ਤੱਤ {index} ਨੂੰ {value} ਵਿੱਚ ਬਦਲੋ'
