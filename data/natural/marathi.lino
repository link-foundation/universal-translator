natural:
  id: 'marathi'
  label: 'Marathi'
  native-label: 'मराठी'
  family: 'Indo-European'
  speakers: '99 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'आणि'
  true: 'सत्य'
  false: 'असत्य'
  note: 'टीप: {text}'
  templates:
    function: '{name} ची व्याख्या {parameters} वापरून करा'
    function-without-parameters: '{name} ची व्याख्या करा'
    declare: '{name} हे मूल्य {value} सह तयार करा'
    assign: '{name} ला {value} मध्ये बदला'
    print-line: '{value} लिहा आणि ओळ संपवा'
    print: '{value} लिहा'
    return-value: '{value} परत द्या'
    return: 'इथे थांबा'
    nothing: 'काहीही करू नका'
    evaluate: '{expression} चालवा'
    if: 'जर {condition} तर हे करा'
    else-if: 'नाहीतर जर {condition} तर हे करा'
    else: 'नाहीतर हे करा'
    while: 'जोपर्यंत {condition} तोपर्यंत हे पुन्हा करा'
    for: 'प्रत्येक {variable} साठी {start} पासून {last} पर्यंत हे पुन्हा करा'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} नंतर {right}'
    or: '{left} किंवा {right}'
    and: '{left} आणि {right}'
    not: 'नाही {operand}'
    negate: 'ऋण {operand}'
    equal: '{left} चे मूल्य {right} इतके आहे'
    not-equal: '{left} चे मूल्य {right} इतके नाही'
    less: '{left} चे मूल्य {right} पेक्षा कमी आहे'
    less-or-equal: '{left} चे मूल्य {right} पेक्षा जास्त नाही'
    greater: '{left} चे मूल्य {right} पेक्षा जास्त आहे'
    greater-or-equal: '{left} चे मूल्य {right} पेक्षा कमी नाही'
    add: '{left} अधिक {right}'
    subtract: '{left} वजा {right}'
    multiply: '{left} गुणिले {right}'
    divide: '{left} भागिले {right}'
    remainder: '{left} मॉड्यूलो {right}'
  words:
    ackermann: 'एकरमन'
    bottles: 'बाटल्या'
    common: 'सामाईक'
    count: 'मोजणी'
    current: 'सध्याचा'
    digits: 'अंक'
    disks: 'तबकड्या'
    divisor: 'विभाजक'
    factorial: 'क्रमगुणित'
    fibonacci: 'फिबोनाची'
    first: 'पहिला'
    greatest: 'महत्तम'
    hailstone: 'गारा'
    index: 'निर्देशांक'
    is: 'का'
    leap: 'लीप'
    limit: 'मर्यादा'
    move: 'हलवा'
    next: 'पुढील'
    number: 'संख्या'
    of: 'चा'
    previous: 'मागील'
    prime: 'मूळ'
    remainder: 'बाकी'
    second: 'दुसरा'
    source: 'उगम'
    spare: 'राखीव'
    squares: 'वर्ग'
