natural:
  id: 'marathi'
  label: 'Marathi'
  native-label: 'मराठी'
  family: 'Indo-European'
  speakers: '99 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'आणि'
  true: 'सत्य'
  false: 'असत्य'
  note: 'टीप: {text}'
  templates:
    function: '{name} ची व्याख्या {parameters} वापरून करा'
    function-without-parameters: '{name} ची व्याख्या करा'
    declare: '{name} हे मूल्य {value} सह तयार करा'
    assign: '{name} ला {value} मध्ये बदला'
    increase: '{name} ला {value} ने वाढवा'
    decrease: '{name} ला {value} ने कमी करा'
    print-line: '{value} लिहा आणि ओळ संपवा'
    print: '{value} लिहा'
    return-value: '{value} परत द्या'
    return: 'इथे थांबा'
    nothing: 'काहीही करू नका'
    evaluate: '{expression} चालवा'
    if: 'जर {condition} तर हे करा'
    else-if: 'नाहीतर जर {condition} तर हे करा'
    else: 'नाहीतर हे करा'
    while: 'जोपर्यंत {condition} तोपर्यंत हे पुन्हा करा'
    for: 'प्रत्येक {variable} साठी {start} पासून {last} पर्यंत हे पुन्हा करा'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} नंतर {right}'
    or: '{left} किंवा {right}'
    and: '{left} आणि {right}'
    not: 'नाही {operand}'
    negate: 'ऋण {operand}'
    equal: '{left} चे मूल्य {right} इतके आहे' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} चे मूल्य {right} इतके नाही' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} चे मूल्य {right} पेक्षा कमी आहे' '{left} < {right}'
    less-or-equal: '{left} चे मूल्य {right} पेक्षा जास्त नाही' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} चे मूल्य {right} पेक्षा जास्त आहे' '{left} > {right}'
    greater-or-equal: '{left} चे मूल्य {right} पेक्षा कमी नाही' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} अधिक {right}' '{left} + {right}'
    subtract: '{left} वजा {right}' '{left} - {right}'
    multiply: '{left} गुणिले {right}' '{left} * {right}'
    divide: '{left} भागिले {right}' '{left} / {right}'
    remainder: '{left} मॉड्यूलो {right}' '{left} % {right}'
    array: 'यादी ({elements})'
    new-array: 'यादी लांबी {length} प्रत्येक घटक {fill}'
    element: '{array} मधील घटक {index}'
    length: '{array} ची लांबी'
    set-element: '{name} मधील घटक {index} ला {value} मध्ये बदला'
  words:
    ackermann: 'एकरमन'
    bottles: 'बाटल्या'
    common: 'सामाईक'
    count: 'मोजणी'
    current: 'सध्याचा'
    digits: 'अंक'
    disks: 'तबकड्या'
    divisor: 'विभाजक'
    factorial: 'क्रमगुणित'
    female: 'स्त्री'
    fibonacci: 'फिबोनाची'
    first: 'पहिला'
    greatest: 'महत्तम'
    hailstone: 'गारा'
    index: 'निर्देशांक'
    is: 'का'
    leap: 'लीप'
    limit: 'मर्यादा'
    male: 'पुरुष'
    move: 'हलवा'
    multiple: 'पट'
    next: 'पुढील'
    number: 'संख्या'
    numbers: 'आकडे'
    of: 'चा'
    pass: 'फेरी'
    perfect: 'परिपूर्ण'
    position: 'स्थान'
    previous: 'मागील'
    prime: 'मूळ'
    product: 'गुणाकार'
    remainder: 'बाकी'
    second: 'दुसरा'
    source: 'उगम'
    spare: 'राखीव'
    squares: 'वर्ग'
    step: 'पायरी'
    steps: 'पायऱ्या'
    sum: 'बेरीज'
    swap: 'अदलाबदल'
    target: 'लक्ष्य'
    total: 'एकूण'
    year: 'वर्ष'
