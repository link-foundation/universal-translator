natural:
  id: minimal-marathi
  label: 'Minimal Marathi (NSM semantic primes)'
  extends: marathi
  profile: minimal-english
  source: 'https://en.wikipedia.org/wiki/Natural_semantic_metalanguage'
  true: 'खरे'
  false: 'खोटे'
  templates:
    function: 'कोणीतरी {name} हे {parameters} सह असे करते'
    function-without-parameters: 'कोणीतरी {name} हे असे करते'
    declare: '{name} आहे, ते {value} आहे'
    assign: 'यानंतर {name} हे {value} आहे'
    print-line: '{value} एका ओळीवर म्हणा'
    print: '{value} म्हणा'
    return-value: 'उत्तर {value} आहे'
    return: 'इथे थांबा'
    nothing: 'काहीही करू नका'
    evaluate: '{expression} करा'
    if: 'जर {condition} तर हे करा'
    else-if: 'नाहीतर जर {condition} तर हे करा'
    else: 'नाहीतर हे करा'
    while: 'जेव्हा {condition} तेव्हा हे खूप वेळा करा'
    for: 'सर्व {variable} साठी {start} पासून {last} पर्यंत हे करा'
    join: '{left} नंतर {right}'
    equal: '{left} हे {right} सारखेच आहे'
    not-equal: '{left} हे {right} सारखेच नाही'
    less: '{left} हे {right} पेक्षा कमी आहे'
    less-or-equal: '{left} हे {right} पेक्षा जास्त नाही'
    greater: '{left} हे {right} पेक्षा जास्त आहे'
    greater-or-equal: '{left} हे {right} पेक्षा कमी नाही'
    array: 'या गोष्टी ({elements})'
    new-array: '{fill} सारख्या {length} गोष्टी'
    element: '{array} चा भाग {index}'
    length: '{array} चे किती भाग'
    set-element: 'यानंतर {name} चा भाग {index} हा {value} आहे'
  rules:
    primes: marathi
    extra-words: सह ओळीवर उत्तर थांबा वेळा साठी पासून पर्यंत पेक्षा चा चे किती किंवा आणि ऋण अधिक वजा गुणिले भागिले मॉड्यूलो खोटे
