natural:
  id: 'urdu'
  label: 'Urdu'
  native-label: 'اردو'
  family: 'Indo-European'
  speakers: '230 million'
  sentence-end: '۔'
  block-end: ':'
  quotes: '“' '”'
  list-separator: '،'
  list-and: 'اور'
  true: 'سچ'
  false: 'جھوٹ'
  note: 'نوٹ: {text}'
  grammar:
    terms:
      interrogative: 'کیا ہے'
    productions:
      answer-type: '{subject} کی قسم'
      question-type: '@answer-type @interrogative'
      answer-documentation: '{subject} کی دستاویز'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: '{subject} کا ماخذ کوڈ'
      question-source: '@answer-source @interrogative'
      answer-details: '{subject} کی تفصیلی معلومات'
      question-details: '@answer-details @interrogative'
  templates:
    answer-query: '{source} میں ہر {variable} کے لیے {condition} ہونے پر {projection} کی قدریں'
    question-query: '{source} میں ہر {variable} کے لیے {condition} ہونے پر {projection} کی قدریں کیا ہیں'
    answer-deferred-query: '“ملتوی” {source} میں ہر {variable} کے لیے {condition} ہونے پر {projection} کی قدریں'
    question-deferred-query: '“ملتوی” {source} میں ہر {variable} کے لیے {condition} ہونے پر {projection} کی قدریں کیا ہیں'
    documentation: 'دستاویز ہے {value}'
    function: '{name} کو {parameters} سے متعین کریں'
    function-without-parameters: '{name} کو متعین کریں'
    declare: '{name} کو قدر {value} کے ساتھ بنائیں'
    assign: '{name} کو {value} میں بدلیں'
    increase: '{name} کو {value} سے بڑھائیں'
    decrease: '{name} کو {value} سے گھٹائیں'
    print-line: '{value} لکھیں اور سطر ختم کریں'
    print: '{value} لکھیں'
    return-value: '{value} واپس کریں'
    return: 'یہیں رکیں'
    nothing: 'کچھ نہ کریں'
    evaluate: '{expression} چلائیں'
    if: 'اگر {condition} تو یہ کریں'
    else-if: 'ورنہ اگر {condition} تو یہ کریں'
    else: 'ورنہ یہ کریں'
    while: 'جب تک {condition} تب تک یہ دہرائیں'
    for: 'ہر {variable} کے لیے {start} سے {last} تک یہ دہرائیں'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} کے بعد {right}'
    or: '{left} یا {right}'
    and: '{left} اور {right}'
    not: 'نہیں {operand}'
    negate: 'منفی {operand}'
    equal: '{left} کی قدر {right} کے برابر ہے' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} کی قدر {right} کے برابر نہیں ہے' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} کی قدر {right} سے کم ہے' '{left} < {right}'
    less-or-equal: '{left} کی قدر {right} سے زیادہ نہیں ہے' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} کی قدر {right} سے زیادہ ہے' '{left} > {right}'
    greater-or-equal: '{left} کی قدر {right} سے کم نہیں ہے' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} جمع {right}' '{left} + {right}'
    subtract: '{left} تفریق {right}' '{left} - {right}'
    multiply: '{left} ضرب {right}' '{left} * {right}'
    divide: '{left} تقسیم {right}' '{left} / {right}'
    remainder: '{left} ماڈیولو {right}' '{left} % {right}'
    array: 'فہرست ({elements})'
    new-array: 'فہرست لمبائی {length} ہر عنصر {fill}'
    element: '{array} میں عنصر {index}'
    length: '{array} کی لمبائی'
    set-element: '{name} میں عنصر {index} کو {value} میں بدلیں'
  words:
    ackermann: 'ایکرمین'
    bottles: 'بوتلیں'
    common: 'مشترک'
    count: 'گنتی'
    current: 'موجودہ'
    digits: 'ہندسے'
    disks: 'طشتریاں'
    divisor: 'قاسم'
    factorial: 'فیکٹوریل'
    female: 'مونث'
    fibonacci: 'فبوناچی'
    first: 'پہلا'
    greatest: 'عظیم'
    hailstone: 'اولا'
    index: 'اشاریہ'
    is: 'کیا'
    leap: 'لیپ'
    limit: 'حد'
    male: 'مذکر'
    move: 'منتقل'
    multiple: 'مضرب'
    next: 'اگلا'
    number: 'عدد'
    numbers: 'اعداد'
    of: 'کا'
    pass: 'دور'
    perfect: 'کامل'
    position: 'مقام'
    previous: 'پچھلا'
    prime: 'مفرد'
    product: 'حاصلضرب'
    remainder: 'باقی'
    second: 'دوسرا'
    source: 'ماخذ'
    spare: 'فالتو'
    squares: 'مربعے'
    step: 'قدم'
    steps: 'اقدام'
    sum: 'مجموعہ'
    swap: 'تبادلہ'
    target: 'ہدف'
    total: 'میزان'
    year: 'سال'
