natural:
  id: 'urdu'
  label: 'Urdu'
  native-label: 'اردو'
  family: 'Indo-European'
  speakers: '230 million'
  sentence-end: '۔'
  block-end: ':'
  quotes: '“' '”'
  list-separator: '،'
  list-and: 'اور'
  true: 'سچ'
  false: 'جھوٹ'
  note: 'نوٹ: {text}'
  templates:
    function: '{name} کو {parameters} سے متعین کریں'
    function-without-parameters: '{name} کو متعین کریں'
    declare: '{name} کو قدر {value} کے ساتھ بنائیں'
    assign: '{name} کو {value} میں بدلیں'
    print-line: '{value} لکھیں اور سطر ختم کریں'
    print: '{value} لکھیں'
    return-value: '{value} واپس کریں'
    return: 'یہیں رکیں'
    nothing: 'کچھ نہ کریں'
    evaluate: '{expression} چلائیں'
    if: 'اگر {condition} تو یہ کریں'
    else-if: 'ورنہ اگر {condition} تو یہ کریں'
    else: 'ورنہ یہ کریں'
    while: 'جب تک {condition} تب تک یہ دہرائیں'
    for: 'ہر {variable} کے لیے {start} سے {last} تک یہ دہرائیں'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} کے بعد {right}'
    or: '{left} یا {right}'
    and: '{left} اور {right}'
    not: 'نہیں {operand}'
    negate: 'منفی {operand}'
    equal: '{left} کی قدر {right} کے برابر ہے'
    not-equal: '{left} کی قدر {right} کے برابر نہیں ہے'
    less: '{left} کی قدر {right} سے کم ہے'
    less-or-equal: '{left} کی قدر {right} سے زیادہ نہیں ہے'
    greater: '{left} کی قدر {right} سے زیادہ ہے'
    greater-or-equal: '{left} کی قدر {right} سے کم نہیں ہے'
    add: '{left} جمع {right}'
    subtract: '{left} تفریق {right}'
    multiply: '{left} ضرب {right}'
    divide: '{left} تقسیم {right}'
    remainder: '{left} ماڈیولو {right}'
  words:
    ackermann: 'ایکرمین'
    bottles: 'بوتلیں'
    common: 'مشترک'
