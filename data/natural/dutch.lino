natural:
  id: 'dutch'
  label: 'Dutch'
  native-label: 'Nederlands'
  family: 'Indo-European'
  speakers: '25 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'en'
  true: 'waar'
  false: 'onwaar'
  note: 'Opmerking: {text}'
  grammar:
    terms:
      interrogative: 'Wat is'
      query-scope: 'voor elke {variable} in {source}'
      query-deferred: '“uitgesteld”'
    productions:
      answer-type: 'het type van {subject}'
      question-type: '@interrogative @answer-type'
      answer-documentation: 'de documentatie van {subject}'
      question-documentation: '@interrogative @answer-documentation'
      answer-source: 'de broncode van {subject}'
      question-source: '@interrogative @answer-source'
      answer-details: 'de gedetailleerde informatie over {subject}'
      question-details: '@interrogative @answer-details'
      answer-query: 'de waarden van {projection} @query-scope waarvoor {condition}'
      question-query: 'Welke waarden van {projection} @query-scope voldoen aan {condition}'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
      element: 'element {index} van {array}'
      set-element: 'Verander @element[array=name] in {value}'
  templates:
    documentation: 'Documentatie is {value}'
    function: 'Definieer {name} met {parameters}'
    function-without-parameters: 'Definieer {name}'
    declare: 'Maak {name} met waarde {value}' 'Laat {name} gelijk zijn aan {value}'
    assign: 'Verander {name} in {value}' 'Zet {name} op {value}'
    increase: 'Verhoog {name} met {value}' 'Tel {value} op bij {name}'
    decrease: 'Verlaag {name} met {value}' 'Trek {value} af van {name}'
    print-line: 'Schrijf {value} en beëindig de regel' 'Druk {value} af' 'Toon {value}'
    print: 'Schrijf {value}'
    return-value: 'Geef {value} terug'
    return: 'Stop hier'
    nothing: 'Doe niets'
    evaluate: 'Voer {expression} uit'
    if: 'Als {condition}, doe dit'
    else-if: 'Anders, als {condition}, doe dit'
    else: 'Anders, doe dit'
    while: 'Zolang {condition}, herhaal dit'
    for: 'Voor elke {variable} van {start} tot en met {last}, herhaal dit'
    call: '{callee} van ({arguments})'
    call-without-arguments: '{callee} zonder argumenten'
    join: '{left} gevolgd door {right}'
    or: '{left} of {right}'
    and: '{left} en {right}'
    not: 'niet {operand}'
    negate: 'het tegengestelde van {operand}'
    equal: '{left} is gelijk aan {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} is ongelijk aan {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} is kleiner dan {right}' '{left} < {right}'
    less-or-equal: '{left} is hoogstens {right}' '{left} is kleiner dan of gelijk aan {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} is groter dan {right}' '{left} > {right}'
    greater-or-equal: '{left} is minstens {right}' '{left} is groter dan of gelijk aan {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} plus {right}' '{left} + {right}'
    subtract: '{left} min {right}' '{left} - {right}'
    multiply: '{left} maal {right}' '{left} * {right}'
    divide: '{left} gedeeld door {right}' '{left} / {right}'
    remainder: '{left} modulo {right}' '{left} % {right}'
    array: 'de lijst ({elements})'
    new-array: 'een lijst van {length} kopieën van {fill}'
    length: 'de lengte van {array}'
