    increase: 'Zwiększ {name} o {value}' 'Dodaj {value} do {name}'
    decrease: 'Zmniejsz {name} o {value}' 'Odejmij {value} od {name}'
    print-line: 'Wypisz {value} i zakończ wiersz' 'Wyświetl {value}' 'Pokaż {value}' 'Wydrukuj {value}'
    print: 'Wypisz {value}'
    return-value: 'Zwróć {value}'
    return: 'Zatrzymaj się tutaj'
    nothing: 'Nic nie rób'
    evaluate: 'Wykonaj {expression}'
    if: 'Jeśli {condition}, zrób to'
    else-if: 'W przeciwnym razie, jeśli {condition}, zrób to'
    else: 'W przeciwnym razie zrób to'
    while: 'Dopóki {condition}, powtarzaj to'
    for: 'Dla każdego {variable} od {start} do {last} powtarzaj to'
