    not-equal: '{left} nie równa się {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} jest mniejsze od {right}' '{left} jest mniejsze niż {right}' '{left} < {right}'
    less-or-equal: '{left} nie przekracza {right}' '{left} jest mniejsze lub równe {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} przekracza {right}' '{left} jest większe niż {right}' '{left} jest większe od {right}' '{left} > {right}'
    greater-or-equal: '{left} jest co najmniej {right}' '{left} jest większe lub równe {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} plus {right}' '{left} + {right}'
    subtract: '{left} minus {right}' '{left} - {right}'
    multiply: '{left} razy {right}' '{left} * {right}'
    divide: '{left} podzielone przez {right}' '{left} / {right}'
    remainder: '{left} modulo {right}' '{left} % {right}'
