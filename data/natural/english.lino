natural:
  id: english
  label: English
  native-label: English
  profile: cnl-default
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: and
  true: true
  false: false
  note: 'Note: {text}'
  grammar:
    terms:
      type-name: 'type' 'kind'
      type-of: 'the @type-name of'
      documentation-of: 'the documentation of'
      source-of: 'the source of'
      details-of: 'the detailed information about'
      question-open: 'What is' 'Tell me'
      each: 'each {variable}'
      in-source: '@each in {source}'
      query-scope: 'for @in-source'
      values: 'values of {projection}'
      deferred-values: 'deferred @values'
      conditional: 'If {condition}'
      otherwise: 'Otherwise'
      do-this: 'do this'
      repeat-this: 'repeat this'
      collection-loop: 'For @each'
      range-loop: '@collection-loop from {start} to {last}'
      in-loop: '@collection-loop in {array}'
      write-value: 'Write {value}'
      equal-to: 'equal to'
      less-than: 'less than'
      greater-than: 'greater than'
      at-most: '@less-than or @equal-to'
      at-least: '@greater-than or @equal-to'
      array-element: 'item {index} of'
    productions:
      answer-query: 'the @values @query-scope where {condition}'
      question-query: 'Which @values @query-scope satisfy {condition}'
      answer-deferred-query: 'the @deferred-values @query-scope where {condition}'
      question-deferred-query: 'Which @deferred-values @query-scope satisfy {condition}'
      answer-type: '@type-of {subject}'
      question-type: '@question-open @type-of {subject}' 'What type is {subject}'
      answer-documentation: '@documentation-of {subject}'
      question-documentation: '@question-open @documentation-of {subject}'
      answer-source: '@source-of {subject}'
      question-source: '@question-open @source-of {subject}'
      answer-details: '@details-of {subject}'
      question-details: '@question-open @details-of {subject}'
      documentation: 'Documentation is {value}'
      function: 'Define {name} using {parameters}'
      function-without-parameters: 'Define {name}'
      declare: 'Create {name} with value {value}' 'Let {name} be {value}'
      assign: 'Change {name} to {value}' 'Set {name} to {value}'
      increase: 'Increase {name} by {value}' 'Add {value} to {name}'
      decrease: 'Decrease {name} by {value}' 'Subtract {value} from {name}'
      print-line: '@write-value and end the line' 'Print {value}' 'Display {value}' 'Show {value}'
      print: '@write-value'
      return-value: 'Give back {value}' 'Return {value}'
      return: 'Stop here'
      nothing: 'Do nothing'
      evaluate: 'Run {expression}'
      if: '@conditional, @do-this' '@conditional, then' '@conditional then' '@conditional'
      else-if: '@otherwise, if {condition}, @do-this' 'Else if {condition}' '@otherwise, if {condition}'
      else: '@otherwise, @do-this' 'Else' '@otherwise'
      while: 'While {condition}, @repeat-this' 'While {condition}, @do-this' 'While {condition}'
      for: '@range-loop, @repeat-this' '@range-loop, @do-this' '@range-loop'
      for-each: '@in-loop, @repeat-this' '@in-loop, @do-this' '@in-loop'
      call: '{callee} of ({arguments})'
      call-without-arguments: '{callee} of nothing'
      join: '{left} followed by {right}'
      or: '{left} or {right}'
      and: '{left} and {right}'
      not: 'not {operand}'
      negate: 'the negative of {operand}'
      equal: '{left} equals {right}' '{left} is @equal-to {right}' '{left} is equal {right}' '{left} = {right}' '{left} == {right}'
      not-equal: '{left} does not equal {right}' '{left} is not @equal-to {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
      less: '{left} falls below {right}' '{left} is @less-than {right}' '{left} is smaller than {right}' '{left} < {right}'
      less-or-equal: '{left} does not exceed {right}' '{left} is @at-most {right}' '{left} is at most {right}' '{left} is not more than {right}' '{left} is not @greater-than {right}' '{left} <= {right}' '{left} ≤ {right}'
      greater: '{left} exceeds {right}' '{left} is @greater-than {right}' '{left} is more than {right}' '{left} is larger than {right}' '{left} > {right}'
      greater-or-equal: '{left} does not fall below {right}' '{left} is @at-least {right}' '{left} is at least {right}' '{left} is not @less-than {right}' '{left} >= {right}' '{left} ≥ {right}'
      add: '{left} plus {right}' '{left} + {right}'
      subtract: '{left} minus {right}' '{left} - {right}'
      multiply: '{left} times {right}' '{left} * {right}'
      divide: '{left} divided by {right}' '{left} / {right}'
      remainder: '{left} modulo {right}' '{left} % {right}'
      array: 'the list ({elements})'
      new-array: 'a list of {length} copies of {fill}'
      element: '@array-element {array}'
      length: 'the length of {array}'
      set-element: 'Change @array-element {name} to {value}'
