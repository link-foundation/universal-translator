natural:
  id: english
  label: English
  native-label: English
  profile: cnl-default
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: and
  true: true
  false: false
  note: 'Note: {text}'
  templates:
    function: 'Define {name} using {parameters}'
    function-without-parameters: 'Define {name}'
    declare: 'Create {name} with value {value}'
    assign: 'Change {name} to {value}'
    print-line: 'Write {value} and end the line'
    print: 'Write {value}'
    return-value: 'Give back {value}'
    return: 'Stop here'
    nothing: 'Do nothing'
    evaluate: 'Run {expression}'
    if: 'If {condition}, do this' 'If {condition}, then' 'If {condition} then' 'If {condition}'
    else-if: 'Otherwise, if {condition}, do this' 'Else if {condition}' 'Otherwise, if {condition}'
    else: 'Otherwise, do this' 'Else' 'Otherwise'
    while: 'While {condition}, repeat this' 'While {condition}'
    for: 'For each {variable} from {start} to {last}, repeat this'
    call: '{callee} of ({arguments})'
    call-without-arguments: '{callee} of nothing'
    join: '{left} followed by {right}'
    or: '{left} or {right}'
    and: '{left} and {right}'
    not: 'not {operand}'
    negate: 'the negative of {operand}'
    equal: '{left} equals {right}' '{left} is equal to {right}' '{left} is equal {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} does not equal {right}' '{left} is not equal to {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} falls below {right}' '{left} is less than {right}' '{left} is smaller than {right}' '{left} < {right}'
    less-or-equal: '{left} does not exceed {right}' '{left} is less than or equal to {right}' '{left} is at most {right}' '{left} is not more than {right}' '{left} is not greater than {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} exceeds {right}' '{left} is greater than {right}' '{left} is more than {right}' '{left} is larger than {right}' '{left} > {right}'
    greater-or-equal: '{left} does not fall below {right}' '{left} is greater than or equal to {right}' '{left} is at least {right}' '{left} is not less than {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} plus {right}'
    subtract: '{left} minus {right}'
    multiply: '{left} times {right}'
    divide: '{left} divided by {right}'
    remainder: '{left} modulo {right}'
    array: 'the list ({elements})'
    new-array: 'a list of {length} copies of {fill}'
    element: 'item {index} of {array}'
    length: 'the length of {array}'
    set-element: 'Change item {index} of {name} to {value}'
