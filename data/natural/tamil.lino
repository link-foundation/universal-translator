natural:
  id: 'tamil'
  label: 'Tamil'
  native-label: 'தமிழ்'
  family: 'Dravidian'
  speakers: '85 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'மற்றும்'
  true: 'உண்மை'
  false: 'பொய்'
  note: 'குறிப்பு: {text}'
  templates:
    function: '{name} ஐ {parameters} கொண்டு வரையறு'
    function-without-parameters: '{name} ஐ வரையறு'
    declare: '{name} ஐ மதிப்பு {value} உடன் உருவாக்கு'
    assign: '{name} ஐ {value} ஆக மாற்று'
    print-line: '{value} எழுதி வரியை முடி'
    print: '{value} எழுது'
    return-value: '{value} திருப்பி அனுப்பு'
    return: 'இங்கே நிறுத்து'
    nothing: 'எதுவும் செய்யாதே'
    evaluate: '{expression} இயக்கு'
    if: 'ஒருவேளை {condition} என்றால் இதைச் செய்'
    else-if: 'இல்லையெனில் ஒருவேளை {condition} என்றால் இதைச் செய்'
    else: 'இல்லையெனில் இதைச் செய்'
    while: '{condition} இருக்கும் வரை இதை மீண்டும் செய்'
    for: 'ஒவ்வொரு {variable} க்கும் {start} முதல் {last} வரை இதை மீண்டும் செய்'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} அதன் பின் {right}'
    or: '{left} அல்லது {right}'
    and: '{left} மற்றும் {right}'
    not: 'அல்ல {operand}'
    negate: 'எதிர்மறை {operand}'
    equal: '{left} மதிப்பு {right} க்கு சமம்'
    not-equal: '{left} மதிப்பு {right} க்கு சமம் அல்ல'
    less: '{left} மதிப்பு {right} ஐ விட குறைவு'
    less-or-equal: '{left} மதிப்பு {right} ஐ விட அதிகம் அல்ல'
    greater: '{left} மதிப்பு {right} ஐ விட அதிகம்'
    greater-or-equal: '{left} மதிப்பு {right} ஐ விட குறைவு அல்ல'
    add: '{left} கூட்டல் {right}'
    subtract: '{left} கழித்தல் {right}'
    multiply: '{left} பெருக்கல் {right}'
    divide: '{left} வகுத்தல் {right}'
    remainder: '{left} மாடுலோ {right}'
