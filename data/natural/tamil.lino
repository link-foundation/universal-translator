    answer-type: '{subject} இன் வகை'
    question-type: '{subject} இன் வகை என்ன'
    answer-documentation: '{subject} இன் ஆவணம்'
    question-documentation: '{subject} இன் ஆவணம் என்ன'
    answer-source: '{subject} இன் மூல நிரல்'
    question-source: '{subject} இன் மூல நிரல் என்ன'
    answer-details: '{subject} இன் விரிவான தகவல்'
    question-details: '{subject} இன் விரிவான தகவல் என்ன'
    documentation: 'ஆவணம் என்பது {value}'
    function: '{name} ஐ {parameters} கொண்டு வரையறு'
    function-without-parameters: '{name} ஐ வரையறு'
    declare: '{name} ஐ மதிப்பு {value} உடன் உருவாக்கு'
    assign: '{name} ஐ {value} ஆக மாற்று'
    increase: '{name} ஐ {value} ஆல் அதிகரி'
    decrease: '{name} ஐ {value} ஆல் குறை'
    print-line: '{value} எழுதி வரியை முடி'
    print: '{value} எழுது'
    return-value: '{value} திருப்பி அனுப்பு'
    return: 'இங்கே நிறுத்து'
    nothing: 'எதுவும் செய்யாதே'
    evaluate: '{expression} இயக்கு'
    if: 'ஒருவேளை {condition} என்றால் இதைச் செய்'
    else-if: 'இல்லையெனில் ஒருவேளை {condition} என்றால் இதைச் செய்'
    else: 'இல்லையெனில் இதைச் செய்'
    while: '{condition} இருக்கும் வரை இதை மீண்டும் செய்'
    for: 'ஒவ்வொரு {variable} க்கும் {start} முதல் {last} வரை இதை மீண்டும் செய்'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} அதன் பின் {right}'
    or: '{left} அல்லது {right}'
    and: '{left} மற்றும் {right}'
    not: 'அல்ல {operand}'
    negate: 'எதிர்மறை {operand}'
    equal: '{left} மதிப்பு {right} க்கு சமம்' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} மதிப்பு {right} க்கு சமம் அல்ல' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} மதிப்பு {right} ஐ விட குறைவு' '{left} < {right}'
    less-or-equal: '{left} மதிப்பு {right} ஐ விட அதிகம் அல்ல' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} மதிப்பு {right} ஐ விட அதிகம்' '{left} > {right}'
    greater-or-equal: '{left} மதிப்பு {right} ஐ விட குறைவு அல்ல' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} கூட்டல் {right}' '{left} + {right}'
    subtract: '{left} கழித்தல் {right}' '{left} - {right}'
    multiply: '{left} பெருக்கல் {right}' '{left} * {right}'
    divide: '{left} வகுத்தல் {right}' '{left} / {right}'
    remainder: '{left} மாடுலோ {right}' '{left} % {right}'
    array: 'பட்டியல் ({elements})'
    new-array: 'பட்டியல் நீளம் {length} ஒவ்வொரு உறுப்பும் {fill}'
    element: '{array} இல் உறுப்பு {index}'
    length: '{array} நீளம்'
    set-element: '{name} இல் உறுப்பு {index} ஐ {value} ஆக மாற்று'
