natural:
  id: 'persian'
  label: 'Persian'
  native-label: 'فارسی'
  family: 'Indo-European'
  speakers: '80 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '«' '»'
  list-separator: '،'
  list-and: 'و'
  true: 'درست'
  false: 'نادرست'
  note: 'یادداشت: {text}'
  grammar:
    terms:
      interrogative: 'چیست'
      query-scope: 'برای هر {variable} در {source}'
      query-deferred: '«تأخیری»'
    productions:
      answer-type: 'نوع {subject}'
      question-type: '@answer-type @interrogative'
      answer-documentation: 'مستندات {subject}'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: 'کد منبع {subject}'
      question-source: '@answer-source @interrogative'
      answer-details: 'اطلاعات تفصیلی درباره {subject}'
      question-details: '@answer-details @interrogative'
      answer-query: 'مقادیر {projection} @query-scope که {condition}'
      question-query: '@answer-query چیست'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
      element: 'عنصر {index} در {array}'
      set-element: '@element[array=name] را به {value} تغییر بده'
  templates:
    documentation: 'مستندات عبارت است از {value}'
    function: '{name} را با {parameters} تعریف کن'
    function-without-parameters: '{name} را تعریف کن'
    declare: '{name} را با مقدار {value} بساز'
    assign: '{name} را به {value} تغییر بده'
    increase: '{name} را به اندازه {value} افزایش بده'
    decrease: '{name} را به اندازه {value} کاهش بده'
    print-line: '{value} را بنویس و سطر را تمام کن'
    print: '{value} را بنویس'
    return-value: '{value} را برگردان'
    return: 'اینجا بایست'
    nothing: 'هیچ کاری نکن'
    evaluate: '{expression} را اجرا کن'
    if: 'اگر {condition} آنگاه این را انجام بده'
    else-if: 'وگرنه اگر {condition} آنگاه این را انجام بده'
    else: 'وگرنه این را انجام بده'
    while: 'تا وقتی {condition} این را تکرار کن'
    for: 'برای هر {variable} از {start} تا {last} این را تکرار کن'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} سپس {right}'
    or: '{left} یا {right}'
    and: '{left} و {right}'
    not: 'نه {operand}'
    negate: 'منفی {operand}'
    equal: '{left} برابر {right} است' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} برابر {right} نیست' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} کمتر از {right} است' '{left} < {right}'
    less-or-equal: '{left} بیشتر از {right} نیست' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} بیشتر از {right} است' '{left} > {right}'
    greater-or-equal: '{left} کمتر از {right} نیست' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} بعلاوه {right}' '{left} + {right}'
    subtract: '{left} منهای {right}' '{left} - {right}'
    multiply: '{left} ضربدر {right}' '{left} * {right}'
    divide: '{left} تقسیم بر {right}' '{left} / {right}'
    remainder: '{left} به پیمانه {right}' '{left} % {right}'
    array: 'فهرست ({elements})'
    new-array: 'فهرستی به طول {length} با مقدار {fill}'
    length: 'طول {array}'
  words:
    ackermann: 'آکرمن'
    bottles: 'بطری‌ها'
    common: 'مشترک'
    count: 'شمار'
    current: 'کنونی'
    digits: 'رقم‌ها'
    disks: 'دیسک‌ها'
    divisor: 'بخشیاب'
    factorial: 'فاکتوریل'
    female: 'مؤنث'
    fibonacci: 'فیبوناچی'
    first: 'نخستین'
    greatest: 'بزرگترین'
    hailstone: 'تگرگ'
    index: 'نمایه'
    is: 'آیا'
    leap: 'کبیسه'
    limit: 'حد'
    male: 'مذکر'
    move: 'جابجا'
    multiple: 'مضرب'
    next: 'بعدی'
    number: 'عدد'
    numbers: 'اعداد'
    of: 'از'
    pass: 'دور'
    perfect: 'کامل'
    position: 'جایگاه'
    previous: 'قبلی'
    prime: 'اول'
    product: 'حاصل‌ضرب'
    remainder: 'باقیمانده'
    second: 'دومین'
    source: 'مبدأ'
    spare: 'کمکی'
    squares: 'مربع‌ها'
    step: 'گام'
    steps: 'گام‌ها'
    sum: 'مجموع'
    swap: 'تعویض'
    target: 'مقصد'
    total: 'کل'
    year: 'سال'
