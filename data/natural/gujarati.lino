natural:
  id: 'gujarati'
  label: 'Gujarati'
  native-label: 'ગુજરાતી'
  family: 'Indo-European'
  speakers: '60 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'અને'
  true: 'સાચું'
  false: 'ખોટું'
  note: 'નોંધ: {text}'
  grammar:
    terms:
      interrogative: 'શું છે'
    productions:
      answer-type: '{subject} નો પ્રકાર'
      question-type: '@answer-type @interrogative'
      answer-documentation: '{subject} નું વર્ણન'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: '{subject} નો સ્રોત કોડ'
      question-source: '@answer-source @interrogative'
      answer-details: '{subject} ની વિગતવાર માહિતી'
      question-details: '@answer-details @interrogative'
  templates:
    answer-query: '{source} માં દરેક {variable} માટે {condition} હોય ત્યારે {projection} ના મૂલ્યો'
    question-query: '{source} માં દરેક {variable} માટે {condition} હોય ત્યારે {projection} ના મૂલ્યો કયા છે'
    answer-deferred-query: '“વિલંબિત” {source} માં દરેક {variable} માટે {condition} હોય ત્યારે {projection} ના મૂલ્યો'
    question-deferred-query: '“વિલંબિત” {source} માં દરેક {variable} માટે {condition} હોય ત્યારે {projection} ના મૂલ્યો કયા છે'
    documentation: 'વર્ણન છે {value}'
    function: '{name} ને {parameters} વડે વ્યાખ્યાયિત કરો'
    function-without-parameters: '{name} ને વ્યાખ્યાયિત કરો'
    declare: '{name} ને કિંમત {value} સાથે બનાવો'
    assign: '{name} ને {value} માં બદલો'
    increase: '{name} ને {value} વધારો'
    decrease: '{name} ને {value} ઘટાડો'
    print-line: '{value} લખો અને લીટી પૂરી કરો'
    print: '{value} લખો'
    return-value: '{value} પાછું આપો'
    return: 'અહીં અટકો'
    nothing: 'કંઈ ન કરો'
    evaluate: '{expression} ચલાવો'
    if: 'જો {condition} તો આ કરો'
    else-if: 'નહીંતર જો {condition} તો આ કરો'
    else: 'નહીંતર આ કરો'
    while: 'જ્યાં સુધી {condition} ત્યાં સુધી આ ફરી કરો'
    for: 'દરેક {variable} માટે {start} થી {last} સુધી આ ફરી કરો'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} પછી {right}'
    or: '{left} અથવા {right}'
    and: '{left} અને {right}'
    not: 'નહીં {operand}'
    negate: 'ઋણ {operand}'
    equal: '{left} નું મૂલ્ય {right} બરાબર છે' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} નું મૂલ્ય {right} બરાબર નથી' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} નું મૂલ્ય {right} કરતાં ઓછું છે' '{left} < {right}'
    less-or-equal: '{left} નું મૂલ્ય {right} કરતાં વધુ નથી' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} નું મૂલ્ય {right} કરતાં વધુ છે' '{left} > {right}'
    greater-or-equal: '{left} નું મૂલ્ય {right} કરતાં ઓછું નથી' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} વત્તા {right}' '{left} + {right}'
    subtract: '{left} ઓછા {right}' '{left} - {right}'
    multiply: '{left} ગુણ્યા {right}' '{left} * {right}'
    divide: '{left} ભાગ્યા {right}' '{left} / {right}'
    remainder: '{left} મોડ્યુલો {right}' '{left} % {right}'
    array: 'યાદી ({elements})'
    new-array: 'યાદી લંબાઈ {length} દરેક ઘટક {fill}'
    element: '{array} માં ઘટક {index}'
    length: '{array} ની લંબાઈ'
    set-element: '{name} માં ઘટક {index} ને {value} માં બદલો'
