natural:
  id: english-basic-english
  label: 'English (Basic English)'
  extends: english
  profile: basic-english
  source: 'https://en.wikipedia.org/wiki/Basic_English'
  grammar:
    productions:
      element: 'part {index} of {array}'
      set-element: 'Let @element[array=name] now be {value}'
  templates:
    function: 'Make {name} from {parameters} by these steps'
    function-without-parameters: 'Make {name} by these steps'
    declare: 'Let {name} be {value}'
    assign: 'Let {name} now be {value}'
    print-line: 'Say {value} and end the line'
    print: 'Say {value}'
    return-value: 'Give back {value}'
    nothing: 'Do no work'
    evaluate: 'Do {expression}'
    if: 'If {condition}, do this'
    else-if: 'If not, but {condition}, do this'
    else: 'If not, do this'
    while: 'While {condition}, do this again and again'
    for: 'For every {variable} from {start} till {last}, do this'
    for-each: 'For every {variable} in {array}, do this'
    call-without-arguments: '{callee} ( )'
    join: '{left} then {right}'
    negate: 'the opposite of {operand}'
    equal: '{left} is {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} is not {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} is under {right}' '{left} < {right}'
    less-or-equal: '{left} is not over {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} is over {right}' '{left} > {right}'
    greater-or-equal: '{left} is not under {right}' '{left} >= {right}' '{left} ≥ {right}'
    length: 'the size of {array}'
  rules:
    max-sentence-words: 25
    vocabulary: make from by these steps let be now say and end the line give back stop here do no work if not but this while again for every till of in then or opposite is under over true false list a copies part size
    extra-words: plus minus times divided modulo
