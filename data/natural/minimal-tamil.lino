natural:
  id: minimal-tamil
  label: 'Minimal Tamil (NSM semantic primes)'
  extends: tamil
  profile: minimal-english
  source: 'https://en.wikipedia.org/wiki/Natural_semantic_metalanguage'
  templates:
    function: 'யாரோ {name} ஐ {parameters} கொண்டு இப்படிச் செய்கிறார்'
    function-without-parameters: 'யாரோ {name} ஐ இப்படிச் செய்கிறார்'
    declare: '{name} உள்ளது, அது {value}'
    assign: 'இதன் பிறகு {name} இப்போது {value}'
    print-line: '{value} ஐ ஒரு வரியில் சொல்'
    print: '{value} ஐ சொல்'
    return-value: 'பதில் {value}'
    return: 'இங்கே நிறுத்து'
    nothing: 'எதுவும் செய்யாதே'
    evaluate: '{expression} செய்'
    if: '{condition} என்றால் இதைச் செய்'
    else-if: 'இல்லையென்றால், {condition} என்றால் இதைச் செய்'
    else: 'இல்லையென்றால் இதைச் செய்'
    while: '{condition} இருக்கும் போது இதைப் பல முறை செய்'
    for: 'எல்லா {variable} க்கும் {start} முதல் {last} வரை இதைச் செய்'
    join: '{left} அதன் பின் {right}'
    equal: '{left} உம் {right} உம் ஒன்றே'
    not-equal: '{left} உம் {right} உம் வேறு'
    less: '{left} என்பது {right} ஐ விட குறைவு'
    less-or-equal: '{left} என்பது {right} ஐ விட அதிகம் அல்ல'
    greater: '{left} என்பது {right} ஐ விட அதிகம்'
    greater-or-equal: '{left} என்பது {right} ஐ விட குறைவு அல்ல'
    array: 'இந்தப் பொருட்கள் ({elements})'
    new-array: '{fill} போன்ற {length} பொருட்கள்'
    element: '{array} இல் பகுதி {index}'
    length: '{array} இல் எத்தனை பகுதிகள்'
    set-element: 'இதன் பிறகு {name} இல் பகுதி {index} இப்போது {value}'
  rules:
    primes: tamil
    extra-words: ஐ கொண்டு வரியில் பதில் நிறுத்து செய்யாதே முறை க்கும் முதல் வரை உம் என்பது விட இல் எத்தனை அல்லது மற்றும் எதிர்மறை கூட்டல் கழித்தல் பெருக்கல் வகுத்தல் மாடுலோ பொய்
