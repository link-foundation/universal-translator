natural:
  id: 'arabic'
  label: 'Arabic'
  native-label: 'العربية'
  family: 'Afro-Asiatic'
  speakers: '400 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '«' '»'
  list-separator: '،'
  list-and: 'و'
  true: 'صحيح'
  false: 'خطأ'
  note: 'ملاحظة: {text}'
  templates:
    function: 'عرّف {name} باستخدام {parameters}'
    function-without-parameters: 'عرّف {name}'
    declare: 'أنشئ {name} بالقيمة {value}'
    assign: 'غيّر {name} إلى {value}'
    print-line: 'اكتب {value} ثم أنه السطر'
    print: 'اكتب {value}'
    return-value: 'أعد {value}'
    return: 'توقف هنا'
    nothing: 'لا تفعل شيئا'
    evaluate: 'نفّذ {expression}'
    if: 'إذا {condition} فافعل هذا'
    else-if: 'وإلا إذا {condition} فافعل هذا'
    else: 'وإلا فافعل هذا'
    while: 'طالما {condition} فكرر هذا'
    for: 'لكل {variable} من {start} إلى {last} كرر هذا'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} يليه {right}'
    or: '{left} أو {right}'
    and: '{left} و {right}'
    not: 'ليس {operand}'
    negate: 'سالب {operand}'
    equal: '{left} يساوي {right}'
    not-equal: '{left} لا يساوي {right}'
    less: '{left} أصغر من {right}'
    less-or-equal: '{left} لا يتجاوز {right}'
    greater: '{left} أكبر من {right}'
    greater-or-equal: '{left} لا يقل عن {right}'
    add: '{left} زائد {right}'
    subtract: '{left} ناقص {right}'
    multiply: '{left} مضروبا في {right}'
    divide: '{left} مقسوما على {right}'
    remainder: '{left} بمقياس {right}'
