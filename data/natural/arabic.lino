natural:
  id: 'arabic'
  label: 'Arabic'
  native-label: 'العربية'
  family: 'Afro-Asiatic'
  speakers: '400 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '«' '»'
  list-separator: '،'
  list-and: 'و'
  true: 'صحيح'
  false: 'خطأ'
  note: 'ملاحظة: {text}'
  grammar:
    terms:
      interrogative: 'ما هو'
    productions:
      answer-type: 'نوع {subject}'
      question-type: '@interrogative @answer-type'
      answer-documentation: 'توثيق {subject}'
      question-documentation: '@interrogative @answer-documentation'
      answer-source: 'المصدر البرمجي لـ {subject}'
      question-source: '@interrogative @answer-source'
      answer-details: 'المعلومات المفصلة عن {subject}'
      question-details: '@interrogative @answer-details'
  templates:
    answer-query: 'قيم {projection} لكل {variable} في {source} حيث {condition}'
    question-query: 'ما قيم {projection} لكل {variable} في {source} حيث {condition}'
    answer-deferred-query: '«المؤجلة» قيم {projection} لكل {variable} في {source} حيث {condition}'
    question-deferred-query: '«المؤجلة» ما قيم {projection} لكل {variable} في {source} حيث {condition}'
    documentation: 'التوثيق هو {value}'
    function: 'عرّف {name} باستخدام {parameters}'
    function-without-parameters: 'عرّف {name}'
    declare: 'أنشئ {name} بالقيمة {value}'
    assign: 'غيّر {name} إلى {value}'
    increase: 'زد {name} بمقدار {value}'
    decrease: 'أنقص {name} بمقدار {value}'
    print-line: 'اكتب {value} ثم أنه السطر'
    print: 'اكتب {value}'
    return-value: 'أعد {value}'
    return: 'توقف هنا'
    nothing: 'لا تفعل شيئا'
    evaluate: 'نفّذ {expression}'
    if: 'إذا {condition} فافعل هذا'
    else-if: 'وإلا إذا {condition} فافعل هذا'
    else: 'وإلا فافعل هذا'
    while: 'طالما {condition} فكرر هذا'
    for: 'لكل {variable} من {start} إلى {last} كرر هذا'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} يليه {right}'
    or: '{left} أو {right}'
    and: '{left} و {right}'
    not: 'ليس {operand}'
    negate: 'سالب {operand}'
    equal: '{left} يساوي {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} لا يساوي {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} أصغر من {right}' '{left} < {right}'
    less-or-equal: '{left} لا يتجاوز {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} أكبر من {right}' '{left} > {right}'
    greater-or-equal: '{left} لا يقل عن {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} زائد {right}' '{left} + {right}'
    subtract: '{left} ناقص {right}' '{left} - {right}'
    multiply: '{left} مضروبا في {right}' '{left} * {right}'
    divide: '{left} مقسوما على {right}' '{left} / {right}'
    remainder: '{left} بمقياس {right}' '{left} % {right}'
    array: 'القائمة ({elements})'
    new-array: 'قائمة طولها {length} وكل عناصرها {fill}'
    element: 'العنصر {index} في {array}'
    length: 'طول {array}'
    set-element: 'غيّر العنصر {index} في {name} إلى {value}'
  words:
    ackermann: 'أكرمان'
    bottles: 'زجاجات'
    common: 'مشترك'
    count: 'تعداد'
    current: 'حالي'
    digits: 'أرقام'
    disks: 'أقراص'
    divisor: 'قاسم'
    factorial: 'مضروب'
    female: 'مؤنث'
    fibonacci: 'فيبوناتشي'
    first: 'أول'
    greatest: 'أعظم'
    hailstone: 'برد'
    index: 'فهرس'
    is: 'هل'
    leap: 'كبيس'
    limit: 'حد'
    male: 'مذكر'
    move: 'انقل'
    multiple: 'مضاعف'
    next: 'تالي'
    number: 'عدد'
    numbers: 'أعداد'
