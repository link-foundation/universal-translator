natural:
  id: 'turkish'
  label: 'Turkish'
  native-label: 'Türkçe'
  family: 'Turkic'
  speakers: '90 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 've'
  true: 'doğru'
  false: 'yanlış'
  note: 'Not: {text}'
  grammar:
    terms:
      interrogative: 'nedir'
    productions:
      answer-type: '{subject} türü'
      question-type: '@answer-type @interrogative'
      answer-documentation: '{subject} belgesi'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: '{subject} kaynak kodu'
      question-source: '@answer-source @interrogative'
      answer-details: '{subject} hakkında ayrıntılı bilgi'
      question-details: '@answer-details @interrogative'
  templates:
    answer-query: '{source} içindeki her {variable} için {condition} olduğunda {projection} değerleri'
    question-query: '{source} içindeki her {variable} için {condition} olduğunda {projection} değerleri nelerdir'
    answer-deferred-query: '“ertelenmiş” {source} içindeki her {variable} için {condition} olduğunda {projection} değerleri'
    question-deferred-query: '“ertelenmiş” {source} içindeki her {variable} için {condition} olduğunda {projection} değerleri nelerdir'
    documentation: 'Belge şudur {value}'
    function: '{name} işlevini {parameters} ile tanımla'
    function-without-parameters: '{name} işlevini tanımla'
    declare: '{name} değişkenini {value} değeriyle oluştur'
    assign: '{name} değerini {value} yap'
    increase: '{name} değerini {value} artır'
    decrease: '{name} değerini {value} azalt'
    print-line: '{value} yaz ve satırı bitir'
    print: '{value} yaz'
    return-value: '{value} döndür'
    return: 'Burada dur'
    nothing: 'Hiçbir şey yapma'
    evaluate: '{expression} çalıştır'
    if: 'Eğer {condition} ise şunu yap'
    else-if: 'Değilse eğer {condition} ise şunu yap'
    else: 'Değilse şunu yap'
    while: '{condition} olduğu sürece şunu tekrarla'
    for: 'Her {variable} için {start} ile {last} arasında şunu tekrarla'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} ardından {right}'
    or: '{left} veya {right}'
    and: '{left} ve {right}'
    not: '{operand} değil'
    negate: 'negatif {operand}'
    equal: '{left} ile {right} eşit' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} ile {right} farklı' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} {right} değerinden küçük' '{left} < {right}'
    less-or-equal: '{left} en fazla {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} {right} değerinden büyük' '{left} > {right}'
    greater-or-equal: '{left} en az {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} artı {right}' '{left} + {right}'
    subtract: '{left} eksi {right}' '{left} - {right}'
    multiply: '{left} çarpı {right}' '{left} * {right}'
    divide: '{left} bölü {right}' '{left} / {right}'
    remainder: '{left} mod {right}' '{left} % {right}'
    array: 'liste ({elements})'
    new-array: 'uzunluğu {length} olan {fill} listesi'
    element: '{array} listesinin {index} öğesi'
    length: '{array} uzunluğu'
    set-element: '{name} listesinin {index} öğesini {value} yap'
  words:
    ackermann: 'ackermann'
    bottles: 'şişeler'
    common: 'ortak'
    count: 'sayaç'
    current: 'mevcut'
    digits: 'basamaklar'
    disks: 'diskler'
    divisor: 'bölen'
    factorial: 'faktöriyel'
    female: 'dişi'
    fibonacci: 'fibonacci'
    first: 'birinci'
    greatest: 'azami'
    hailstone: 'dolu'
    index: 'indeks'
    is: 'mi'
    leap: 'artık'
    limit: 'sınır'
    male: 'erkek'
    move: 'taşı'
    multiple: 'kat'
    next: 'sonraki'
    number: 'sayı'
    numbers: 'sayılar'
    of: 'nin'
    pass: 'tur'
    perfect: 'mükemmel'
    position: 'konum'
    previous: 'önceki'
    prime: 'asal'
    product: 'çarpım'
    remainder: 'kalan'
    second: 'ikinci'
    source: 'kaynak'
    spare: 'yedek'
    squares: 'kareler'
