natural:
  id: 'bengali'
  label: 'Bengali'
  native-label: 'বাংলা'
  family: 'Indo-European'
  speakers: '270 million'
  sentence-end: '।'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'ও'
  true: 'সত্য'
  false: 'মিথ্যা'
  note: 'টীকা: {text}'
  templates:
    function: '{name} কে {parameters} দিয়ে সংজ্ঞায়িত করো'
    function-without-parameters: '{name} কে সংজ্ঞায়িত করো'
    declare: '{name} তৈরি করো মান {value} দিয়ে'
    assign: '{name} কে {value} তে বদলাও'
    increase: '{name} কে {value} বাড়াও'
    decrease: '{name} কে {value} কমাও'
    print-line: '{value} লেখো এবং লাইন শেষ করো'
    print: '{value} লেখো'
    return-value: '{value} ফেরত দাও'
    return: 'এখানে থামো'
    nothing: 'কিছুই কোরো না'
    evaluate: '{expression} চালাও'
    if: 'যদি {condition} হয় তবে এটি করো'
    else-if: 'নইলে যদি {condition} হয় তবে এটি করো'
    else: 'নইলে এটি করো'
    while: 'যতক্ষণ {condition} ততক্ষণ এটি পুনরাবৃত্তি করো'
    for: 'প্রতিটি {variable} এর জন্য {start} থেকে {last} পর্যন্ত এটি পুনরাবৃত্তি করো'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} এর পরে {right}'
    or: '{left} অথবা {right}'
    and: '{left} এবং {right}'
    not: 'না {operand}'
    negate: 'ঋণাত্মক {operand}'
    equal: '{left} এর মান {right} এর সমান' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} এর মান {right} এর সমান নয়' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} এর মান {right} এর চেয়ে কম' '{left} < {right}'
    less-or-equal: '{left} এর মান {right} এর চেয়ে বেশি নয়' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} এর মান {right} এর চেয়ে বেশি' '{left} > {right}'
    greater-or-equal: '{left} এর মান {right} এর চেয়ে কম নয়' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} যোগ {right}' '{left} + {right}'
    subtract: '{left} বিয়োগ {right}' '{left} - {right}'
    multiply: '{left} গুণ {right}' '{left} * {right}'
    divide: '{left} ভাগ {right}' '{left} / {right}'
    remainder: '{left} মডুলো {right}' '{left} % {right}'
    array: 'তালিকা ({elements})'
    new-array: 'তালিকা দৈর্ঘ্য {length} প্রতিটি উপাদান {fill}'
    element: '{array} মধ্যে উপাদান {index}'
    length: '{array} তালিকার দৈর্ঘ্য'
    set-element: '{name} মধ্যে উপাদান {index} কে {value} তে বদলাও'
  words:
    ackermann: 'আকারম্যান'
    bottles: 'বোতল'
    common: 'সাধারণ'
    count: 'গণনা'
    current: 'বর্তমান'
    digits: 'অঙ্ক'
    disks: 'চাকতি'
    divisor: 'ভাজক'
    factorial: 'ফ্যাক্টোরিয়াল'
    female: 'নারী'
    fibonacci: 'ফিবোনাচি'
    first: 'প্রথম'
    greatest: 'বৃহত্তম'
    hailstone: 'শিলা'
    index: 'সূচক'
    is: 'কি'
    leap: 'অধি'
    limit: 'সীমা'
    male: 'পুরুষ'
    move: 'সরাও'
    multiple: 'গুণিতক'
    next: 'পরবর্তী'
    number: 'সংখ্যা'
    numbers: 'সংখ্যাগুলি'
    of: 'এর'
    pass: 'পর্ব'
    perfect: 'নিখুঁত'
    position: 'অবস্থান'
    previous: 'পূর্ববর্তী'
    prime: 'মৌলিক'
    product: 'গুণফল'
    remainder: 'ভাগশেষ'
    second: 'দ্বিতীয়'
    source: 'উৎস'
    spare: 'অতিরিক্ত'
    squares: 'বর্গ'
    step: 'ধাপ'
    steps: 'ধাপগুলি'
    sum: 'যোগফল'
    swap: 'অদলবদল'
    target: 'লক্ষ্য'
    total: 'মোট'
    year: 'বছর'
