natural:
  id: 'bengali'
  label: 'Bengali'
  native-label: 'বাংলা'
  family: 'Indo-European'
  speakers: '270 million'
  sentence-end: '।'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'ও'
  true: 'সত্য'
  false: 'মিথ্যা'
  note: 'টীকা: {text}'
  templates:
    function: '{name} কে {parameters} দিয়ে সংজ্ঞায়িত করো'
    function-without-parameters: '{name} কে সংজ্ঞায়িত করো'
    declare: '{name} তৈরি করো মান {value} দিয়ে'
    assign: '{name} কে {value} তে বদলাও'
    print-line: '{value} লেখো এবং লাইন শেষ করো'
    print: '{value} লেখো'
    return-value: '{value} ফেরত দাও'
    return: 'এখানে থামো'
    nothing: 'কিছুই কোরো না'
    evaluate: '{expression} চালাও'
    if: 'যদি {condition} হয় তবে এটি করো'
    else-if: 'নইলে যদি {condition} হয় তবে এটি করো'
    else: 'নইলে এটি করো'
    while: 'যতক্ষণ {condition} ততক্ষণ এটি পুনরাবৃত্তি করো'
    for: 'প্রতিটি {variable} এর জন্য {start} থেকে {last} পর্যন্ত এটি পুনরাবৃত্তি করো'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} এর পরে {right}'
    or: '{left} অথবা {right}'
    and: '{left} এবং {right}'
    not: 'না {operand}'
    negate: 'ঋণাত্মক {operand}'
    equal: '{left} এর মান {right} এর সমান'
    not-equal: '{left} এর মান {right} এর সমান নয়'
    less: '{left} এর মান {right} এর চেয়ে কম'
    less-or-equal: '{left} এর মান {right} এর চেয়ে বেশি নয়'
    greater: '{left} এর মান {right} এর চেয়ে বেশি'
    greater-or-equal: '{left} এর মান {right} এর চেয়ে কম নয়'
    add: '{left} যোগ {right}'
    subtract: '{left} বিয়োগ {right}'
    multiply: '{left} গুণ {right}'
    divide: '{left} ভাগ {right}'
    remainder: '{left} মডুলো {right}'
  words:
    ackermann: 'আকারম্যান'
    bottles: 'বোতল'
    common: 'সাধারণ'
    count: 'গণনা'
    current: 'বর্তমান'
    digits: 'অঙ্ক'
    disks: 'চাকতি'
    divisor: 'ভাজক'
    factorial: 'ফ্যাক্টোরিয়াল'
    fibonacci: 'ফিবোনাচি'
    first: 'প্রথম'
    greatest: 'বৃহত্তম'
    hailstone: 'শিলা'
    index: 'সূচক'
    is: 'কি'
    leap: 'অধি'
    limit: 'সীমা'
    move: 'সরাও'
    next: 'পরবর্তী'
    number: 'সংখ্যা'
    of: 'এর'
    previous: 'পূর্ববর্তী'
    prime: 'মৌলিক'
    remainder: 'ভাগশেষ'
    second: 'দ্বিতীয়'
    source: 'উৎস'
    spare: 'অতিরিক্ত'
    squares: 'বর্গ'
    step: 'ধাপ'
    steps: 'ধাপগুলি'
    sum: 'যোগফল'
    target: 'লক্ষ্য'
    total: 'মোট'
    year: 'বছর'
