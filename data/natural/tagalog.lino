    less-or-equal: '{left} ay hindi hihigit sa {right}'
    greater: '{left} ay mas mataas sa {right}'
    greater-or-equal: '{left} ay hindi bababa sa {right}'
    add: '{left} dagdag {right}'
    subtract: '{left} bawas {right}'
    multiply: '{left} beses {right}'
    divide: '{left} hinati sa {right}'
    remainder: '{left} modulo {right}'
