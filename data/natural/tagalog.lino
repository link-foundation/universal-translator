  quotes: '“' '”'
  list-separator: ','
  list-and: 'at'
  true: 'totoo'
  false: 'mali'
  note: 'Tala: {text}'
  grammar:
    terms:
      interrogative: 'Ano ang'
      query-scope: 'para sa bawat {variable} sa {source}'
      query-deferred: '“ipinagpaliban”'
    productions:
      answer-type: 'uri ng {subject}'
      question-type: '@interrogative @answer-type'
      answer-documentation: 'dokumentasyon ng {subject}'
      question-documentation: '@interrogative @answer-documentation'
      answer-source: 'source code ng {subject}'
      question-source: '@interrogative @answer-source'
      answer-details: 'detalyadong impormasyon tungkol sa {subject}'
      question-details: '@interrogative @answer-details'
      answer-query: 'mga halaga ng {projection} @query-scope kung {condition}'
      question-query: 'Anong @answer-query'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
      element: 'elemento {index} sa {array}'
      set-element: 'Palitan ang @element[array=name] ng {value}'
  templates:
    documentation: 'Ang dokumentasyon ay {value}'
    function: 'Tukuyin ang {name} gamit ang {parameters}'
    function-without-parameters: 'Tukuyin ang {name}'
    declare: 'Lumikha ng {name} na may halagang {value}'
    assign: 'Palitan ang {name} ng {value}'
    increase: 'Dagdagan ang {name} ng {value}'
    decrease: 'Bawasan ang {name} ng {value}'
    print-line: 'Isulat ang {value} at tapusin ang linya'
    print: 'Isulat ang {value}'
    return-value: 'Ibalik ang {value}'
    return: 'Huminto dito'
    nothing: 'Walang gawin'
    evaluate: 'Patakbuhin ang {expression}'
    if: 'Kung {condition}, gawin ito'
    else-if: 'Kung hindi, kung {condition}, gawin ito'
    else: 'Kung hindi, gawin ito'
    while: 'Habang {condition}, ulitin ito'
    for: 'Para sa bawat {variable} mula {start} hanggang {last}, ulitin ito'
    call: '{callee} ng ({arguments})'
    call-without-arguments: '{callee} na walang argumento'
    join: '{left} na sinusundan ng {right}'
    or: '{left} o {right}'
    and: '{left} at {right}'
    not: 'hindi {operand}'
    negate: 'negatibo ng {operand}'
    equal: '{left} ay katumbas ng {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} ay hindi katumbas ng {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} ay mas mababa sa {right}' '{left} < {right}'
    less-or-equal: '{left} ay hindi hihigit sa {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} ay mas mataas sa {right}' '{left} > {right}'
    greater-or-equal: '{left} ay hindi bababa sa {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} dagdag {right}' '{left} + {right}'
    subtract: '{left} bawas {right}' '{left} - {right}'
    multiply: '{left} beses {right}' '{left} * {right}'
    divide: '{left} hinati sa {right}' '{left} / {right}'
    remainder: '{left} modulo {right}' '{left} % {right}'
    array: 'listahan ({elements})'
    new-array: 'listahang may habang {length} na puno ng {fill}'
    length: 'haba ng {array}'
