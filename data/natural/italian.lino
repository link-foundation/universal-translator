  native-label: 'Italiano'
  family: 'Indo-European'
  speakers: '65 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '«' '»'
  list-separator: ','
  list-and: 'e'
  true: 'vero'
  false: 'falso'
  note: 'Nota: {text}'
  grammar:
    terms:
      interrogative: 'Qual è'
