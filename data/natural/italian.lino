      question-type: '@interrogative @answer-type'
      answer-documentation: 'la documentazione di {subject}'
      question-documentation: '@interrogative @answer-documentation'
      answer-source: 'il codice sorgente di {subject}'
      question-source: '@interrogative @answer-source'
      answer-details: 'le informazioni dettagliate su {subject}'
      question-details: '@interrogative @answer-details'
  templates:
    answer-query: 'i valori di {projection} per ogni {variable} in {source} dove {condition}'
    question-query: 'Quali valori di {projection} per ogni {variable} in {source} soddisfano {condition}'
    answer-deferred-query: '«differito» i valori di {projection} per ogni {variable} in {source} dove {condition}'
    question-deferred-query: '«differito» Quali valori di {projection} per ogni {variable} in {source} soddisfano {condition}'
    documentation: 'La documentazione è {value}'
    function: 'Definisci {name} usando {parameters}'
    function-without-parameters: 'Definisci {name}'
    declare: 'Crea {name} con valore {value}' 'Sia {name} uguale a {value}'
    assign: 'Cambia {name} in {value}' 'Imposta {name} a {value}'
    increase: 'Aumenta {name} di {value}' 'Aggiungi {value} a {name}'
    decrease: 'Diminuisci {name} di {value}' 'Sottrai {value} da {name}'
    print-line: 'Scrivi {value} e termina la riga' 'Stampa {value}' 'Mostra {value}'
    print: 'Scrivi {value}'
    return-value: 'Restituisci {value}'
    return: 'Fermati qui'
    nothing: 'Non fare niente'
    evaluate: 'Esegui {expression}'
    if: 'Se {condition}, fai questo' 'Se {condition}, allora'
    else-if: 'Altrimenti, se {condition}, fai questo'
    else: 'Altrimenti, fai questo'
    while: 'Finché {condition}, ripeti questo'
    for: 'Per ogni {variable} da {start} a {last}, ripeti questo'
    call: '{callee} di ({arguments})'
    call-without-arguments: '{callee} senza argomenti'
    join: '{left} seguito da {right}'
    or: '{left} o {right}'
    and: '{left} e {right}'
    not: 'non {operand}'
    negate: "l'opposto di {operand}"
    equal: '{left} è uguale a {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} è diverso da {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} è minore di {right}' '{left} < {right}'
    less-or-equal: '{left} è al massimo {right}' '{left} è minore o uguale a {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} è maggiore di {right}' '{left} > {right}'
    greater-or-equal: '{left} è almeno {right}' '{left} è maggiore o uguale a {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} più {right}' '{left} + {right}'
    subtract: '{left} meno {right}' '{left} - {right}'
    multiply: '{left} per {right}' '{left} * {right}'
    divide: '{left} diviso {right}' '{left} / {right}'
    remainder: '{left} modulo {right}' '{left} % {right}'
    array: 'la lista ({elements})'
    new-array: 'una lista di {length} copie di {fill}'
    element: "l'elemento {index} di {array}"
    length: 'la lunghezza di {array}'
    set-element: "Cambia l'elemento {index} di {name} in {value}"
