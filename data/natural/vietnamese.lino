natural:
  id: 'vietnamese'
  label: 'Vietnamese'
  native-label: 'Tiếng Việt'
  family: 'Austroasiatic'
  speakers: '85 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'và'
  true: 'đúng'
  false: 'sai'
  note: 'Ghi chú: {text}'
  grammar:
    terms:
      interrogative: 'là gì'
    productions:
      answer-type: 'kiểu của {subject}'
      question-type: '@answer-type @interrogative'
      answer-documentation: 'tài liệu của {subject}'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: 'mã nguồn của {subject}'
      question-source: '@answer-source @interrogative'
      answer-details: 'thông tin chi tiết về {subject}'
      question-details: '@answer-details @interrogative'
  templates:
    answer-query: 'các giá trị của {projection} cho mỗi {variable} trong {source} khi {condition}'
    question-query: 'Các giá trị nào của {projection} cho mỗi {variable} trong {source} thỏa mãn {condition}'
    answer-deferred-query: '“trì hoãn” các giá trị của {projection} cho mỗi {variable} trong {source} khi {condition}'
    question-deferred-query: '“trì hoãn” Các giá trị nào của {projection} cho mỗi {variable} trong {source} thỏa mãn {condition}'
    documentation: 'Tài liệu là {value}'
    function: 'Định nghĩa {name} với {parameters}'
    function-without-parameters: 'Định nghĩa {name}'
    declare: 'Tạo {name} với giá trị {value}'
    assign: 'Đổi {name} thành {value}'
    increase: 'Tăng {name} thêm {value}'
    decrease: 'Giảm {name} đi {value}'
    print-line: 'Viết {value} và xuống dòng'
    print: 'Viết {value}'
    return-value: 'Trả về {value}'
    return: 'Dừng ở đây'
    nothing: 'Không làm gì'
    evaluate: 'Thực hiện {expression}'
    if: 'Nếu {condition}, làm điều này'
    else-if: 'Ngược lại, nếu {condition}, làm điều này'
    else: 'Ngược lại, làm điều này'
    while: 'Trong khi {condition}, lặp lại điều này'
    for: 'Với mỗi {variable} từ {start} đến {last}, lặp lại điều này'
    call: '{callee} của ({arguments})'
    call-without-arguments: '{callee} không đối số'
    join: '{left} nối với {right}'
    or: '{left} hoặc {right}'
    and: '{left} và {right}'
    not: 'không {operand}'
    negate: 'âm {operand}'
    equal: '{left} bằng {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} khác {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} nhỏ hơn {right}' '{left} < {right}'
    less-or-equal: '{left} không lớn hơn {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} lớn hơn {right}' '{left} > {right}'
    greater-or-equal: '{left} không nhỏ hơn {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} cộng {right}' '{left} + {right}'
    subtract: '{left} trừ {right}' '{left} - {right}'
    multiply: '{left} nhân {right}' '{left} * {right}'
    divide: '{left} chia {right}' '{left} / {right}'
    remainder: '{left} chia lấy dư {right}' '{left} % {right}'
    array: 'danh sách ({elements})'
    new-array: 'danh sách dài {length} toàn {fill}'
    element: 'phần tử {index} trong {array}'
    length: 'độ dài {array}'
    set-element: 'Đổi phần tử {index} trong {name} thành {value}'
