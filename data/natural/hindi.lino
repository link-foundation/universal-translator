  quotes: '“' '”'
  list-separator: ','
  list-and: 'और'
  true: 'सत्य'
  false: 'असत्य'
  note: 'टिप्पणी: {text}'
  templates:
    function: '{name} को {parameters} से परिभाषित करें'
    function-without-parameters: '{name} को परिभाषित करें'
    declare: '{name} को मान {value} के साथ बनाएँ'
    assign: '{name} को {value} में बदलें'
    print-line: '{value} लिखें और पंक्ति समाप्त करें'
    print: '{value} लिखें'
    return-value: '{value} लौटाएँ'
    return: 'यहीं रुकें'
    nothing: 'कुछ न करें'
    evaluate: '{expression} चलाएँ'
    if: 'यदि {condition} तो यह करें'
    else-if: 'अन्यथा यदि {condition} तो यह करें'
    else: 'अन्यथा यह करें'
    while: 'जब तक {condition} तब तक यह दोहराएँ'
    for: 'हर {variable} के लिए {start} से {last} तक यह दोहराएँ'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} के बाद {right}'
    or: '{left} या {right}'
    and: '{left} और {right}'
    not: 'नहीं {operand}'
    negate: 'ऋण {operand}'
    equal: '{left} का मान {right} के बराबर है'
    not-equal: '{left} का मान {right} के बराबर नहीं है'
    less: '{left} का मान {right} से कम है'
    less-or-equal: '{left} का मान {right} से अधिक नहीं है'
    greater: '{left} का मान {right} से अधिक है'
    greater-or-equal: '{left} का मान {right} से कम नहीं है'
    add: '{left} जमा {right}'
    subtract: '{left} घटा {right}'
    multiply: '{left} गुणा {right}'
    divide: '{left} भाग {right}'
    remainder: '{left} मॉड्यूलो {right}'
