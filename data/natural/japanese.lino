natural:
  id: 'japanese'
  label: 'Japanese'
  native-label: '日本語'
  family: 'Japonic'
  speakers: '125 million'
  sentence-end: '。'
  block-end: '：'
  quotes: '「' '」'
  list-separator: '、'
  list-and: 'と'
  true: '真'
  false: '偽'
  note: '注：{text}'
  grammar:
    terms:
      interrogative: 'は何ですか'
      query-scope: '{source} 内の各 {variable} について'
      query-deferred: '「遅延」'
    productions:
      answer-type: '{subject} の型'
      question-type: '@answer-type @interrogative'
      answer-documentation: '{subject} の文書'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: '{subject} のソースコード'
      question-source: '@answer-source @interrogative'
      answer-details: '{subject} の詳細情報'
      question-details: '@answer-details @interrogative'
      answer-query: '@query-scope {condition} を満たす {projection} の値'
      question-query: '@answer-queryは何か'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
  templates:
    documentation: '文書は {value}'
    function: '{name} を {parameters} で 定義 する'
    function-without-parameters: '{name} を 定義 する'
    declare: '{name} を 値 {value} で 作る'
    assign: '{name} を {value} に 変える'
    increase: '{name} を {value} 増やす'
    decrease: '{name} を {value} 減らす'
    print-line: '{value} を 書いて 改行 する'
    print: '{value} を 書く'
    return-value: '{value} を 返す'
    return: 'ここで 止める'
    nothing: '何も しない'
    evaluate: '{expression} を 実行 する'
    if: 'もし {condition} なら 次 を する'
    else-if: 'そうでなく もし {condition} なら 次 を する'
    else: 'そうでなければ 次 を する'
    while: '{condition} の 間 次 を 繰り返す'
    for: '{variable} を {start} から {last} まで 数えて 次 を 繰り返す'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} に 続けて {right}'
    or: '{left} または {right}'
    and: '{left} かつ {right}'
    not: '{operand} で ない'
    negate: 'マイナス {operand}'
    equal: '{left} が {right} に 等しい' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} が {right} に 等しく ない' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} が {right} より 小さい' '{left} < {right}'
    less-or-equal: '{left} が {right} 以下' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} が {right} より 大きい' '{left} > {right}'
    greater-or-equal: '{left} が {right} 以上' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} 足す {right}' '{left} + {right}'
    subtract: '{left} 引く {right}' '{left} - {right}'
    multiply: '{left} 掛ける {right}' '{left} * {right}'
    divide: '{left} 割る {right}' '{left} / {right}'
    remainder: '{left} 剰余 {right}' '{left} % {right}'
    array: 'リスト ({elements})'
    new-array: '長さ {length} で 全て {fill} の リスト'
    element: '{array} の 要素 {index}'
    length: '{array} の 長さ'
    set-element: '{name} の 要素 {index} を {value} に 変える'
  words:
    ackermann: 'アッカーマン'
    bottles: '瓶'
    common: '共通'
    count: '個数'
    current: '現在'
    digits: '桁'
    disks: '円盤'
    divisor: '約数'
    factorial: '階乗'
    female: '女性'
    fibonacci: 'フィボナッチ'
    first: '第一'
    greatest: '最大'
    hailstone: '雹'
    index: '添字'
    is: '判定'
    leap: '閏'
    limit: '上限'
    male: '男性'
    move: '移動'
    multiple: '倍数'
    next: '次'
    number: '数'
    numbers: '数列'
    of: 'の'
    pass: '巡'
    perfect: '完全'
    position: '位置'
    previous: '前'
    prime: '素数'
    product: '積'
    remainder: '余り'
    second: '第二'
    source: '元'
    spare: '予備'
    squares: '平方'
    step: '段'
    steps: '段数'
    sum: '和'
