    print: '{value} を 書く'
    return-value: '{value} を 返す'
    return: 'ここで 止める'
    nothing: '何も しない'
    evaluate: '{expression} を 実行 する'
    if: 'もし {condition} なら 次 を する'
    else-if: 'そうでなく もし {condition} なら 次 を する'
    else: 'そうでなければ 次 を する'
    while: '{condition} の 間 次 を 繰り返す'
    for: '{variable} を {start} から {last} まで 数えて 次 を 繰り返す'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} に 続けて {right}'
    or: '{left} または {right}'
    and: '{left} かつ {right}'
    not: '{operand} で ない'
    negate: 'マイナス {operand}'
    equal: '{left} が {right} に 等しい'
    not-equal: '{left} が {right} に 等しく ない'
    less: '{left} が {right} より 小さい'
    less-or-equal: '{left} が {right} 以下'
    greater: '{left} が {right} より 大きい'
    greater-or-equal: '{left} が {right} 以上'
    add: '{left} 足す {right}'
    subtract: '{left} 引く {right}'
    multiply: '{left} 掛ける {right}'
    divide: '{left} 割る {right}'
    remainder: '{left} 剰余 {right}'
