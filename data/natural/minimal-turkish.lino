natural:
  id: minimal-turkish
  label: 'Minimal Turkish (NSM semantic primes)'
  extends: turkish
  profile: minimal-english
  source: 'https://en.wikipedia.org/wiki/Natural_semantic_metalanguage'
  templates:
    function: 'Biri {name} şeyini {parameters} ile şöyle yapar'
    function-without-parameters: 'Biri {name} şeyini şöyle yapar'
    declare: '{name} var, bu {value}'
    assign: 'Bundan sonra {name} şimdi {value} olur'
    print-line: '{value} bir satırda söyle'
    print: '{value} söyle'
    return-value: 'Cevap {value}'
    return: 'Burada dur'
    nothing: 'Hiçbir şey yapma'
    evaluate: '{expression} yap'
    if: 'Eğer {condition} ise bunu yap'
    else-if: 'Değilse eğer {condition} ise bunu yap'
    else: 'Değilse bunu yap'
    while: '{condition} olduğu zaman bunu çok kez yap'
    for: 'Her {variable} için {start} ile {last} arasında bunu yap'
    join: '{left} sonra {right}'
    equal: '{left} ile {right} aynı'
    not-equal: '{left} ile {right} aynı değil'
    less: '{left} {right} değerinden daha az'
    less-or-equal: '{left} en çok {right}'
    greater: '{left} {right} değerinden daha çok'
    greater-or-equal: '{left} en az {right}'
    not: '{operand} doğru değil'
    array: 'şu şeyler ({elements})'
    new-array: '{fill} gibi {length} şey'
    element: '{array} şeyinin {index} parçası'
    length: '{array} şeyinin kaç parçası var'
    set-element: 'Bundan sonra {name} şeyinin {index} parçası şimdi {value} olur'
  rules:
    primes: turkish
    extra-words: ile satırda cevap dur hiçbir yapma kez için arasında değerinden en kaç veya ve negatif artı eksi çarpı bölü mod yanlış
