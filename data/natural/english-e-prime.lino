natural:
  id: english-e-prime
  label: 'English (E-Prime)'
  extends: english
  profile: e-prime
  source: 'https://en.wikipedia.org/wiki/E-Prime'
  templates:
    equal: '{left} equals {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} does not equal {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} falls below {right}' '{left} < {right}'
    less-or-equal: '{left} does not exceed {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} exceeds {right}' '{left} > {right}'
    greater-or-equal: '{left} does not fall below {right}' '{left} >= {right}' '{left} ≥ {right}'
  words:
    is: check
  rules:
    forbidden-words: be is am are was were been being isn't aren't wasn't weren't i'm you're he's she's it's we're they're
