natural:
  id: minimal-punjabi
  label: 'Minimal Punjabi (NSM semantic primes)'
  extends: punjabi
  profile: minimal-english
  source: 'https://en.wikipedia.org/wiki/Natural_semantic_metalanguage'
  grammar:
    productions:
      element: '{array} ਵਿੱਚ ਹਿੱਸਾ {index}'
      set-element: 'ਇਸ ਤੋਂ ਬਾਅਦ @element[array=name] {value} ਹੈ'
  templates:
    function: 'ਕੋਈ {name} ਨੂੰ {parameters} ਨਾਲ ਇਸ ਤਰ੍ਹਾਂ ਕਰਦਾ ਹੈ'
    function-without-parameters: 'ਕੋਈ {name} ਨੂੰ ਇਸ ਤਰ੍ਹਾਂ ਕਰਦਾ ਹੈ'
    declare: '{name} ਹੈ, ਉਹ {value} ਹੈ'
    assign: 'ਇਸ ਤੋਂ ਬਾਅਦ {name} {value} ਹੈ'
    print-line: '{value} ਇੱਕ ਸਤਰ ਵਿੱਚ ਕਹੋ'
    print: '{value} ਕਹੋ'
    return-value: 'ਜਵਾਬ {value} ਹੈ'
    evaluate: '{expression} ਕਰੋ'
    while: 'ਜਦੋਂ {condition} ਤਦ ਇਹ ਕਈ ਵਾਰ ਕਰੋ'
    for: 'ਹਰ {variable} ਲਈ {start} ਤੋਂ {last} ਤੱਕ ਇਹ ਕਰੋ'
    equal: '{left} {right} ਵਰਗਾ ਹੀ ਹੈ'
    not-equal: '{left} {right} ਵਰਗਾ ਨਹੀਂ ਹੈ'
    less: '{left} {right} ਤੋਂ ਘੱਟ ਹੈ'
    less-or-equal: '{left} {right} ਤੋਂ ਵੱਧ ਨਹੀਂ ਹੈ'
    greater: '{left} {right} ਤੋਂ ਵੱਧ ਹੈ'
    greater-or-equal: '{left} {right} ਤੋਂ ਘੱਟ ਨਹੀਂ ਹੈ'
    array: 'ਇਹ ਚੀਜ਼ਾਂ ({elements})'
    new-array: '{fill} ਵਰਗੀਆਂ {length} ਚੀਜ਼ਾਂ'
    length: '{array} ਵਿੱਚ ਕਿੰਨੇ ਹਿੱਸੇ'
  rules:
    primes: punjabi
    extra-words: ਨੂੰ ਨਾਲ ਤੋਂ ਤੱਕ ਵਿੱਚ ਲਈ ਸਤਰ ਜਵਾਬ ਰੁਕੋ ਤਾਂ ਵਰਨਾ ਵਾਰ ਕਿੰਨੇ ਜਾਂ ਅਤੇ ਰਿਣ ਜਮ੍ਹਾਂ ਘਟਾਓ ਗੁਣਾ ਭਾਗ ਮੋਡਿਊਲੋ ਝੂਠ
