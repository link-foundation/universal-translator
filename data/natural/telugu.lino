natural:
  id: 'telugu'
  label: 'Telugu'
  native-label: 'తెలుగు'
  family: 'Dravidian'
  speakers: '95 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'మరియు'
  true: 'నిజం'
  false: 'అబద్ధం'
  note: 'గమనిక: {text}'
  templates:
    function: '{name} ను {parameters} తో నిర్వచించు'
    function-without-parameters: '{name} ను నిర్వచించు'
    declare: '{name} ను విలువ {value} తో సృష్టించు'
    assign: '{name} ను {value} గా మార్చు'
    print-line: '{value} రాసి పంక్తి ముగించు'
    print: '{value} రాయి'
    return-value: '{value} తిరిగి ఇవ్వు'
    return: 'ఇక్కడ ఆగు'
    nothing: 'ఏమీ చేయవద్దు'
    evaluate: '{expression} అమలు చేయి'
    if: 'ఒకవేళ {condition} అయితే ఇది చేయి'
    else-if: 'లేకపోతే ఒకవేళ {condition} అయితే ఇది చేయి'
    else: 'లేకపోతే ఇది చేయి'
    while: '{condition} ఉన్నంత వరకు ఇది పునరావృతం చేయి'
    for: 'ప్రతి {variable} కి {start} నుండి {last} వరకు ఇది పునరావృతం చేయి'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} తర్వాత {right}'
    or: '{left} లేదా {right}'
    and: '{left} మరియు {right}'
    not: 'కాదు {operand}'
    negate: 'రుణ {operand}'
    equal: '{left} విలువ {right} కి సమానం'
    not-equal: '{left} విలువ {right} కి సమానం కాదు'
    less: '{left} విలువ {right} కంటే తక్కువ'
    less-or-equal: '{left} విలువ {right} కంటే ఎక్కువ కాదు'
    greater: '{left} విలువ {right} కంటే ఎక్కువ'
    greater-or-equal: '{left} విలువ {right} కంటే తక్కువ కాదు'
    add: '{left} కూడిక {right}'
    subtract: '{left} తీసివేత {right}'
    multiply: '{left} గుణకారం {right}'
    divide: '{left} భాగహారం {right}'
    remainder: '{left} మాడ్యులో {right}'
  words:
    ackermann: 'అకెర్మాన్'
