natural:
  id: 'telugu'
  label: 'Telugu'
  native-label: 'తెలుగు'
  family: 'Dravidian'
  speakers: '95 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'మరియు'
  true: 'నిజం'
  false: 'అబద్ధం'
  note: 'గమనిక: {text}'
  grammar:
    terms:
      interrogative: 'ఏమిటి'
      query-scope: '{source} లో ప్రతి {variable} కోసం'
      query-deferred: '“వాయిదా”'
    productions:
      answer-type: '{subject} యొక్క రకం'
      question-type: '@answer-type @interrogative'
      answer-documentation: '{subject} యొక్క వివరణ'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: '{subject} యొక్క మూల కోడ్'
      question-source: '@answer-source @interrogative'
      answer-details: '{subject} యొక్క వివరణాత్మక సమాచారం'
      question-details: '@answer-details @interrogative'
      answer-query: '@query-scope {condition} అయితే {projection} యొక్క విలువలు'
      question-query: '@answer-query ఏమిటి'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
  templates:
    documentation: 'వివరణ {value}'
    function: '{name} ను {parameters} తో నిర్వచించు'
    function-without-parameters: '{name} ను నిర్వచించు'
    declare: '{name} ను విలువ {value} తో సృష్టించు'
    assign: '{name} ను {value} గా మార్చు'
    increase: '{name} ను {value} పెంచు'
    decrease: '{name} ను {value} తగ్గించు'
    print-line: '{value} రాసి పంక్తి ముగించు'
    print: '{value} రాయి'
    return-value: '{value} తిరిగి ఇవ్వు'
    return: 'ఇక్కడ ఆగు'
    nothing: 'ఏమీ చేయవద్దు'
    evaluate: '{expression} అమలు చేయి'
    if: 'ఒకవేళ {condition} అయితే ఇది చేయి'
    else-if: 'లేకపోతే ఒకవేళ {condition} అయితే ఇది చేయి'
    else: 'లేకపోతే ఇది చేయి'
    while: '{condition} ఉన్నంత వరకు ఇది పునరావృతం చేయి'
    for: 'ప్రతి {variable} కి {start} నుండి {last} వరకు ఇది పునరావృతం చేయి'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} తర్వాత {right}'
    or: '{left} లేదా {right}'
    and: '{left} మరియు {right}'
    not: 'కాదు {operand}'
    negate: 'రుణ {operand}'
    equal: '{left} విలువ {right} కి సమానం' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} విలువ {right} కి సమానం కాదు' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} విలువ {right} కంటే తక్కువ' '{left} < {right}'
    less-or-equal: '{left} విలువ {right} కంటే ఎక్కువ కాదు' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} విలువ {right} కంటే ఎక్కువ' '{left} > {right}'
    greater-or-equal: '{left} విలువ {right} కంటే తక్కువ కాదు' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} కూడిక {right}' '{left} + {right}'
    subtract: '{left} తీసివేత {right}' '{left} - {right}'
    multiply: '{left} గుణకారం {right}' '{left} * {right}'
    divide: '{left} భాగహారం {right}' '{left} / {right}'
    remainder: '{left} మాడ్యులో {right}' '{left} % {right}'
    array: 'జాబితా ({elements})'
    new-array: 'జాబితా పొడవు {length} ప్రతి అంశం {fill}'
    element: '{array} లో అంశం {index}'
    length: '{array} పొడవు'
    set-element: '{name} లో అంశం {index} ను {value} గా మార్చు'
  words:
    ackermann: 'అకెర్మాన్'
    bottles: 'సీసాలు'
    common: 'ఉమ్మడి'
    count: 'లెక్క'
    current: 'ప్రస్తుత'
    digits: 'అంకెలు'
    disks: 'పళ్ళాలు'
    divisor: 'భాజకం'
    factorial: 'క్రమగుణితం'
    female: 'స్త్రీ'
    fibonacci: 'ఫిబొనాక్సీ'
    first: 'మొదటి'
    greatest: 'గరిష్ఠ'
    hailstone: 'వడగళ్ళు'
    index: 'సూచిక'
    is: 'అవునా'
    leap: 'లీపు'
    limit: 'పరిమితి'
    male: 'పురుష'
    move: 'కదుపు'
    multiple: 'గుణిజం'
    next: 'తదుపరి'
    number: 'సంఖ్య'
    numbers: 'సంఖ్యలు'
    of: 'యొక్క'
    pass: 'విడత'
    perfect: 'పరిపూర్ణ'
    position: 'స్థానం'
    previous: 'మునుపటి'
    prime: 'ప్రధాన'
    product: 'లబ్ధం'
    remainder: 'శేషం'
    second: 'రెండవ'
    source: 'మూలం'
    spare: 'అదనపు'
    squares: 'వర్గాలు'
    step: 'అడుగు'
    steps: 'అడుగులు'
    sum: 'మొత్తం'
    swap: 'మార్పిడి'
    target: 'లక్ష్యం'
    total: 'సమస్తం'
    year: 'సంవత్సరం'
