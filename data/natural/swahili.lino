natural:
  id: 'swahili'
  label: 'Swahili'
  native-label: 'Kiswahili'
  family: 'Niger-Congo'
  speakers: '80 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: 'na'
  true: 'kweli'
  false: 'uongo'
  note: 'Kumbuka: {text}'
  grammar:
    terms:
      interrogative: 'ni nini'
      query-scope: 'kwa kila {variable} katika {source}'
      query-deferred: '“iliyoahirishwa”'
    productions:
      answer-type: 'aina ya {subject}'
      question-type: '@answer-type @interrogative'
      answer-documentation: 'maelezo ya {subject}'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: 'msimbo chanzo wa {subject}'
      question-source: '@answer-source @interrogative'
      answer-details: 'taarifa za kina kuhusu {subject}'
      question-details: '@answer-details @interrogative'
      answer-query: 'thamani za {projection} @query-scope ikiwa {condition}'
      question-query: 'Ni thamani zipi za {projection} @query-scope ikiwa {condition}'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
      element: 'kipengele {index} cha {array}'
      set-element: 'Badilisha @element[array=name] kuwa {value}'
  templates:
    documentation: 'Maelezo ni {value}'
    function: 'Fafanua {name} kwa {parameters}'
    function-without-parameters: 'Fafanua {name}'
    declare: 'Unda {name} yenye thamani {value}'
    assign: 'Badilisha {name} kuwa {value}'
    increase: 'Ongeza {name} kwa {value}'
    decrease: 'Punguza {name} kwa {value}'
    print-line: 'Andika {value} na umalize mstari'
    print: 'Andika {value}'
    return-value: 'Rudisha {value}'
    return: 'Simama hapa'
    nothing: 'Usifanye chochote'
    evaluate: 'Endesha {expression}'
    if: 'Ikiwa {condition}, fanya hivi'
    else-if: 'Vinginevyo, ikiwa {condition}, fanya hivi'
    else: 'Vinginevyo, fanya hivi'
    while: 'Wakati {condition}, rudia hivi'
    for: 'Kwa kila {variable} kutoka {start} hadi {last}, rudia hivi'
    call: '{callee} ya ({arguments})'
    call-without-arguments: '{callee} bila hoja'
    join: '{left} ikifuatiwa na {right}'
    or: '{left} au {right}'
    and: '{left} na {right}'
    not: 'si {operand}'
    negate: 'hasi ya {operand}'
    equal: '{left} ni sawa na {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} si sawa na {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} ni chini ya {right}' '{left} < {right}'
    less-or-equal: '{left} si zaidi ya {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} ni zaidi ya {right}' '{left} > {right}'
    greater-or-equal: '{left} si chini ya {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} jumlisha {right}' '{left} + {right}'
    subtract: '{left} toa {right}' '{left} - {right}'
    multiply: '{left} mara {right}' '{left} * {right}'
    divide: '{left} gawanya kwa {right}' '{left} / {right}'
    remainder: '{left} modulo {right}' '{left} % {right}'
    array: 'orodha ({elements})'
    new-array: 'orodha ya urefu {length} iliyojaa {fill}'
    length: 'urefu wa {array}'
