natural:
  id: minimal-vietnamese
  label: 'Minimal Vietnamese (NSM semantic primes)'
  extends: vietnamese
  profile: minimal-english
  source: 'https://en.wikipedia.org/wiki/Natural_semantic_metalanguage'
  grammar:
    productions:
      element: 'phần {index} của {array}'
      set-element: 'Sau đó, @element[array=name] là {value}'
  templates:
    function: 'Đây là cách ai đó làm {name} với {parameters}'
    function-without-parameters: 'Đây là cách ai đó làm {name}'
    declare: 'Có {name}, nó là {value}'
    assign: 'Sau đó, {name} là {value}'
    print-line: 'Nói {value} trên một dòng'
    print: 'Nói {value}'
    return-value: 'Câu trả lời là {value}'
    return: 'Dừng ở đây'
    nothing: 'Không làm gì'
    evaluate: 'Làm {expression}'
    if: 'Nếu {condition}, làm điều này'
    else-if: 'Nếu không, nếu {condition}, làm điều này'
    else: 'Nếu không, làm điều này'
    while: 'Khi {condition}, làm điều này nhiều lần'
    for: 'Với mọi {variable} từ {start} đến {last}, làm điều này'
    call-without-arguments: '{callee} ( )'
    join: '{left} rồi {right}'
    equal: '{left} giống {right}'
    not-equal: '{left} khác {right}'
    less: '{left} ít hơn {right}'
    less-or-equal: '{left} không nhiều hơn {right}'
    greater: '{left} nhiều hơn {right}'
    greater-or-equal: '{left} không ít hơn {right}'
    array: 'những thứ này ({elements})'
    new-array: '{length} thứ như {fill}'
    length: '{array} có bao nhiêu phần'
  rules:
    primes: vietnamese
    extra-words: với nó trên dòng câu trả dừng lần từ đến rồi của hoặc và âm cộng trừ nhân chia lấy dư sai những bao nhiêu
