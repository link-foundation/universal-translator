natural:
  id: 'korean'
  label: 'Korean'
  native-label: '한국어'
  family: 'Koreanic'
  speakers: '80 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: '및'
  true: '참'
  false: '거짓'
  note: '참고: {text}'
  templates:
    function: '{name} 을 {parameters} 로 정의한다'
    function-without-parameters: '{name} 을 정의한다'
    declare: '{name} 을 값 {value} 로 만든다'
    assign: '{name} 을 {value} 로 바꾼다'
    print-line: '{value} 을 쓰고 줄을 바꾼다'
    print: '{value} 을 쓴다'
    return-value: '{value} 을 돌려준다'
    return: '여기서 멈춘다'
    nothing: '아무것도 하지 않는다'
    evaluate: '{expression} 을 실행한다'
    if: '만약 {condition} 이면 다음을 한다'
    else-if: '아니고 만약 {condition} 이면 다음을 한다'
    else: '아니면 다음을 한다'
    while: '{condition} 인 동안 다음을 반복한다'
    for: '각 {variable} 에 대해 {start} 부터 {last} 까지 다음을 반복한다'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} 뒤에 {right}'
    or: '{left} 또는 {right}'
    and: '{left} 그리고 {right}'
    not: '{operand} 아님'
    negate: '음수 {operand}'
    equal: '{left} 이 {right} 과 같음'
    not-equal: '{left} 이 {right} 과 다름'
    less: '{left} 이 {right} 보다 작음'
    less-or-equal: '{left} 이 {right} 이하'
    greater: '{left} 이 {right} 보다 큼'
    greater-or-equal: '{left} 이 {right} 이상'
    add: '{left} 더하기 {right}'
    subtract: '{left} 빼기 {right}'
    multiply: '{left} 곱하기 {right}'
    divide: '{left} 나누기 {right}'
    remainder: '{left} 모듈로 {right}'
  words:
