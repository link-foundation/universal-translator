natural:
  id: 'korean'
  label: 'Korean'
  native-label: '한국어'
  family: 'Koreanic'
  speakers: '80 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '“' '”'
  list-separator: ','
  list-and: '및'
  true: '참'
  false: '거짓'
  note: '참고: {text}'
  grammar:
    terms:
      interrogative: '은 무엇인가'
    productions:
      answer-type: '{subject} 의 유형'
      question-type: '@answer-type @interrogative'
      answer-documentation: '{subject} 의 문서'
      question-documentation: '@answer-documentation @interrogative'
      answer-source: '{subject} 의 소스 코드'
      question-source: '@answer-source @interrogative'
      answer-details: '{subject} 의 상세 정보'
      question-details: '@answer-details @interrogative'
  templates:
    answer-query: '{source} 의 각 {variable} 에 대해 {condition} 를 만족하는 {projection} 의 값'
    question-query: '{source} 의 각 {variable} 에 대해 {condition} 를 만족하는 {projection} 의 값은 무엇인가'
    answer-deferred-query: '“지연” {source} 의 각 {variable} 에 대해 {condition} 를 만족하는 {projection} 의 값'
    question-deferred-query: '“지연” {source} 의 각 {variable} 에 대해 {condition} 를 만족하는 {projection} 의 값은 무엇인가'
    documentation: '문서는 {value}'
    function: '{name} 을 {parameters} 로 정의한다'
    function-without-parameters: '{name} 을 정의한다'
    declare: '{name} 을 값 {value} 로 만든다'
    assign: '{name} 을 {value} 로 바꾼다'
    increase: '{name} 을 {value} 만큼 늘린다'
    decrease: '{name} 을 {value} 만큼 줄인다'
    print-line: '{value} 을 쓰고 줄을 바꾼다'
    print: '{value} 을 쓴다'
    return-value: '{value} 을 돌려준다'
    return: '여기서 멈춘다'
    nothing: '아무것도 하지 않는다'
    evaluate: '{expression} 을 실행한다'
    if: '만약 {condition} 이면 다음을 한다'
    else-if: '아니고 만약 {condition} 이면 다음을 한다'
    else: '아니면 다음을 한다'
    while: '{condition} 인 동안 다음을 반복한다'
    for: '각 {variable} 에 대해 {start} 부터 {last} 까지 다음을 반복한다'
    call: '{callee} ({arguments})'
    call-without-arguments: '{callee} ( )'
    join: '{left} 뒤에 {right}'
    or: '{left} 또는 {right}'
    and: '{left} 그리고 {right}'
    not: '{operand} 아님'
    negate: '음수 {operand}'
    equal: '{left} 이 {right} 과 같음' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} 이 {right} 과 다름' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} 이 {right} 보다 작음' '{left} < {right}'
    less-or-equal: '{left} 이 {right} 이하' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} 이 {right} 보다 큼' '{left} > {right}'
    greater-or-equal: '{left} 이 {right} 이상' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} 더하기 {right}' '{left} + {right}'
    subtract: '{left} 빼기 {right}' '{left} - {right}'
    multiply: '{left} 곱하기 {right}' '{left} * {right}'
    divide: '{left} 나누기 {right}' '{left} / {right}'
    remainder: '{left} 모듈로 {right}' '{left} % {right}'
    array: '목록 ({elements})'
    new-array: '길이 {length} 초기값 {fill} 목록'
    element: '{array} 원소 {index}'
    length: '{array} 길이'
    set-element: '{name} 원소 {index} 을 {value} 로 바꾼다'
  words:
    ackermann: '아커만'
    bottles: '병'
    common: '공통'
    count: '개수'
    current: '현재'
    digits: '자릿수'
    disks: '원판'
    divisor: '약수'
    factorial: '계승'
    female: '여성'
    fibonacci: '피보나치'
    first: '첫째'
    greatest: '최대'
    hailstone: '우박'
    index: '색인'
    is: '여부'
    leap: '윤'
    limit: '한계'
    male: '남성'
    move: '옮기기'
    multiple: '배수'
    next: '다음'
    number: '수'
    numbers: '수들'
    of: '의'
    pass: '회차'
    perfect: '완전'
    position: '위치'
    previous: '이전'
    prime: '소수'
    product: '곱'
    remainder: '나머지'
    second: '둘째'
    source: '출발'
    spare: '보조'
    squares: '제곱'
    step: '단계'
    steps: '단계들'
    sum: '합'
    swap: '교환'
    target: '목표'
    total: '총계'
