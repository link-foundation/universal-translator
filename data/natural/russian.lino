natural:
  id: 'russian'
  label: 'Russian'
  native-label: 'Русский'
  family: 'Indo-European'
  speakers: '255 million'
  sentence-end: '.'
  block-end: ':'
  quotes: '«' '»'
  list-separator: ','
  list-and: 'и'
  true: 'истина'
  false: 'ложь'
  note: 'Примечание: {text}'
  grammar:
    terms:
      entity: 'сущности {subject}'
      entity-type: 'тип'
      source-code: 'исходный код'
      which-owned: 'Какой'
      what-property: 'Какова'
      query-scope: 'для каждого {variable} в {source}'
      query-deferred: '«отложенно»'
    productions:
      answer-type: '@entity-type @entity'
      question-type: '@which-owned @entity-type у @entity'
      answer-documentation: 'документация @entity'
      question-documentation: '@what-property @answer-documentation'
      answer-source: '@source-code @entity'
      question-source: '@which-owned @source-code у @entity'
      answer-details: 'подробная информация о @entity'
      question-details: '@what-property @answer-details'
      answer-query: 'значения {projection} @query-scope при {condition}'
      question-query: 'Какие значения {projection} @query-scope удовлетворяют {condition}'
      answer-deferred-query: '@query-deferred @answer-query'
      question-deferred-query: '@query-deferred @question-query'
  templates:
    documentation: 'Документация есть {value}'
    function: 'Определить {name} через {parameters}'
    function-without-parameters: 'Определить {name}'
    declare: 'Создать {name} со значением {value}' 'Пусть {name} равно {value}' 'Пусть {name} будет {value}'
    assign: 'Изменить {name} на {value}' 'Установить {name} в {value}' 'Присвоить {name} значение {value}'
    increase: 'Увеличить {name} на {value}'
    decrease: 'Уменьшить {name} на {value}'
    print-line: 'Написать {value} и закончить строку' 'Напечатать {value}' 'Вывести {value}' 'Показать {value}'
    print: 'Написать {value}'
    return-value: 'Вернуть {value}'
    return: 'Остановиться здесь'
    nothing: 'Ничего не делать'
    evaluate: 'Выполнить {expression}'
    if: 'Если {condition}, сделать это' 'Если {condition}, то сделать это' 'Если {condition}, то' 'Если {condition}'
    else-if: 'Иначе, если {condition}, сделать это' 'Иначе, если {condition}' 'Иначе если {condition}'
    else: 'Иначе сделать это' 'Иначе'
    while: 'Пока {condition}, повторять это' 'Пока {condition}, сделать это' 'Пока {condition}, делать это' 'Пока {condition}'
    for: 'Для каждого {variable} от {start} до {last} повторять это' 'Для каждого {variable} от {start} до {last}, сделать это' 'Для каждого {variable} от {start} до {last}'
    call: '{callee} от ({arguments})'
    call-without-arguments: '{callee} без аргументов'
    join: '{left} затем {right}'
    or: '{left} или {right}'
    and: '{left} и {right}'
    not: 'не {operand}'
    negate: 'противоположное {operand}'
    equal: '{left} равно {right}' '{left} равен {right}' '{left} равна {right}' '{left} = {right}' '{left} == {right}'
    not-equal: '{left} не равно {right}' '{left} не равен {right}' '{left} не равна {right}' '{left} != {right}' '{left} ≠ {right}' '{left} <> {right}'
    less: '{left} меньше {right}' '{left} меньше чем {right}' '{left} < {right}'
    less-or-equal: '{left} не больше {right}' '{left} меньше или равно {right}' '{left} меньше либо равно {right}' '{left} меньше или равен {right}' '{left} меньше или равна {right}' '{left} <= {right}' '{left} ≤ {right}'
    greater: '{left} больше {right}' '{left} больше чем {right}' '{left} > {right}'
    greater-or-equal: '{left} не меньше {right}' '{left} больше или равно {right}' '{left} больше либо равно {right}' '{left} больше или равен {right}' '{left} больше или равна {right}' '{left} >= {right}' '{left} ≥ {right}'
    add: '{left} плюс {right}' '{left} + {right}'
    subtract: '{left} минус {right}' '{left} - {right}'
    multiply: '{left} умножить на {right}' '{left} * {right}'
    divide: '{left} разделить на {right}' '{left} / {right}'
    remainder: '{left} по модулю {right}' '{left} % {right}'
    array: 'список ({elements})'
    new-array: 'список длины {length} со значениями {fill}'
    element: 'элемент {index} списка {array}'
    length: 'длина {array}'
    set-element: 'Изменить элемент {index} списка {name} на {value}'
