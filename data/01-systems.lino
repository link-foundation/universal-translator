        (line: 'fn main() {')
        (line: '    (1..={{limit}})')
        (line: '        .map(|n| match (n % 3, n % 5) {')
        (line: '            (0, 0) => "FizzBuzz".into(),')
        (line: '            (0, _) => "Fizz".into(),')
        (line: '            (_, 0) => "Buzz".into(),')
