    form:
      task: fizz-buzz
      name: standard
      source: '''#include <stdio.h>

int main(void)
{
    const int limit = {{limit}};
    for (int number = 1; number <= limit; number++) {
        if (number % 15 == 0) {
            puts("FizzBuzz");
        } else if (number % 3 == 0) {
            puts("Fizz");
        } else if (number % 5 == 0) {
            puts("Buzz");
        } else {
            printf("%d\n", number);
        }
    }
    return 0;
}'''

