        max: 2147483647
      output: gcd
      source: '''fn gcd(mut left: i32, mut right: i32) -> i32 {
    while right != 0 {
        (left, right) = (right, left % right);
    }
    left.abs()
}'''
    form:
      task: gcd-function
      name: rosetta-iterative
      fixed:
        max: 2147483647
      output: gcd
      source: '''fn gcd(mut m: i32, mut n: i32) -> i32 {
   while m != 0 {
       let old_m = m;
       m = n % m;
       n = old_m;
   }
   n.abs()
}'''
    form:
      task: gcd-function
      name: rosetta-recursive
      fixed:
        max: 2147483647
      output: gcd
      source: '''fn gcd(m: i32, n: i32) -> i32 {
   if m == 0 {
      n.abs()
   } else {
      gcd(n % m, m)
   }
}'''
