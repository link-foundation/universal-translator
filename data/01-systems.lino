    form:
      task: fizz-buzz
      name: standard
      source: '''#include <iostream>

int main()
{
    const int limit = {{limit}};
    for (int number = 1; number <= limit; ++number) {
        if (number % 15 == 0) {
            std::cout << "FizzBuzz\n";
        } else if (number % 3 == 0) {
            std::cout << "Fizz\n";
        } else if (number % 5 == 0) {
            std::cout << "Buzz\n";
        } else {
            std::cout << number << '\n';
        }
    }
}'''

