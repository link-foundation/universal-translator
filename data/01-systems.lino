profile:
  id: c
  unicodeGreeting: true
  label: C
  comment: //
  call: 'function call'
  output: printf
  forms:
    form:
      task: hello
      name: standard
      requires: stdio.h
      source:
        (line: '#include <stdio.h>')
        (line: ~1{})
        (line: 'int main(void)')
        (line: {)
        (line: '    printf("{{message}}\n");')
        (line: '    return 0;')
        (line: })
    form:
      task: hello
      name: classic
      requires: stdio.h
      source:
        (line: '#include <stdio.h>')
        (line: ~1{})
        (line: 'main()')
        (line: {)
        (line: '    printf("{{message}}\n");')
        (line: })
    form:
      task: hello
      name: common
      requires: stdio.h print_line
      output: print_line
      source:
        (line: '#include <stdio.h>')
        (line: ~1{})
        (line: 'static void print_line(const char *message)')
        (line: {)
        (line: '    puts(message);')
        (line: })
        (line: ~1{})
        (line: 'int main(void)')
        (line: {)
        (line: '    print_line("{{message}}");')
        (line: '    return 0;')
        (line: })
    form:
      task: hello
      name: collection
      requires: stdio.h stdlib.h
      output: puts
      source:
        (line: '#include <stdio.h>')
        (line: '#include <stdlib.h>')
        (line: ~1{})
        (line: 'int main(void)')
        (line: {)
        (line: '  puts("{{message}}");')
        (line: '  return EXIT_SUCCESS;')
        (line: })
    form:
      task: greatest-common-divisor
      name: standard
      source:
        (line: '#include <stdio.h>')
        (line: ~1{})
        (line: 'int main(void)')
        (line: {)
        (line: '    int left = {{left}};')
        (line: '    int right = {{right}};')
        (line: '    while (right != 0) {')
        (line: '        int remainder = left % right;')
        (line: '        left = right;')
        (line: '        right = remainder;')
        (line: '    }')
        (line: '    printf("%d\n", left);')
        (line: '    return 0;')
        (line: })
    form:
      task: fizz-buzz
      name: standard
      source:
        (line: '#include <stdio.h>')
        (line: ~1{})
        (line: 'int main(void)')
        (line: {)
        (line: '    const int limit = {{limit}};')
        (line: '    for (int number = 1; number <= limit; number++) {')
        (line: '        if (number % 15 == 0) {')
        (line: '            puts("FizzBuzz");')
        (line: '        } else if (number % 3 == 0) {')
        (line: '            puts("Fizz");')
        (line: '        } else if (number % 5 == 0) {')
        (line: '            puts("Buzz");')
        (line: '        } else {')
        (line: '            printf("%d\n", number);')
        (line: '        }')
        (line: '    }')
        (line: '    return 0;')
        (line: })

profile:
  id: cpp
  unicodeGreeting: true
  label: C++
  comment: //
  call: 'function call'
  output: 'std::cout'
  forms:
    form:
      task: hello
      name: standard
      requires: iostream
      source:
        (line: '#include <iostream>')
        (line: ~1{})
        (line: 'int main()')
        (line: {)
        (line: `    std::cout << "{{message}}" << '\n';`)
        (line: })
    form:
      task: hello
      name: collection
      requires: iostream
      source:
        (line: '#include <iostream>')
        (line: ~1{})
        (line: 'int main()')
        (line: {)
        (line: '    std::cout << "{{message}}" << std::endl;')
        (line: })
    form:
      task: greatest-common-divisor
      name: standard
      source:
        (line: '#include <iostream>')
        (line: ~1{})
        (line: 'int main()')
        (line: {)
        (line: '    int left = {{left}};')
        (line: '    int right = {{right}};')
        (line: '    while (right != 0) {')
        (line: '        const int remainder = left % right;')
        (line: '        left = right;')
        (line: '        right = remainder;')
        (line: '    }')
        (line: "    std::cout << left << '\n';")
        (line: })
    form:
      task: fizz-buzz
      name: standard
      source:
        (line: '#include <iostream>')
        (line: ~1{})
        (line: 'int main()')
        (line: {)
        (line: '    const int limit = {{limit}};')
        (line: '    for (int number = 1; number <= limit; ++number) {')
        (line: '        if (number % 15 == 0) {')
        (line: '            std::cout << "FizzBuzz\n";')
        (line: '        } else if (number % 3 == 0) {')
        (line: '            std::cout << "Fizz\n";')
        (line: '        } else if (number % 5 == 0) {')
        (line: '            std::cout << "Buzz\n";')
        (line: '        } else {')
        (line: "            std::cout << number << '\n';")
        (line: '        }')
        (line: '    }')
        (line: })

