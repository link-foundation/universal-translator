        (line: '    if m == 0 {')
        (line: '        n + 1')
        (line: '    } else if n == 0 {')
        (line: '        ack(m - 1, 1)')
        (line: '    } else {')
        (line: '        ack(m - 1, ack(m, n - 1))')
