        match (number % 3, number % 5) {
            (0, 0) => common_library::print_line("\"FizzBuzz\""),
            (0, _) => common_library::print_line("\"Fizz\""),
            (_, 0) => common_library::print_line("\"Buzz\""),
            _ => common_library::print_line(&format!("\"{number}\"")),
