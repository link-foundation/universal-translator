        (line: '    fn alert_utf8(pointer: *const u8, length: usize);')
        (line: })
        (line: ~1{})
        (line: '#[no_mangle]')
        (line: 'pub extern "C" fn show_alert() {')
        (line: '    let message = "{{message}}";')
        (line: '    unsafe { alert_utf8(message.as_ptr(), message.len()) };')
        (line: })
