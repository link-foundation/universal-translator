        (line: ~1{})
        (line: 'fn main() {')
        (line: '    for line in common_library::fizz_buzz_lines({{limit}}) {')
        (line: '        common_library::print_line(&line.to_ascii_lowercase());')
        (line: '    }')
        (line: '    common_library::print_line("");')
        (line: })

profile:
  id: go
