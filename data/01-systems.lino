profile:
  id: fortran
  label: Fortran
  comment: !
  call: 'function call'
  output: write
  forms:
    form:
      task: hello
      name: standard
      source: '''program hello
    implicit none
    write (*, '(A)') "{{message}}"
end program hello'''
    form:
      task: greatest-common-divisor
      name: standard
      source: '''program greatest_common_divisor
    implicit none
    integer :: left, right, remainder
    left = {{left}}
    right = {{right}}
    do while (right /= 0)
        remainder = mod(left, right)
        left = right
        right = remainder
    end do
    write (*, '(I0)') left
end program greatest_common_divisor'''
    form:
      task: fizz-buzz
      name: standard
      source: '''program fizz_buzz
    implicit none
    integer :: number, limit
    limit = {{limit}}
    do number = 1, limit
        if (mod(number, 15) == 0) then
            write (*, '(A)') "FizzBuzz"
        else if (mod(number, 3) == 0) then
            write (*, '(A)') "Fizz"
        else if (mod(number, 5) == 0) then
            write (*, '(A)') "Buzz"
        else
            write (*, '(I0)') number
        end if
    end do
end program fizz_buzz'''

profile:
  id: pascal
  label: Pascal
  comment: //
  call: 'function call'
  output: WriteLn
  forms:
    form:
      task: hello
      name: standard
      source: '''program Hello;
begin
    WriteLn('{{message}}');
end.'''
    form:
      task: greatest-common-divisor
      name: standard
      source: '''program GreatestCommonDivisor;
var
    left, right, remainder: LongInt;
begin
    left := {{left}};
    right := {{right}};
    while right <> 0 do
    begin
        remainder := left mod right;
        left := right;
        right := remainder;
    end;
    WriteLn(left);
end.'''
    form:
      task: fizz-buzz
      name: standard
      source: '''program FizzBuzz;
var
    number, limit: LongInt;
begin
    limit := {{limit}};
    for number := 1 to limit do
        if number mod 15 = 0 then
            WriteLn('FizzBuzz')
        else if number mod 3 = 0 then
            WriteLn('Fizz')
        else if number mod 5 = 0 then
            WriteLn('Buzz')
        else
            WriteLn(number);
end.'''

