  output: fmt.Println
  forms:
    form:
      task: hello
      name: standard
      requires: fmt
      source:
        (line: 'package main')
        (line: ~1{})
        (line: 'import "fmt"')
        (line: ~1{})
        (line: 'func main() {')
        (line: '    fmt.Println("{{message}}")')
        (line: })
    form:
      task: hello
      name: collection
      requires: fmt
      output: fmt.Printf
      source:
        (line: 'package main')
        (line: 'import "fmt"')
        (line: 'func main() {')
        (line: ' fmt.Printf("{{message}}\n")')
        (line: })
    form:
      task: greatest-common-divisor
      name: standard
      source:
        (line: 'package main')
        (line: ~1{})
        (line: 'import "fmt"')
        (line: ~1{})
        (line: 'func main() {')
        (line: '    left, right := {{left}}, {{right}}')
        (line: '    for right != 0 {')
        (line: '        left, right = right, left % right')
        (line: '    }')
        (line: '    fmt.Println(left)')
        (line: })
    form:
      task: fizz-buzz
      name: standard
      source:
        (line: 'package main')
        (line: ~1{})
        (line: 'import "fmt"')
        (line: ~1{})
        (line: 'func main() {')
        (line: '    limit := {{limit}}')
        (line: '    for number := 1; number <= limit; number++ {')
        (line: '        switch {')
        (line: '        case number%15 == 0:')
        (line: '            fmt.Println("FizzBuzz")')
        (line: '        case number%3 == 0:')
        (line: '            fmt.Println("Fizz")')
        (line: '        case number%5 == 0:')
        (line: '            fmt.Println("Buzz")')
        (line: '        default:')
        (line: '            fmt.Println(number)')
        (line: '        }')
        (line: '    }')
        (line: })

