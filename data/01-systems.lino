profile:
  id: fortran
  label: Fortran
  comment: !
  call: 'function call'
  output: write
  forms:
    form:
      task: hello
      name: standard
      source:
        (line: 'program hello')
        (line: '    implicit none')
        (line: `    write (*, '(A)') "{{message}}"`)
        (line: 'end program hello')
    form:
      task: greatest-common-divisor
      name: standard
      source:
        (line: 'program greatest_common_divisor')
        (line: '    implicit none')
        (line: '    integer :: left, right, remainder')
        (line: '    left = {{left}}')
        (line: '    right = {{right}}')
        (line: '    do while (right /= 0)')
        (line: '        remainder = mod(left, right)')
        (line: '        left = right')
        (line: '        right = remainder')
        (line: '    end do')
        (line: "    write (*, '(I0)') left")
        (line: 'end program greatest_common_divisor')
    form:
      task: fizz-buzz
      name: standard
      source:
        (line: 'program fizz_buzz')
        (line: '    implicit none')
        (line: '    integer :: number, limit')
        (line: '    limit = {{limit}}')
        (line: '    do number = 1, limit')
        (line: '        if (mod(number, 15) == 0) then')
        (line: `            write (*, '(A)') "FizzBuzz"`)
        (line: '        else if (mod(number, 3) == 0) then')
        (line: `            write (*, '(A)') "Fizz"`)
        (line: '        else if (mod(number, 5) == 0) then')
        (line: `            write (*, '(A)') "Buzz"`)
        (line: '        else')
        (line: "            write (*, '(I0)') number")
        (line: '        end if')
        (line: '    end do')
        (line: 'end program fizz_buzz')

profile:
  id: pascal
  label: Pascal
  comment: //
  call: 'function call'
  output: WriteLn
  forms:
    form:
      task: hello
      name: standard
      source:
        (line: 'program Hello;')
        (line: begin)
        (line: "    WriteLn('{{message}}');")
        (line: end.)
    form:
      task: greatest-common-divisor
      name: standard
      source:
        (line: 'program GreatestCommonDivisor;')
        (line: var)
        (line: '    left, right, remainder: LongInt;')
        (line: begin)
        (line: '    left := {{left}};')
        (line: '    right := {{right}};')
        (line: '    while right <> 0 do')
        (line: '    begin')
        (line: '        remainder := left mod right;')
        (line: '        left := right;')
        (line: '        right := remainder;')
        (line: '    end;')
        (line: '    WriteLn(left);')
        (line: end.)
    form:
      task: fizz-buzz
      name: standard
      source:
        (line: 'program FizzBuzz;')
        (line: var)
        (line: '    number, limit: LongInt;')
        (line: begin)
        (line: '    limit := {{limit}};')
        (line: '    for number := 1 to limit do')
        (line: '        if number mod 15 = 0 then')
        (line: "            WriteLn('FizzBuzz')")
        (line: '        else if number mod 3 = 0 then')
        (line: "            WriteLn('Fizz')")
        (line: '        else if number mod 5 = 0 then')
        (line: "            WriteLn('Buzz')")
        (line: '        else')
        (line: '            WriteLn(number);')
        (line: end.)

