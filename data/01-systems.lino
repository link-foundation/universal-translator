      fixed:
        max: 2147483647
      output: gcd
      source:
        (line: 'fn gcd(mut m: i32, mut n: i32) -> i32 {')
        (line: '   while m != 0 {')
        (line: '       let old_m = m;')
        (line: '       m = n % m;')
        (line: '       n = old_m;')
        (line: '   }')
        (line: '   n.abs()')
        (line: })
    form:
