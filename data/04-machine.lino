profile:
  id: nasm-x86-64
  kind: instruction
  label: 'NASM x86-64 (Linux)'
  comment: ;
  call: 'function call'
  output: 'write syscall'
  forms:
    form:
      task: hello
      name: standard
      fixed:
        message: 'Hello, World!'
      requires: 'Linux x86-64 syscall ABI'
      source:
        (line: 'global _start')
        (line: ~1{})
        (line: 'section .rodata')
        (line: '    message db "Hello, World!", 10')
        (line: '    message_length equ $ - message')
        (line: ~1{})
        (line: 'section .text')
        (line: '_start:')
        (line: '    mov eax, 1')
        (line: '    mov edi, 1')
        (line: '    lea rsi, [rel message]')
        (line: '    mov edx, message_length')
        (line: '    syscall')
        (line: ~1{})
        (line: '    mov eax, 60')
        (line: '    xor edi, edi')
        (line: '    syscall')
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Linux x86-64 syscall ABI'
      source:
        (line: 'global _start')
        (line: ~1{})
        (line: 'section .bss')
        (line: '    output resb 11')
        (line: ~1{})
        (line: 'section .text')
        (line: '_start:')
        (line: '    mov eax, {{left}}')
        (line: '    mov ecx, {{right}}')
        (line: '.euclid:')
        (line: '    test ecx, ecx')
        (line: '    jz .format_decimal')
        (line: '    xor edx, edx')
        (line: '    div ecx')
        (line: '    mov eax, ecx')
        (line: '    mov ecx, edx')
        (line: '    jmp .euclid')
        (line: ~1{})
        (line: '.format_decimal:')
        (line: '    lea rsi, [rel output + 10]')
        (line: '    mov byte [rsi], 10')
        (line: '    mov ecx, 10')
        (line: '.next_digit:')
        (line: '    xor edx, edx')
        (line: '    div ecx')
        (line: "    add dl, '0'")
        (line: '    dec rsi')
        (line: '    mov [rsi], dl')
        (line: '    test eax, eax')
        (line: '    jnz .next_digit')
        (line: '    lea rdx, [rel output + 11]')
        (line: '    sub rdx, rsi')
        (line: '    mov eax, 1')
        (line: '    mov edi, 1')
        (line: '    syscall')
        (line: ~1{})
        (line: '    mov eax, 60')
        (line: '    xor edi, edi')
        (line: '    syscall')
    form:
      task: fizz-buzz
      name: standard
      requires: 'Linux x86-64 syscall ABI'
      source:
        (line: 'global _start')
        (line: ~1{})
        (line: 'section .rodata')
        (line: '    fizz db "Fizz", 10')
        (line: '    fizz_length equ $ - fizz')
        (line: '    buzz db "Buzz", 10')
        (line: '    buzz_length equ $ - buzz')
        (line: '    fizz_buzz db "FizzBuzz", 10')
        (line: '    fizz_buzz_length equ $ - fizz_buzz')
        (line: ~1{})
        (line: 'section .bss')
        (line: '    output resb 11')
        (line: ~1{})
        (line: 'section .text')
        (line: '_start:')
        (line: '    mov r12d, 1')
        (line: '.next_number:')
        (line: '    cmp r12d, {{limit}}')
        (line: '    ja .finish')
        (line: ~1{})
        (line: '    mov eax, r12d')
        (line: '    mov ecx, 15')
        (line: '    xor edx, edx')
        (line: '    div ecx')
        (line: '    test edx, edx')
        (line: '    jz .print_fizz_buzz')
        (line: ~1{})
        (line: '    mov eax, r12d')
        (line: '    mov ecx, 3')
        (line: '    xor edx, edx')
        (line: '    div ecx')
        (line: '    test edx, edx')
        (line: '    jz .print_fizz')
        (line: ~1{})
        (line: '    mov eax, r12d')
        (line: '    mov ecx, 5')
        (line: '    xor edx, edx')
        (line: '    div ecx')
        (line: '    test edx, edx')
        (line: '    jz .print_buzz')
        (line: ~1{})
        (line: '    mov eax, r12d')
        (line: '    lea rsi, [rel output + 10]')
        (line: '    mov byte [rsi], 10')
        (line: '    mov ecx, 10')
        (line: '.next_digit:')
        (line: '    xor edx, edx')
        (line: '    div ecx')
        (line: "    add dl, '0'")
        (line: '    dec rsi')
        (line: '    mov [rsi], dl')
        (line: '    test eax, eax')
        (line: '    jnz .next_digit')
        (line: '    lea rdx, [rel output + 11]')
        (line: '    sub rdx, rsi')
        (line: '    jmp .write_line')
        (line: ~1{})
        (line: '.print_fizz_buzz:')
        (line: '    lea rsi, [rel fizz_buzz]')
        (line: '    mov edx, fizz_buzz_length')
        (line: '    jmp .write_line')
        (line: '.print_fizz:')
        (line: '    lea rsi, [rel fizz]')
        (line: '    mov edx, fizz_length')
        (line: '    jmp .write_line')
        (line: '.print_buzz:')
        (line: '    lea rsi, [rel buzz]')
        (line: '    mov edx, buzz_length')
        (line: '.write_line:')
        (line: '    mov eax, 1')
        (line: '    mov edi, 1')
        (line: '    syscall')
        (line: '    inc r12d')
        (line: '    jmp .next_number')
        (line: ~1{})
        (line: '.finish:')
        (line: '    mov eax, 60')
        (line: '    xor edi, edi')
        (line: '    syscall')

profile:
  id: gas-aarch64
  kind: instruction
  label: 'GNU AArch64 assembly (Linux)'
  comment: //
  call: 'function call'
  output: 'write syscall'
  forms:
    form:
      task: hello
      name: standard
      fixed:
        message: 'Hello, World!'
      requires: 'Linux AArch64 syscall ABI'
      source:
        (line: '.global _start')
        (line: ~1{})
        (line: '.section .rodata')
        (line: 'message:')
        (line: '    .ascii "Hello, World!\n"')
        (line: '.equ message_length, . - message')
        (line: ~1{})
        (line: .text)
        (line: '_start:')
        (line: '    mov x0, #1')
        (line: '    adr x1, message')
        (line: '    mov x2, #message_length')
        (line: '    mov x8, #64')
        (line: '    svc #0')
        (line: ~1{})
        (line: '    mov x0, #0')
        (line: '    mov x8, #93')
        (line: '    svc #0')

profile:
  id: llvm-ir
  kind: instruction
  label: 'LLVM IR'
  comment: ;
  call: 'function call'
  output: puts
  forms:
    form:
      task: hello
      name: standard
      fixed:
        message: 'Hello, World!'
      requires: 'libc puts'
      source:
        (line: '@message = private constant [14 x i8] c"Hello, World!\00"')
        (line: ~1{})
        (line: 'declare i32 @puts(ptr)')
        (line: ~1{})
        (line: 'define i32 @main() {')
        (line: '  call i32 @puts(ptr @message)')
        (line: '  ret i32 0')
        (line: })

profile:
  id: cil
  kind: instruction
  label: '.NET CIL (ILAsm)'
  comment: //
  call: 'method call'
  output: 'System.Console::WriteLine'
  forms:
    form:
      task: hello
      name: standard
      fixed:
        message: 'Hello, World!'
      requires: mscorlib HelloWorld
      source:
        (line: '.assembly extern mscorlib {}')
        (line: '.assembly HelloWorld {}')
        (line: '.module HelloWorld.exe')
        (line: ~1{})
        (line: '.class private auto ansi HelloWorld extends [mscorlib]System.Object')
        (line: {)
        (line: '    .method public hidebysig static void Main() cil managed')
        (line: '    {')
        (line: '        .entrypoint')
        (line: '        .maxstack 1')
        (line: '        ldstr "Hello, World!"')
        (line: '        call void [mscorlib]System.Console::WriteLine(string)')
        (line: '        ret')
        (line: '    }')
        (line: })

profile:
  id: jvm-jasmin
  kind: instruction
  label: 'JVM bytecode (Jasmin)'
  comment: ;
  call: 'method call'
  output: java/io/PrintStream/println
  forms:
    form:
      task: hello
      name: standard
      fixed:
        message: 'Hello, World!'
      requires: Main java/lang/System/out
      source:
        (line: '.class public Main')
        (line: '.super java/lang/Object')
        (line: ~1{})
        (line: '.method public static main([Ljava/lang/String;)V')
        (line: '    .limit stack 2')
        (line: '    .limit locals 1')
        (line: '    getstatic java/lang/System/out Ljava/io/PrintStream;')
        (line: '    ldc "Hello, World!"')
        (line: '    invokevirtual java/io/PrintStream/println(Ljava/lang/String;)V')
        (line: '    return')
        (line: '.end method')
