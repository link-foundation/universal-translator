profile:
  id: erlang
  label: Erlang
  comment: %
  header: 1
  call: 'function call'
  output: 'io:format'
  forms:
    form:
      task: hello
      name: standard
      requires: escript
      source: '''#!/usr/bin/env escript

main(_) ->
    io:format("~s~n", ["{{message}}"]).'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: escript
      source: '''#!/usr/bin/env escript

greatest_common_divisor(Left, 0) -> Left;
greatest_common_divisor(Left, Right) ->
    greatest_common_divisor(Right, Left rem Right).

main(_) ->
    io:format("~B~n", [greatest_common_divisor({{left}}, {{right}})]).'''
    form:
      task: fizz-buzz
      name: standard
      requires: escript
      source: '''#!/usr/bin/env escript

fizz_buzz(Number) when Number rem 15 =:= 0 -> "FizzBuzz";
fizz_buzz(Number) when Number rem 3 =:= 0 -> "Fizz";
fizz_buzz(Number) when Number rem 5 =:= 0 -> "Buzz";
fizz_buzz(Number) -> integer_to_list(Number).

main(_) ->
    lists:foreach(
        fun(Number) -> io:format("~s~n", [fizz_buzz(Number)]) end,
        lists:seq(1, {{limit}})
    ).'''

profile:
  id: elixir
  label: Elixir
  comment: '#'
  call: 'function call'
  output: IO.puts
  forms:
    form:
      task: hello
      name: standard
      requires: 'Elixir standard library'
      source: 'IO.puts("{{message}}")'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Elixir standard library'
      source: '''defmodule Arithmetic do
  def greatest_common_divisor(left, 0), do: left

  def greatest_common_divisor(left, right) do
    greatest_common_divisor(right, rem(left, right))
  end
end

IO.puts(Arithmetic.greatest_common_divisor({{left}}, {{right}}))'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Elixir standard library'
      source: '''for number <- 1..{{limit}} do
  result =
    cond do
      rem(number, 15) == 0 -> "FizzBuzz"
      rem(number, 3) == 0 -> "Fizz"
      rem(number, 5) == 0 -> "Buzz"
      true -> number
    end

  IO.puts(result)
end'''

profile:
  id: fsharp
  label: F#
  comment: //
  call: 'function call'
  output: printfn
  forms:
    form:
      task: hello
      name: standard
      requires: 'F# Interactive'
      source: 'printfn "%s" "{{message}}"'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'F# Interactive'
      source: '''let rec greatestCommonDivisor left right =
    if right = 0 then left
    else greatestCommonDivisor right (left % right)

printfn "%d" (greatestCommonDivisor {{left}} {{right}})'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'F# Interactive'
      source: '''for number in 1 .. {{limit}} do
    if number % 15 = 0 then printfn "FizzBuzz"
    elif number % 3 = 0 then printfn "Fizz"
    elif number % 5 = 0 then printfn "Buzz"
    else printfn "%d" number'''

profile:
  id: groovy
  label: Groovy
  comment: //
  call: 'function call'
  output: println
  forms:
    form:
      task: hello
      name: standard
      requires: 'Groovy standard library'
      source: "println '{{message}}'"
    form:
      task: hello
      name: collection
      requires: 'Groovy standard library'
      source: 'println "{{message}}"'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Groovy standard library'
      source: '''int left = {{left}}
int right = {{right}}
while (right != 0) {
    int remainder = left % right
    left = right
    right = remainder
}
println left'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Groovy standard library'
      source: '''for (int number in 1..{{limit}}) {
    if (number % 15 == 0) println 'FizzBuzz'
    else if (number % 3 == 0) println 'Fizz'
    else if (number % 5 == 0) println 'Buzz'
    else println number
}'''

profile:
  id: raku
  label: Raku
  comment: '#'
  call: 'function call'
  output: say
  forms:
    form:
      task: hello
      name: standard
      requires: Rakudo
      source: "say '{{message}}';"
    form:
      task: greatest-common-divisor
      name: standard
      requires: Rakudo
      source: '''my ($left, $right) = {{left}}, {{right}};
while $right != 0 {
    ($left, $right) = $right, $left % $right;
}
say $left;'''
    form:
      task: fizz-buzz
      name: standard
      requires: Rakudo
      source: '''for 1..{{limit}} -> $number {
    if $number % 15 == 0 { say 'FizzBuzz'; }
    elsif $number % 3 == 0 { say 'Fizz'; }
    elsif $number % 5 == 0 { say 'Buzz'; }
    else { say $number; }
}'''

profile:
  id: scheme
  label: 'Scheme (GNU Guile)'
  comment: ;
  call: 'function call'
  output: display
  forms:
    form:
      task: hello
      name: standard
      requires: 'Scheme standard library'
      source: '''(display "{{message}}")
(newline)'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Scheme standard library'
      source: '''(define (greatest-common-divisor left right)
  (if (= right 0)
      left
      (greatest-common-divisor right (modulo left right))))

(display (greatest-common-divisor {{left}} {{right}}))
(newline)'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Scheme standard library'
      source: '''(define (fizz-buzz number)
  (cond
    ((= (modulo number 15) 0) "FizzBuzz")
    ((= (modulo number 3) 0) "Fizz")
    ((= (modulo number 5) 0) "Buzz")
    (else (number->string number))))

(do ((number 1 (+ number 1)))
    ((> number {{limit}}))
  (display (fizz-buzz number))
  (newline))'''

profile:
  id: nim
  label: Nim
  comment: '#'
  call: 'function call'
  output: echo
  forms:
    form:
      task: hello
      name: standard
      requires: 'Nim standard library'
      source: 'echo "{{message}}"'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Nim standard library'
      source: '''var left = {{left}}
var right = {{right}}
while right != 0:
  let remainder = left mod right
  left = right
  right = remainder
echo left'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Nim standard library'
      source: '''for number in 1 .. {{limit}}:
  if number mod 15 == 0:
    echo "FizzBuzz"
  elif number mod 3 == 0:
    echo "Fizz"
  elif number mod 5 == 0:
    echo "Buzz"
  else:
    echo number'''

profile:
  id: haxe
  label: Haxe
  comment: //
  call: 'function call'
  output: Sys.println
  forms:
    form:
      task: hello
      name: standard
      requires: 'Haxe interpreter'
      source: '''class Main {
    static function main() {
        Sys.println("{{message}}");
    }
}'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Haxe interpreter'
      source: '''class Main {
    static function main() {
        var left = {{left}};
        var right = {{right}};
        while (right != 0) {
            var remainder = left % right;
            left = right;
            right = remainder;
        }
        Sys.println(left);
    }
}'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Haxe interpreter'
      source: '''class Main {
    static function main() {
        for (number in 1...({{limit}} + 1)) {
            if (number % 15 == 0) Sys.println("FizzBuzz");
            else if (number % 3 == 0) Sys.println("Fizz");
            else if (number % 5 == 0) Sys.println("Buzz");
            else Sys.println(number);
        }
    }
}'''

profile:
  id: crystal
  label: Crystal
  comment: '#'
  call: 'function call'
  output: puts
  forms:
    form:
      task: hello
      name: standard
      requires: 'Crystal standard library'
      source: 'puts "{{message}}"'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Crystal standard library'
      source: '''left = {{left}}
right = {{right}}
while right != 0
  left, right = right, left % right
end
puts left'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Crystal standard library'
      source: '''(1..{{limit}}).each do |number|
  if number % 15 == 0
    puts "FizzBuzz"
  elsif number % 3 == 0
    puts "Fizz"
  elsif number % 5 == 0
    puts "Buzz"
  else
    puts number
  end
end'''

profile:
  id: racket
  label: Racket
  comment: ;
  header: 1
  call: 'function call'
  output: displayln
  forms:
    form:
      task: hello
      name: standard
      requires: racket/base
      source: '''#lang racket/base

(displayln "{{message}}")'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: racket/base
      source: '''#lang racket/base

(define (greatest-common-divisor left right)
  (if (zero? right)
      left
      (greatest-common-divisor right (remainder left right))))

(displayln (greatest-common-divisor {{left}} {{right}}))'''
    form:
      task: greatest-common-divisor
      name: rosetta
      requires: racket
      source: '''#lang racket

(gcd {{left}} {{right}})'''
    form:
      task: fizz-buzz
      name: standard
      requires: racket/base
      source: '''#lang racket/base

(for ([number (in-inclusive-range 1 {{limit}})])
  (displayln
   (cond
     [(zero? (remainder number 15)) "FizzBuzz"]
     [(zero? (remainder number 3)) "Fizz"]
     [(zero? (remainder number 5)) "Buzz"]
     [else number])))'''

profile:
  id: fish
  label: 'Fish shell'
  comment: '#'
  call: 'function call'
  output: printf
  forms:
    form:
      task: hello
      name: standard
      requires: 'fish shell and seq'
      source: "printf '%s\n' '{{message}}'"
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'fish shell and seq'
      source: '''set left {{left}}
set right {{right}}
while test "$right" -ne 0
    set remainder (math "$left % $right")
    set left "$right"
    set right "$remainder"
end
printf '%d\n' "$left"'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'fish shell and seq'
      source: '''for number in (seq 1 {{limit}})
    if test (math "$number % 15") -eq 0
        printf '%s\n' FizzBuzz
    else if test (math "$number % 3") -eq 0
        printf '%s\n' Fizz
    else if test (math "$number % 5") -eq 0
        printf '%s\n' Buzz
    else
        printf '%d\n' "$number"
    end
end'''
