profile:
  id: octave
  label: 'MATLAB (GNU Octave)'
  comment: %
  call: 'function call'
  output: fprintf
  forms:
    form:
      task: hello
      name: standard
      requires: 'GNU Octave'
      source: "fprintf('%s\n', '{{message}}');"
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'GNU Octave'
      source: '''left = {{left}};
right = {{right}};
while right ~= 0
    remainder = mod(left, right);
    left = right;
    right = remainder;
end
fprintf('%d\n', left);'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'GNU Octave'
      source: '''for number = 1:{{limit}}
    if mod(number, 15) == 0
        disp('FizzBuzz');
    elseif mod(number, 3) == 0
        disp('Fizz');
    elseif mod(number, 5) == 0
        disp('Buzz');
    else
        fprintf('%d\n', number);
    end
end'''

profile:
  id: julia
  label: Julia
  comment: '#'
  call: 'function call'
  output: println
  forms:
    form:
      task: hello
      name: standard
      requires: 'Julia Base'
      source: 'println("{{message}}")'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Julia Base'
      source: '''function greatest_common_divisor(left, right)
    while right != 0
        left, right = right, rem(left, right)
    end
    return left
end

println(greatest_common_divisor({{left}}, {{right}}))'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Julia Base'
      source: '''for number in 1:{{limit}}
    if number % 15 == 0
        println("FizzBuzz")
    elseif number % 3 == 0
        println("Fizz")
    elseif number % 5 == 0
        println("Buzz")
    else
        println(number)
    end
end'''

profile:
  id: cobol
  label: 'COBOL (GnuCOBOL)'
  comment: *>
  call: 'function call'
  output: display
  forms:
    form:
      task: hello
      name: standard
      requires: 'GnuCOBOL free-format source'
      source: '''identification division.
program-id. main-program.
data division.
working-storage section.
01 greeting pic X(97) value "X{{message}}".
01 greeting-length binary-long.
procedure division.
    compute greeting-length = function length("X{{message}}") - 1
    if greeting-length = 0
        display x"0A" with no advancing
    else
        display greeting(2:greeting-length)
    end-if
    stop run.'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'GnuCOBOL free-format source'
      source: '''identification division.
program-id. main-program.
data division.
working-storage section.
01 left-value pic 9(10) value {{left}}.
01 right-value pic 9(10) value {{right}}.
01 remainder-value pic 9(10).
01 formatted-value pic Z(9)9.
procedure division.
    perform until right-value = 0
        compute remainder-value = function mod(left-value, right-value)
        move right-value to left-value
        move remainder-value to right-value
    end-perform
    move left-value to formatted-value
    display function trim(formatted-value leading)
    stop run.'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'GnuCOBOL free-format source'
      source: '''identification division.
program-id. main-program.
data division.
working-storage section.
01 limit-value pic 9(4) value {{limit}}.
01 current-number pic 9(4).
01 formatted-value pic Z(3)9.
procedure division.
    perform varying current-number from 1 by 1 until current-number > limit-value
        evaluate true
            when function mod(current-number, 15) = 0
                display "FizzBuzz"
            when function mod(current-number, 3) = 0
                display "Fizz"
            when function mod(current-number, 5) = 0
                display "Buzz"
            when other
                move current-number to formatted-value
                display function trim(formatted-value leading)
        end-evaluate
    end-perform
    stop run.'''

profile:
  id: ada
  label: Ada
  comment: --
  call: 'function call'
  output: Put_Line
  forms:
    form:
      task: hello
      name: standard
      requires: Ada.Text_IO
      source: '''with Ada.Text_IO; use Ada.Text_IO;

procedure Main is
begin
   Put_Line ("{{message}}");
end Main;'''
    form:
      task: hello
      name: collection
      requires: Text_IO
      output: Text_IO.Put_Line
      source: '''with Text_IO;
procedure Hello_World is

begin
  Text_IO.Put_Line("{{message}}");
end Hello_World;'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: Ada.Text_IO
      source: '''with Ada.Text_IO; use Ada.Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;

procedure Main is
   Left : Natural := {{left}};
   Right : Natural := {{right}};
   Remainder : Natural;
begin
   while Right /= 0 loop
      Remainder := Left mod Right;
      Left := Right;
      Right := Remainder;
   end loop;
   Put (Left, Width => 0);
   New_Line;
end Main;'''
    form:
      task: fizz-buzz
      name: standard
      requires: Ada.Text_IO
      source: '''with Ada.Text_IO; use Ada.Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;

procedure Main is
begin
   for Number in 1 .. {{limit}} loop
      if Number mod 15 = 0 then
         Put_Line ("FizzBuzz");
      elsif Number mod 3 = 0 then
         Put_Line ("Fizz");
      elsif Number mod 5 = 0 then
         Put_Line ("Buzz");
      else
         Put (Number, Width => 0);
         New_Line;
      end if;
   end loop;
end Main;'''

profile:
  id: prolog
  label: 'Prolog (SWI-Prolog)'
  comment: %
  call: 'function call'
  output: writeln
  forms:
    form:
      task: hello
      name: standard
      requires: SWI-Prolog
      source: ''':- initialization(main, main).

main :- writeln("{{message}}").'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: SWI-Prolog
      source: ''':- initialization(main, main).

greatest_common_divisor(Left, 0, Left) :- !.
greatest_common_divisor(Left, Right, Result) :-
    Remainder is Left mod Right,
    greatest_common_divisor(Right, Remainder, Result).

main :-
    greatest_common_divisor({{left}}, {{right}}, Result),
    writeln(Result).'''
    form:
      task: fizz-buzz
      name: standard
      requires: SWI-Prolog
      source: ''':- initialization(main, main).

fizz_buzz(Number) :-
    ( 0 is Number mod 15 -> writeln("FizzBuzz")
    ; 0 is Number mod 3 -> writeln("Fizz")
    ; 0 is Number mod 5 -> writeln("Buzz")
    ; writeln(Number)
    ).

main :- forall(between(1, {{limit}}, Number), fizz_buzz(Number)).'''

profile:
  id: d
  label: D
  comment: //
  call: 'function call'
  output: writeln
  forms:
    form:
      task: hello
      name: standard
      requires: std.stdio
      source: '''import std.stdio;

void main()
{
    writeln("{{message}}");
}'''
    form:
      task: hello
      name: collection
      requires: std.stdio
      output: writefln
      source: '''import std.stdio;

void main()
{
   writefln("{{message}}");
}'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: std.stdio
      source: '''import std.stdio;

void main()
{
    int left = {{left}};
    int right = {{right}};
    while (right != 0)
    {
        int remainder = left % right;
        left = right;
        right = remainder;
    }
    writeln(left);
}'''
    form:
      task: fizz-buzz
      name: standard
      requires: std.stdio
      source: '''import std.stdio;

void main()
{
    foreach (number; 1 .. {{limit}} + 1)
    {
        if (number % 15 == 0) writeln("FizzBuzz");
        else if (number % 3 == 0) writeln("Fizz");
        else if (number % 5 == 0) writeln("Buzz");
        else writeln(number);
    }
}'''

profile:
  id: common-lisp
  label: 'Common Lisp'
  comment: ;
  call: 'function call'
  output: write-line
  forms:
    form:
      task: hello
      name: standard
      requires: 'Common Lisp standard library'
      source: '(write-line "{{message}}")'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Common Lisp standard library'
      source: '''(defun greatest-common-divisor (left right)
  (if (zerop right)
      left
      (greatest-common-divisor right (mod left right))))

(write-line (write-to-string (greatest-common-divisor {{left}} {{right}}) :base 10))'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Common Lisp standard library'
      source: '''(loop for number from 1 to {{limit}} do
  (write-line
    (cond
      ((zerop (mod number 15)) "FizzBuzz")
      ((zerop (mod number 3)) "Fizz")
      ((zerop (mod number 5)) "Buzz")
      (t (write-to-string number :base 10)))))'''

profile:
  id: haskell
  label: Haskell
  comment: --
  call: 'function call'
  output: putStrLn
  forms:
    form:
      task: hello
      name: standard
      requires: Prelude
      source: '''main :: IO ()
main = putStrLn "{{message}}"'''
    form:
      task: hello
      name: collection
      requires: Prelude
      source: 'main = putStrLn "{{message}}"'
    form:
      task: greatest-common-divisor
      name: standard
      requires: Prelude
      source: '''greatestCommonDivisor :: Int -> Int -> Int
greatestCommonDivisor left 0 = left
greatestCommonDivisor left right = greatestCommonDivisor right (left `mod` right)

main :: IO ()
main = print (greatestCommonDivisor {{left}} {{right}})'''
    form:
      task: fizz-buzz
      name: standard
      requires: Prelude
      source: '''fizzBuzz :: Int -> String
fizzBuzz number
  | mod number 15 == 0 = "FizzBuzz"
  | mod number 3 == 0 = "Fizz"
  | mod number 5 == 0 = "Buzz"
  | otherwise = show number

main :: IO ()
main = mapM_ (putStrLn . fizzBuzz) [1 .. {{limit}}]'''

profile:
  id: xslt
  label: 'XSLT 1.0'
  comment: <!--
  commentEnd: -->
  call: 'function call'
  output: '<xsl:text>'
  forms:
    form:
      task: hello
      name: standard
      requires: 'XSLT 1.0 processor'
      source: '''<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="text"/>
  <xsl:template match="/">
    <xsl:text><![CDATA[{{message}}]]>&#10;</xsl:text>
  </xsl:template>
</xsl:stylesheet>'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'XSLT 1.0 processor'
      source: '''<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="text"/>
  <xsl:template match="/">
    <xsl:call-template name="greatest-common-divisor">
      <xsl:with-param name="left" select="{{left}}"/>
      <xsl:with-param name="right" select="{{right}}"/>
    </xsl:call-template>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>
  <xsl:template name="greatest-common-divisor">
    <xsl:param name="left"/>
    <xsl:param name="right"/>
    <xsl:choose>
      <xsl:when test="$right = 0"><xsl:value-of select="$left"/></xsl:when>
      <xsl:otherwise>
        <xsl:call-template name="greatest-common-divisor">
          <xsl:with-param name="left" select="$right"/>
          <xsl:with-param name="right" select="$left mod $right"/>
        </xsl:call-template>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>
</xsl:stylesheet>'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'XSLT 1.0 processor'
      source: '''<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="text"/>
  <xsl:template match="/">
    <xsl:call-template name="fizz-buzz">
      <xsl:with-param name="limit" select="{{limit}}"/>
    </xsl:call-template>
  </xsl:template>
  <xsl:template name="fizz-buzz">
    <xsl:param name="limit"/>
    <xsl:param name="number" select="1"/>
    <xsl:if test="$number &lt;= $limit">
      <xsl:choose>
        <xsl:when test="$number mod 15 = 0">FizzBuzz</xsl:when>
        <xsl:when test="$number mod 3 = 0">Fizz</xsl:when>
        <xsl:when test="$number mod 5 = 0">Buzz</xsl:when>
        <xsl:otherwise><xsl:value-of select="$number"/></xsl:otherwise>
      </xsl:choose>
      <xsl:text>&#10;</xsl:text>
      <xsl:call-template name="fizz-buzz">
        <xsl:with-param name="limit" select="$limit"/>
        <xsl:with-param name="number" select="$number + 1"/>
      </xsl:call-template>
    </xsl:if>
  </xsl:template>
</xsl:stylesheet>'''

profile:
  id: clojure
  label: Clojure
  comment: ;
  call: 'function call'
  output: println
  forms:
    form:
      task: hello
      name: standard
      requires: clojure.core
      source: '(println "{{message}}")'
    form:
      task: hello
      name: collection
      requires: clojure.core
      source: '''(defn hello []
  (println "{{message}}"))

(hello)'''
    form:
      task: greatest-common-divisor
      name: standard
      requires: clojure.core
      source: '''(defn greatest-common-divisor [left right]
  (if (zero? right)
    left
    (recur right (mod left right))))

(println (greatest-common-divisor {{left}} {{right}}))'''
    form:
      task: fizz-buzz
      name: standard
      requires: clojure.core
      source: '''(doseq [number (range 1 (inc {{limit}}))]
  (println
    (cond
      (zero? (mod number 15)) "FizzBuzz"
      (zero? (mod number 3)) "Fizz"
      (zero? (mod number 5)) "Buzz"
      :else number)))'''

profile:
  id: standard-ml
  label: 'Standard ML'
  comment: '(*'
  commentEnd: '*)'
  call: 'function call'
  output: print
  forms:
    form:
      task: hello
      name: standard
      requires: 'Standard ML Basis Library'
      source: 'val () = print ("{{message}}" ^ "\n");'
    form:
      task: greatest-common-divisor
      name: standard
      requires: 'Standard ML Basis Library'
      source: '''fun greatestCommonDivisor (left, 0) = left
  | greatestCommonDivisor (left, right) =
      greatestCommonDivisor (right, left mod right);

val () = print (Int.toString (greatestCommonDivisor ({{left}}, {{right}})) ^ "\n");'''
    form:
      task: fizz-buzz
      name: standard
      requires: 'Standard ML Basis Library'
      source: '''fun fizzBuzz number =
    if number mod 15 = 0 then "FizzBuzz"
    else if number mod 3 = 0 then "Fizz"
    else if number mod 5 = 0 then "Buzz"
    else Int.toString number;

fun printThrough (number, limit) =
    if number > limit then ()
    else (print (fizzBuzz number ^ "\n"); printThrough (number + 1, limit));

val () = printThrough (1, {{limit}});'''
