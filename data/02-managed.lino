      source:
        (line: 'let left = {{left}};')
        (line: 'let right = {{right}};')
        (line: 'while (right !== 0) {')
        (line: '    const remainder = left % right;')
        (line: '    left = right;')
        (line: '    right = remainder;')
        (line: })
        (line: 'console.log(left);')
    form:
      task: greatest-common-divisor
