        (line: 'process.stdin.on("data", (part) => { input += part; });')
        (line: 'process.stdin.on("end", () => {')
        (line: '    const numbers = input.match(/^\s*(\d+)\s+(\d+)\s*/);')
        (line: '    console.log(numbers ? Number(numbers[1]) + Number(numbers[2]) : "usage: <number> <number>");')
        (line: '});')
