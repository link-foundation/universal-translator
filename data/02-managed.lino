        left: 3
        right: 4
      output: ack
      source: '''function ack(m, n) {
 return m === 0 ? n + 1 : ack(m - 1, n === 0  ? 1 : ack(m, n - 1));
}'''
    form:
      task: ackermann-function
      name: rosetta-iterative
      fixed:
        left: 3
        right: 4
      output: ack
      source: '''function ack(M,N) {
  for (; M > 0; M--) {
    N = N === 0 ? 1 : ack(M,N-1);
  }
  return N+1;
}'''
    form:
      task: ackermann-function
      name: rosetta-stack
      fixed:
        left: 3
        right: 4
      output: stackermann
      source: '''function stackermann(M, N) {
  const stack = [];
  for (;;) {
    if (M === 0) {
      N++;
      if (stack.length === 0) return N;
      const r = stack[stack.length-1];
      if (r[1] === 1) stack.length--;
      else r[1]--;
      M = r[0];
    } else if (N === 0) {
      M--;
      N = 1;
    } else {
      M--
      stack.push([M, N]);
      N = 1;
    }
  }
}'''
    form:
