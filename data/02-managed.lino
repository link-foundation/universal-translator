        (line: 'process.openStdin().on (')
        (line: "    'data',")
        (line: '    function (line) {')
        (line: '        var xs = String(line).match(/^\s*(\d+)\s+(\d+)\s*/)')
        (line: '        console.log (')
        (line: "            xs ? Number(xs[1]) + Number(xs[2]) : 'usage: <number> <number>'")
        (line: '        )')
        (line: '        process.exit()')
        (line: '    }')
        (line: ')')
