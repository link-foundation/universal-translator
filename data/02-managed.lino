      fixed:
        limit: 100
      source: '''var fizzBuzz = function () {
  var i, output;
  for (i = 1; i < 101; i += 1) {
    output = '';
    if (!(i % 3)) { output += 'Fizz'; }
    if (!(i % 5)) { output += 'Buzz'; }
    console.log(output || i);//empty string is false, so we short-circuit
  }
};'''
    form:
      task: fizz-buzz-joined
      name: standard
      output: fizzBuzz
      source: '''function fizzBuzz() {
    const labels = Array.from({ length: {{limit}} }, (_, index) => {
        const number = index + 1;
        const fizz = number % 3 === 0 ? "Fizz" : "";
        const buzz = number % 5 === 0 ? "Buzz" : "";
        return fizz + buzz || String(number);
    });
    return labels.join(String.fromCharCode({{separator}}));
}'''
    form:
      task: fizz-buzz-joined
      name: rosetta-space
      fixed:
        limit: 100
        separator: 32
      output: join
      source: '''(function rng(i) {
    return i ? rng(i - 1).concat(i) : []
})(100).map(
    function (n) {
        return n % 3 ? (
            n % 5 ? n : "Buzz"
        ) : (
            n % 5 ? "Fizz" : "FizzBuzz"
        )
    }
).join(' ')'''
    form:
      task: fizz-buzz-joined
      name: rosetta-lines
      fixed:
        limit: 100
        separator: 10
      output: unlines
      source: '''(() => {


    const fizzBuzz = n =>
        caseOf(n, [
            [x => x % 15 === 0, "FizzBuzz"],
            [x => x % 3 === 0, "Fizz"],
            [x => x % 5 === 0, "Buzz"]
        ], n.toString());


    const caseOf = (e, pvs, otherwise) =>
        pvs.reduce((a, [p, v]) =>
            a !== otherwise ? a : (p(e) ? v : a), otherwise);

    const enumFromTo = (m, n) =>
        Array.from({
            length: Math.floor(n - m) + 1
        }, (_, i) => m + i);

    const map = (f, xs) => xs.map(f);

    const unlines = xs => xs.join('\n');

    return unlines(
        map(fizzBuzz, enumFromTo(1, 100))
    );
})();'''
