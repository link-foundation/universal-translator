    form:
      task: ackermann-cli
      name: standard
      requires: process.argv console
      source: '''function ackermann(first, second) {
    if (first === 0) return second + 1;
    if (second === 0) return ackermann(first - 1, 1);
    return ackermann(first - 1, ackermann(first, second - 1));
}

const [first, second] = process.argv.slice(2).map((value) => Number.parseInt(value, 10));
if (first >= 0 && first <= {{left}} && second >= 0 && second <= {{right}}) {
    console.log(ackermann(first, second));
}'''
    form:
      task: ackermann-cli
      name: rosetta
      fixed:
        left: 3
        right: 4
      requires: process.argv console
      source: '''#!/usr/bin/env nodejs
function ack(M, N){
	const next = new Float64Array(M + 1);
	const goal = new Float64Array(M + 1).fill(1, 0, M);
	const n = N + 1;

	goal[M] = -1;

	let v;
	do {
		v = next[0] + 1;
		let m = 0;
		while (next[m] === goal[m]) {
			goal[m] = v;
			next[m++]++;
		}
		next[m]++;
	} while (next[M] !== n);
	return v;
}
var args = process.argv;
console.log(ack(parseInt(args[2]), parseInt(args[3])));'''
    form:
      task: ackermann-cli
      name: common
      requires: './common-library.mjs' process.argv
      output: printLine
      source: '''import { printLine } from './common-library.mjs';

function ackermann(first, second) {
    if (first === 0) return second + 1;
    if (second === 0) return ackermann(first - 1, 1);
    return ackermann(first - 1, ackermann(first, second - 1));
}

const [first, second] = process.argv.slice(2).map((value) => Number.parseInt(value, 10));
if (first >= 0 && first <= {{left}} && second >= 0 && second <= {{right}}) {
    printLine(String(ackermann(first, second)));
}'''
