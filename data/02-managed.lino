        right: 3
      source: '''(() => {
    'use strict';

    const ackermann = m => n => {
        const go = (m, n) =>
            0 === m ? (
                succ(n)
            ) : go(pred(m), 0 === n ? (
                1
            ) : go(m, pred(n)));
        return go(m, n);
    };

    const main = () => console.log(JSON.stringify(
        [0, 1, 2, 3].map(
            flip(ackermann)(3)
        )
    ));



    const flip = f =>
        x => y => f(y)(x);

    const pred = x => x - 1;

    const succ = x => 1 + x;


    return main();
})();'''
