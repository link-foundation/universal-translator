        (line: 'let input = "";')
        (line: 'process.stdin.on("data", (part) => { input += part; });')
        (line: 'process.stdin.on("end", () => {')
        (line: '    const [left, right] = input.trim().split(/ +/).map(Number);')
        (line: '    console.log(left + right);')
        (line: '});')
